<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <config>
        <add key="restoreIgnoreFailedSources" value="true" />
    </config>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="uox-netrisk" value="https://nuget.cloudsmith.io/uox/netrisk/v3/index.json" />
    </packageSources>
    <!-- The AvaloniaUI Azure DevOps feed is added by libs/TreeDataGrid.Avalonia/NuGet.config
         (upstream uses it for nightlies). It now rejects anonymous access with HTTP 403, which
         makes restore emit NU1900 - and that submodule builds with TreatWarningsAsErrors, so the
         warning fails the whole restore. Nothing resolves from it here anyway: packageSourceMapping
         below routes every package to nuget.org / uox-netrisk, and Avalonia 12.1.1 is on nuget.org. -->
    <disabledPackageSources>
        <add key="AvaloniaAll" value="true" />
    </disabledPackageSources>
    <packageSourceMapping>
        <packageSource key="uox-netrisk">
            <package pattern="netrisk*" />
            <package pattern="Pomelo.EntityFrameworkCore.MySql*" />
            <package pattern="OpenFaceONNX" />
            <package pattern="umapx" />
            <package pattern="FlashCap*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
