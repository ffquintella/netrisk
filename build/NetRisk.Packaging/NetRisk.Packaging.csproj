<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time only. Holds the pure, dependency-free packaging logic that the Nuke build
    (build/Build.cs) and the Packaging.Tests project both consume: installer identifiers,
    version normalisation, signing-material resolution, template rendering and secret
    redaction. Nothing here touches the filesystem or spawns a process, so all of it is
    unit-testable without a Windows/Linux packaging toolchain.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>NetRisk.Packaging</RootNamespace>
    <AssemblyName>NetRisk.Packaging</AssemblyName>
  </PropertyGroup>

</Project>
