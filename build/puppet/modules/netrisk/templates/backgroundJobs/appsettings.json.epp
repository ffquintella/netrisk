<%- | String  $server_url,
      String  $server_logging
| -%>
{

  "Logging": {
    "LogLevel": {
      "Default": "<%= $server_logging -%>",
      "Microsoft": "Warning"
    }
  },
   "Database":{
        "_comment": "The connection string is NOT rendered here (security finding NR-2026-025). It is supplied as Database__ConnectionString from the Puppet-managed environment file, mode 0600, owned by the service account."
  },
  "AllowedHosts": "*"
}
