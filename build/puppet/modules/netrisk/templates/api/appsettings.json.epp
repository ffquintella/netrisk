<%- | String  $server_url,
      String  $server_logging,
      Boolean $enable_saml,
      String  $sp_certificate_file,
      String  $sp_certificate_pwd,
      String  $idp_entity_id,
      String  $idp_sso_service,
      String  $idp_ssout_service,
      String  $idp_name,
      String  $idp_artifact_resolve_srvc,
      String  $idp_certificate_file,
      Integer $server_https_port,
      String  $server_certificate_file,
      String  $server_certificate_pwd,
      Boolean $security_allow_development_certificate,
      String  $email_from,
      String  $email_server,
      Integer $email_port,
      String  $website_protocol,
      String  $website_host,
      Integer $website_port
| -%>
{
  "Security": {
    "//AllowDevelopmentCertificate": "Track 7 finding NR-2026-003: a Release build refuses to start with the certificate committed to the NetRisk repository, or with its published placeholder password. This switch turns that guard off, and must stay false anywhere real.",
    "AllowDevelopmentCertificate": <%= $security_allow_development_certificate -%>,
    "Tls": { "MinimumVersion": "Tls12" },
    "Headers": { "HstsMaxAgeSeconds": 15552000 },
    "RateLimit": { "AuthRequestsPerMinute": 300 }
  },
  "https": {
    "port": <%= $server_https_port -%>,
    "certificate": {
      "file": "<%= $server_certificate_file -%>",
      "password": "<%= $server_certificate_pwd -%>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "<%= $server_logging -%>",
      "Microsoft": "Warning"
    }
  },
  "email": {
    "from": "<%= $email_from -%>",
    "smtp": {
      "server": "<%= $email_server -%>",
      "port": <%= $email_port -%>
    }
  },
  "website": {
    "protocol": "<%= $website_protocol -%>",
    "host": "<%= $website_host -%>",
    "port": <%= $website_port -%>
  },
  "links": {
    "passwordResetDuration": 30
  },
  "languages": {
    "availableLocales": [
      "en-US",
      "pt-BR"
    ],
    "defaultLocale": "en-US"
  },
  "JWT": {
    "Timeout": 60,
    "Issuer": "netrisk-api",
    "Audience": "netrisk-clients"
  },
  "Database":{
        "_comment": "The connection string is NOT rendered here (security finding NR-2026-025). It is supplied as Database__ConnectionString from the Puppet-managed environment file, mode 0600, owned by the service account."
  },
  "Saml2": {
    "Enabled": <%= $enable_saml -%>,
    "ServiceProviderConfiguration": {
      "EntityId": "<%= $server_url -%>",
      "Name": "Saml2.auth",
      "AssertionConsumerServiceUrl": "Authentication/SAMLSingIn",
      "SingleLogoutResponseServiceUrl": "Saml2/SingleLogoutService",
      "OmitAssertionSignatureCheck": false,
      "Certificate": {
        "FileName": "<%= $sp_certificate_file -%>",
        "Password": "<%= $sp_certificate_pwd -%>"
      }
    },
    "IdentityProviderConfiguration": [
      {
        "EntityId": "<%= $idp_entity_id -%>",
        "Name": "saml2.provider",
        "ForceAuth": "false",
        "IsPassive": "false",
        "HashingAlgorithm": "SHA256",
        "DigestAlgorithm": "SHA256",
        "SignAuthnRequest": true,
        "SingleSignOnService": "<%= $idp_sso_service -%>",
        "SingleSignOutService": "<%= $idp_ssout_service -%>",
        "ArtifactResolveService": "<%= $idp_artifact_resolve_srvc -%>",
        "Certificate": {
          "FileName": "<%= $idp_certificate_file -%>"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
