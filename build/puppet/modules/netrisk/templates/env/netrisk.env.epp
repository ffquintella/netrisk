<%- |
  String $db_server,
  Variant[String, Integer] $db_port,
  String $db_user,
  String $db_password,
  String $db_schema,
| -%>
# NetRisk service environment -- security finding NR-2026-025.
#
# The database connection string used to be rendered into appsettings.json, which milestone 7.3.3
# forbids: a world-readable configuration file on the target host is a working credential, and a
# configuration file is exactly the thing that gets copied into a support ticket. Until NR-2026-033
# was fixed there was no alternative, because the hosts never read environment variables. There is
# now, and this file is it.
#
# Managed by Puppet with mode 0600 owned by the service account. The double underscore is .NET's
# configuration separator, so Database__ConnectionString sets Database:ConnectionString and takes
# precedence over the file -- configuration order is file, then user-secrets in a Debug build, then
# environment.
#
# Do not add anything here that is not a secret: this file is sourced into the service's environment,
# and an environment is visible to anything running as the same user.
Database__ConnectionString=server=<%= $db_server %>;port=<%= $db_port %>;uid=<%= $db_user %>;pwd=<%= $db_password %>;database=<%= $db_schema %>;ConvertZeroDateTime=True
