<%- | String  $server_url,
      String  $server_logging,
      String  $db_server,
      String  $db_user,
      Integer  $db_port,
      String  $db_password,
      String  $db_schema,
      Integer $server_https_port,
      String  $server_certificate_file,
      String  $server_certificate_pwd,
      Boolean $security_allow_development_certificate,
| -%>
{
  "Security": {
    "//AllowDevelopmentCertificate": "See the API template: a Release build refuses the repository's committed certificate and its placeholder password (Track 7 finding NR-2026-003).",
    "AllowDevelopmentCertificate": <%= $security_allow_development_certificate -%>,
    "Tls": { "MinimumVersion": "Tls12" },
    "Headers": { "HstsMaxAgeSeconds": 15552000 }
  },
  "https": {
    "port": <%= $server_https_port -%>,
    "certificate": {
      "file": "<%= $server_certificate_file -%>",
      "password": "<%= $server_certificate_pwd -%>"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "<%= $server_logging -%>",
      "Microsoft": "Warning"
    }
  },
   "Database":{
        "_comment": "The connection string is NOT rendered here (security finding NR-2026-025). It is supplied as Database__ConnectionString from the Puppet-managed environment file, mode 0600, owned by the service account."
  },
  "AllowedHosts": "*"
}
