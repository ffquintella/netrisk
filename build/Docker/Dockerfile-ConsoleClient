# Using the docker-puppet base image, which provisions the container with the OpenVox agent
# (`openvox-agent`, from yum.voxpupuli.org) rather than Perforce's `puppet-agent`. OpenVox keeps the
# `puppet` command and the `/opt/puppetlabs` layout, so the entrypoints and the manifests under
# build/puppet are unchanged by the switch -- which is exactly why the agent is asserted below rather
# than assumed. A base image that moved back to puppet-agent would look identical from here.
FROM ffquintella/docker-puppet:9.8.24

# Maintained by ffquintella
LABEL maintainer="ffquintella"

LABEL version="{{VERSION}}"

# The configuration management agent inside this image must be OpenVox. `rpm -q` fails the build if
# openvox-agent is missing, and puppet-agent being installed at all means the base image changed
# distribution underneath us. Asserted per image, and covered by
# Packaging.Tests/ConfigurationManagementAgentTest.
RUN rpm -q openvox-agent \
 && if rpm -q puppet-agent > /dev/null 2>&1; then \
      echo "puppet-agent is installed; this image expects openvox-agent only" >&2; exit 1; \
    fi

# Make necessary directories
RUN mkdir -p /netrisk


RUN ln -s /opt/puppetlabs/bin/puppet /usr/bin/puppet

# COPY NETRISK Console
# Ownership set at copy time (uid/gid 7070 == puppet 'netrisk' user) to avoid a
# second large-file re-chown layer that trips the snapshotter on image export.
COPY --chown=7070:7070 console /netrisk

# COPY NETRISK API CONFIG TO DEFAULTS DIRECTORY
RUN mkdir -p /netrisk/defaults
COPY --chown=7070:7070 console/appsettings.json /netrisk/defaults


# CREATE CONFIGURATION DIRECTORY
RUN mkdir -p /configurations

# COPY PUPPET MANIFESTS
RUN  mkdir /etc/puppet/ ; mkdir /etc/puppet/manifests ; mkdir /etc/puppet/modules ; mkdir /opt/scripts
COPY puppet-console /etc/puppet/manifests
COPY puppet-modules /etc/puppet/modules

# Executing puppet install script
RUN /usr/bin/puppet apply --modulepath=/etc/puppet/modules /etc/puppet/manifests/install.pp ; \
    rm -rf /tmp/* ; rm -rf /var/cache/* ; rm -rf /var/tmp/* ; rm -rf /var/opt/staging

RUN mkdir -p /var/log/netrisk

EXPOSE 5443

# Create the start script and set permissions
COPY entrypoint-console.sh /entrypoint.sh
# Strip any CR characters (defense against a CRLF checkout on the build host)
# and make executable, so the `#!/bin/bash` shebang always execs cleanly.
RUN sed -i 's/\r$//' /entrypoint.sh && chmod 755 /entrypoint.sh

# The command operators run. This container holds itself open with `tail -f /dev/null` so that
# `docker exec netrisk-<env>_console netrisk-console <command>` works -- and a `docker exec` starts
# from this image's environment, not from the entrypoint's, so it never saw the database credential
# that entrypoint-console.sh exports from /netrisk/netrisk.env. Every `netrisk-console database ...`
# therefore fell back to localhost:3306 and failed against a database that lives in another
# container. The wrapper loads that file itself and runs the binary from /netrisk, which is where
# appsettings.json has to be resolved from.
COPY netrisk-console.sh /usr/local/bin/netrisk-console
RUN sed -i 's/\r$//' /usr/local/bin/netrisk-console && chmod 755 /usr/local/bin/netrisk-console

# Data to save
VOLUME /netrisk/EmailTemplates
VOLUME /netrisk/Scripts

# VAIRABLES
ENV FACTER_SERVER_HTTPS_PORT=5443

# Setting up entrypoint
ENTRYPOINT [ "/entrypoint.sh" ]