<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <NukeRootDirectory>..</NukeRootDirectory>
    <NukeScriptDirectory>..</NukeScriptDirectory>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
    <IsPackable>false</IsPackable>
    <LangVersion>13</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure, unit-tested packaging logic shared with src/Packaging.Tests. It lives in a
         subdirectory of build/, and this project's default compile glob is recursive, so its
         sources have to be removed explicitly or they would be compiled twice. -->
    <Compile Remove="NetRisk.Packaging\**" />
    <ProjectReference Include="NetRisk.Packaging\NetRisk.Packaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Glob" Version="1.1.9" />
    <PackageReference Include="InnoSetup.ScriptBuilder" Version="6.3.0" />
    <!-- Explicit package references to fix security vulnerabilities (CVE-2025-55247) -->
    <!-- Microsoft.Build 18.11.0, aligned with Tasks.Core / Utilities.Core below. From 18.10.1 on the
         package ships only lib/ref net11.0 and net472 (18.9.6 still had net10.0), so a net10.0
         consumer restores the .NETFramework asset of Microsoft.Build and of its net472-only
         dependency Microsoft.IO.Redist (lib/net472 only), which NuGet reports as NU1701
         (eight warnings across the restore passes of this project). Tasks.Core / Utilities.Core ship
         netstandard2.0, which is why they raise none.
         Resolved per package, not with a project-wide NoWarn: NU1701 is suppressed on exactly these
         two PackageReferences, because the net472 asset is never loaded and never bound to.
         Evidence, from obj/project.assets.json of this project:
           Microsoft.Build/18.11.0   runtime = lib/net472/_._   (placeholder: nothing is copied or loaded;
                                     ExcludeAssets="runtime" keeps it that way; the MSBuild that Nuke
                                     actually loads is the SDK's, found by Microsoft.Build.Locator)
                                     compile = ref/net472/Microsoft.Build.dll (reference assembly, never
                                     loaded; Build.cs only has `using Microsoft.Build.Construction;` and
                                     uses no type from it)
           Microsoft.IO.Redist/6.1.0 compile = runtime = lib/net472/_._   (nothing at all; the explicit
                                     reference below exists only to carry the scoped NoWarn, because a
                                     transitive package cannot take one, and ExcludeAssets="all" keeps
                                     it inert)
         Revisit when Microsoft.Build ships a net10.0 asset again, or when Build.cs drops the unused
         using: then both lines below can go. -->
    <PackageReference Include="Microsoft.Build" Version="18.11.0" ExcludeAssets="runtime" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.IO.Redist" Version="6.1.0" ExcludeAssets="all" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
    <PackageReference Include="Tools.InnoSetup" Version="7.1.0" />
    <!-- Explicit overrides for vulnerable transitive packages.
         System.Security.Cryptography.Xml 9.0.0 (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf,
         GHSA-8q5v-6pqq-x66h / CVE-2026-50525 — fixed in 10.0.10; GHSA-r955-8q5j-3h83,
         GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj — fixed in 10.0.13), its dependency
         System.Security.Cryptography.Pkcs (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 — fixed in 10.0.13)
         and NuGet.Packaging 6.12.1 (GHSA-g4vj-cjjj-v7hg) are pulled in transitively;
         pin them to fixed versions. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
  </ItemGroup>

</Project>
