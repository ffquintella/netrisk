<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <NukeRootDirectory>..</NukeRootDirectory>
    <NukeScriptDirectory>..</NukeScriptDirectory>
    <NukeTelemetryVersion>1</NukeTelemetryVersion>
    <IsPackable>false</IsPackable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure, unit-tested packaging logic shared with src/Packaging.Tests. It lives in a
         subdirectory of build/, and this project's default compile glob is recursive, so its
         sources have to be removed explicitly or they would be compiled twice. -->
    <Compile Remove="NetRisk.Packaging\**" />
    <ProjectReference Include="NetRisk.Packaging\NetRisk.Packaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Glob" Version="1.1.9" />
    <PackageReference Include="InnoSetup.ScriptBuilder" Version="6.3.0" />
    <!-- Explicit package references to fix security vulnerabilities (CVE-2025-55247) -->
    <!-- MSBuild packages pinned to 18.9.6, the newest release that ships net10.0 assets. From 18.10
         on, the line targets .NET 11 (net11.0 + net472 only): on this net10.0 project it restores the
         .NETFramework asset (NU1701) and its buildTransitive targets warn "doesn't support net10.0".
         Move these only to a release that still ships net10.0, or together with a net11.0 retarget.
         Runtime assets are excluded: the MSBuild Nuke loads is the SDK's, via Microsoft.Build.Locator. -->
    <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.9.6" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" ExcludeAssets="runtime" />
    <PackageReference Include="Nuke.Common" Version="10.1.0" />
    <PackageReference Include="Tools.InnoSetup" Version="7.1.0" />
    <!-- Explicit overrides for vulnerable transitive packages.
         System.Security.Cryptography.Xml 9.0.0 (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf,
         GHSA-8q5v-6pqq-x66h / CVE-2026-50525 — fixed in 10.0.10; GHSA-r955-8q5j-3h83,
         GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj — fixed in 10.0.13), its dependency
         System.Security.Cryptography.Pkcs (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7 — fixed in 10.0.13)
         and NuGet.Packaging 6.12.1 (GHSA-g4vj-cjjj-v7hg) are pulled in transitively;
         pin them to fixed versions. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
  </ItemGroup>

</Project>
