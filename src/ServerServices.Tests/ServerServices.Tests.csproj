<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are self-executing and must be built as executables. -->
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageReference Include="Mapster" Version="10.0.12" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Sieve" Version="2.5.5" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\API\API.csproj" />
    <ProjectReference Include="..\ServerServices\ServerServices.csproj" />
    <!--
      The BastionVault plugin, referenced for build order only.

      ReferenceOutputAssembly="false" is essential and not an optimization: the plugin must be loaded
      by PluginsService into its own assembly load context, exactly as it is in production. Linking it
      as an ordinary reference would put its types in the default context, and the test would prove
      that a reference works rather than that plugin loading does — which is precisely the bug this
      arrangement exists to catch (a plugin whose interface is loaded twice fails IsAssignableFrom
      with no error anywhere).
    -->
    <ProjectReference Include="..\Plugins\BastionVaultPlugin\BastionVaultPlugin.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>
  <!--
    Stages the built plugin beside the test binaries, where SecretVaultPluginLoadingTest copies it
    into Plugins/Secrets and asks PluginsService to load it.
  -->
  <Target Name="StageBastionVaultPluginFixture" AfterTargets="Build">
    <ItemGroup>
      <BastionVaultPluginFixture
        Include="$(MSBuildThisFileDirectory)..\Plugins\BastionVaultPlugin\bin\$(Configuration)\$(TargetFramework)\BastionVaultPlugin.dll;$(MSBuildThisFileDirectory)..\Plugins\BastionVaultPlugin\bin\$(Configuration)\$(TargetFramework)\BastionVaultPlugin.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BastionVaultPluginFixture)"
          DestinationFolder="$(OutDir)PluginFixtures"
          SkipUnchangedFiles="true"
          Condition="Exists('%(BastionVaultPluginFixture.FullPath)')" />
  </Target>
</Project>