<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are self-executing and must be built as executables. -->
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NSubstitute" />
    <!-- 4.14.0+ depends on SSH.NET 2026.0.0, which fixes GHSA-q939-rpr3-3284 /
         CVE-2026-48798 (path traversal in ScpClient recursive download). -->
    <PackageReference Include="Testcontainers.MariaDb" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DAL\DAL.csproj" />
    <ProjectReference Include="..\ServerServices\ServerServices.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- EntitiesService reads EntitiesConfiguration.yaml from its own assembly's directory, so the
         real definition set has to sit next to the test binary for the service to load it. -->
    <Content Include="..\API\EntitiesConfiguration.yaml" Link="EntitiesConfiguration.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
