<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are self-executing and must be built as executables. -->
    <OutputType>Exe</OutputType>
    <LangVersion>13</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <!-- 4.14.0+ depends on SSH.NET 2026.0.0, which fixes GHSA-q939-rpr3-3284 /
         CVE-2026-48798 (path traversal in ScpClient recursive download). -->
    <PackageReference Include="Testcontainers.MariaDb" Version="4.14.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DAL\DAL.csproj" />
    <ProjectReference Include="..\ServerServices\ServerServices.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
</Project>
