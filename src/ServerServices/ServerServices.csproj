<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Track 3 services expose a few `internal` helpers that are worth testing directly —
         severity parsing, threshold selection, the token format. Widening them to public to make
         them testable would put them on the service's contract, which is the wrong trade. -->
    <InternalsVisibleTo Include="ServerServices.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\NessusParser\nessus-tools\nessus-tools.csproj" />
    <ProjectReference Include="..\..\libs\netrisk-plugin-sdk\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\DAL\DAL.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\Tools\Tools.csproj" />
    <ProjectReference Include="..\SyncContracts\SyncContracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Mapster" Version="10.0.12" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="FluentEmail.Razor" Version="3.0.2" />
    <PackageReference Include="FluentEmail.Smtp" Version="3.0.2" />
    <PackageReference Include="McMaster.NETCore.Plugins" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.11" />
    <!-- Track 4.3.1: OIDC discovery-document retrieval and JWKS-backed id_token validation. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!-- Track 4.3.1: XML-DSIG verification of SAML 2.0 assertions. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <!-- Track 4.3.3: FIDO2/WebAuthn registration and assertion ceremonies. -->
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="MySqlBackup.NET.MySqlConnector" Version="2.7.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Sieve" Version="2.5.5" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
