<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Track 3 services expose a few `internal` helpers that are worth testing directly —
         severity parsing, threshold selection, the token format. Widening them to public to make
         them testable would put them on the service's contract, which is the wrong trade. -->
    <InternalsVisibleTo Include="ServerServices.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\NessusParser\nessus-tools\nessus-tools.csproj" />
    <ProjectReference Include="..\..\libs\netrisk-plugin-sdk\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\DAL\DAL.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\Tools\Tools.csproj" />
    <ProjectReference Include="..\SyncContracts\SyncContracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <!-- Track 7 secret vaults: DNS SRV discovery of a vault cluster's nodes. System.Net.Dns exposes
         A/AAAA only and has no supported way to ask for an SRV record, so the lookup needs a real
         resolver library. Confined to DnsClientSrvLookup, behind IDnsSrvLookup. -->
    <PackageReference Include="DnsClient" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="FluentEmail.Razor" />
    <PackageReference Include="FluentEmail.Smtp" />
    <PackageReference Include="McMaster.NETCore.Plugins" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <!-- Track 4.3.1: OIDC discovery-document retrieval and JWKS-backed id_token validation. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <!-- Track 4.3.1: XML-DSIG verification of SAML 2.0 assertions. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <!-- Track 4.3.3: FIDO2/WebAuthn registration and assertion ceremonies. -->
    <PackageReference Include="Fido2" />
    <PackageReference Include="MySqlBackup.NET.MySqlConnector" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="RazorLight" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Sieve" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
