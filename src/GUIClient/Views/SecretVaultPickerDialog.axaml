<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:GUIClient.ViewModels.Dialogs"
        xmlns:secrets="clr-namespace:Model.Secrets;assembly=Model"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:DataType="dialogs:SecretVaultPickerViewModel"
        x:Class="GUIClient.Views.SecretVaultPickerDialog"
        Width="640" Height="520"
        Title="---">

    <Design.DataContext>
        <dialogs:SecretVaultPickerViewModel/>
    </Design.DataContext>

    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <Panel Grid.Row="0" Classes="title">
            <TextBlock Text="{Binding StrTitle}" Classes="header" Margin="0 0 0 5"/>
        </Panel>

        <TextBlock Grid.Row="1" Text="{Binding TargetFieldCaption}" Classes="detailBlock" Margin="0 0 0 8"/>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0 0 0 8">
            <TextBlock Text="{Binding StrVault}" Classes="header2"/>
            <ComboBox ItemsSource="{Binding Connections}"
                      SelectedItem="{Binding SelectedConnection}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="secrets:SecretVaultConnectionView">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{Binding StrFilter}" Classes="header2" Margin="0 8 0 0"/>
            <TextBox Text="{Binding Filter}" PlaceholderText="{Binding StrFilter}"/>
        </StackPanel>

        <!-- Names, paths and field names only. The API this list comes from has no endpoint that
             returns a secret value, so there is nothing here to redact. -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Secrets}"
                  SelectedItem="{Binding SelectedSecret}"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  MinHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding StrSecret}" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0 8 0 0">
            <TextBlock Text="{Binding StrField}" Classes="header2"/>
            <!-- Free text with suggestions, not a picker: a BastionVault listing reveals no field
                 names, so there is often nothing to choose from. Empty means the whole value. -->
            <AutoCompleteBox Text="{Binding FieldName}"
                             ItemsSource="{Binding Fields}"
                             FilterMode="ContainsOrdinal"
                             HorizontalAlignment="Stretch"/>
            <TextBlock Text="{Binding StrFieldHint}" Classes="detailBlock" TextWrapping="Wrap"/>

            <TextBlock Text="{Binding Status}" Classes="detailBlock" TextWrapping="Wrap" Margin="0 6 0 0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 8 0 0">
            <Button Classes="dialog1" Margin="10"
                    Command="{Binding BtSelectClicked}"
                    IsEnabled="{Binding SelectEnabled}">
                <StackPanel Orientation="Horizontal">
                    <avalonia:MaterialIcon Kind="KeyChain" Margin="10 0"/>
                    <TextBlock Text="{Binding StrSelect}" Margin="0 0 10 0"/>
                </StackPanel>
            </Button>
            <Button Classes="dialog2" Margin="10" Command="{Binding BtCancelClicked}">
                <StackPanel Orientation="Horizontal">
                    <avalonia:MaterialIcon Kind="Cancel" Margin="10 0"/>
                    <TextBlock Text="{Binding StrCancel}" Margin="0 0 10 0"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</Window>
