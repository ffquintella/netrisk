<dialogs:DialogWindowBase x:TypeArguments="results:ContinuityDialogResult"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:viewModels="clr-namespace:GUIClient.ViewModels"
        xmlns:dialogs="clr-namespace:GUIClient.ViewModels.Dialogs"
        xmlns:results="clr-namespace:GUIClient.ViewModels.Dialogs.Results"
        xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:DataType="viewModels:EditBiaDialogViewModel"
        x:Class="GUIClient.Views.EditBiaDialog"
        Title="{Binding StrTitle}"
        Width="640" SizeToContent="Height"
        MinWidth="560"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <viewModels:EditBiaDialogViewModel/>
    </Design.DataContext>

    <!-- Stage 9.3 (S43 §7): MTPD/MAO, RTO and RPO as a value and a unit each, the analysis date and
         notes. Every objective is optional, one at least is needed, and the RTO stays within the MTPD. -->
    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" Margin="10">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Classes="header" Text="{Binding StrTitle}"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="header_detail" Text="{Binding EntityName}" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="form_label" Text="{Binding StrMtpd}" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1" Margin="5" Minimum="0" Increment="1" FormatString="0"
                           Value="{Binding MtpdValue}" ToolTip.Tip="{Binding StrMtpdHint}"/>
            <ComboBox Grid.Row="2" Grid.Column="2" MinWidth="110" Margin="5" ItemsSource="{Binding Units}"
                      SelectedItem="{Binding MtpdUnit, Mode=TwoWay}" ToolTip.Tip="{Binding StrDurationUnit}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DurationUnitOption">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Classes="form_label" Text="{Binding StrRto}" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="3" Grid.Column="1" Margin="5" Minimum="0" Increment="1" FormatString="0"
                           Value="{Binding RtoValue}" ToolTip.Tip="{Binding StrRtoHint}"/>
            <ComboBox Grid.Row="3" Grid.Column="2" MinWidth="110" Margin="5" ItemsSource="{Binding Units}"
                      SelectedItem="{Binding RtoUnit, Mode=TwoWay}" ToolTip.Tip="{Binding StrDurationUnit}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DurationUnitOption">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="4" Grid.Column="0" Classes="form_label" Text="{Binding StrRpo}" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="4" Grid.Column="1" Margin="5" Minimum="0" Increment="1" FormatString="0"
                           Value="{Binding RpoValue}" ToolTip.Tip="{Binding StrRpoHint}"/>
            <ComboBox Grid.Row="4" Grid.Column="2" MinWidth="110" Margin="5" ItemsSource="{Binding Units}"
                      SelectedItem="{Binding RpoUnit, Mode=TwoWay}" ToolTip.Tip="{Binding StrDurationUnit}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DurationUnitOption">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Classes="form_label" Text="{Binding StrAssessedAt}" VerticalAlignment="Center"/>
            <DatePicker Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" SelectedDate="{Binding AssessedAt}"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Classes="form_label" Text="{Binding StrNotes}" VerticalAlignment="Top" Margin="0 10 0 0"/>
            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" MinHeight="70" MaxLength="4000"
                     AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Notes}"/>

            <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Classes="hint" TextWrapping="Wrap"
                       Text="{Binding ErrorText}" IsVisible="{Binding HasError}"/>

            <!-- Action row (§4.4). -->
            <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10 10 0 0">
                <Button Classes="dialog1" Command="{Binding BtSaveClicked}" IsEnabled="{Binding IsSaveEnabled}" Margin="0 0 10 0">
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="ContentSave" Width="20" Height="20" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding StrSave}"/>
                    </StackPanel>
                </Button>
                <Button Classes="dialog2" Command="{Binding BtCancelClicked}">
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="Cancel" Width="20" Height="20" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding StrCancel}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <progRing:ProgressRing Width="80" Height="80"
                               IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               ZIndex="1000"/>
    </Panel>
</dialogs:DialogWindowBase>
