<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GUIClient.ViewModels"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:avaloniaProgressRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
        xmlns:dvm="clr-namespace:GUIClient.ViewModels" x:DataType="dvm:EditRiskViewModel" x:Class="GUIClient.Views.EditRiskWindow"
        Title="{Binding StrRisk}"
        Name="EditRisk"
        Width="1200"
        Height="960"
        MinWidth="900"
        MinHeight="780">
        
        <Design.DataContext>
                <vm:EditRiskViewModel/>
        </Design.DataContext>

        <!-- Keyboard accessibility: Ctrl+S saves, Esc dismisses. -->

        <Panel>
                <ExperimentalAcrylicBorder IsHitTestVisible="False">
                        <ExperimentalAcrylicBorder.Material>
                                <ExperimentalAcrylicMaterial
                                        BackgroundSource="Digger"
                                        TintColor="Black"
                                        TintOpacity="1"
                                        MaterialOpacity="0.65" />
                        </ExperimentalAcrylicBorder.Material>
                </ExperimentalAcrylicBorder>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Panel Margin="10 10" MinWidth="880">
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, *, Auto" ColumnDefinitions="*,220">
                                <avaloniaProgressRing:ProgressRing Grid.Row="0" Grid.RowSpan="9" Grid.Column="0" Grid.ColumnSpan="2" Width="100"
                                                       Height="100"
                                                       IsActive="{Binding Loading}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="CornflowerBlue"
                                                       ZIndex="1000"
                                                       Margin="10,10,0,0"/>
                                <!-- HEADER -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Classes="header" Text="{Binding StrRisk, Mode=OneTime}" TextAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Classes="header_detail" Text="{Binding StrOperation, Mode=OneTime}" TextAlignment="Right" Margin="0 5 50 0"/>
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Classes="header_detail" Text="{Binding StrOperationType, Mode=OneTime}" TextAlignment="Right"/>

                                <!-- RISK DATA -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" IsVisible="{Binding IsCtrlNumVisible}">
                                        <TextBlock IsVisible="{Binding ShowEditFields}" Text="{Binding StrIdLabel}" Classes="label"/>
                                        <TextBlock IsVisible="{Binding ShowEditFields}" Text="{Binding Risk.Id}" Classes="formData" Margin="0 5 5 0 "/>
                                </StackPanel>

                                <!-- Control Number and Subject in responsive grid -->
                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      ColumnDefinitions="Auto,Auto,150,Auto,Auto,*" Margin="5">
                                        <TextBlock Grid.Column="0" Text="{Binding StrCtrlNumber}" Classes="label" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Column="2" Text="{Binding Risk.ControlNumber, Mode=TwoWay}" MinWidth="120" Margin="5"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StrSubject}" Classes="label" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Column="5" Text="{Binding RiskSubject, Mode=TwoWay}" MinWidth="300" Margin="5"/>
                                </Grid>

                                <!-- Source and Category in responsive grid -->
                                <Grid Grid.Row="3" Grid.Column="0"
                                      ColumnDefinitions="Auto,*,Auto,*" Margin="5">
                                        <TextBlock Grid.Column="0" Text="{Binding StrSource}" Classes="label" VerticalAlignment="Center" Margin="5"/>
                                        <ComboBox Grid.Column="1" x:Name="sourceComboBox"
                                                  SelectedItem="{Binding SelectedRiskSource}"
                                                  ItemsSource="{Binding RiskSources}"
                                                  MinWidth="150" Margin="5">
                                                <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="{Binding StrCategory}" Classes="label" VerticalAlignment="Center" Margin="5"/>
                                        <ComboBox Grid.Column="3" x:Name="catComboBox"
                                                  SelectedItem="{Binding SelectedCategory}"
                                                  ItemsSource="{Binding Categories}"
                                                  MinWidth="200" Margin="5">
                                                <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                        </ComboBox>
                                </Grid>
                                <StackPanel Grid.Row="4" Grid.Column="0"
                                            Orientation="Vertical" HorizontalAlignment="Stretch" Margin="5 0">
                                        <TextBlock Text="{Binding StrImpactTypes}" Classes="label"/>
                                        <!-- Risk Catalog List -->
                                        <ListBox Name="LstCatalogs"  Margin="5 5"
                                                 ItemsSource="{Binding RiskCatalogs}" SelectionMode="Multiple,Toggle"
                                                 HorizontalAlignment="Stretch" MinWidth="450" Height="200"
                                                 SelectedItems="{Binding SelectedCatalogs}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                 ScrollViewer.VerticalScrollBarVisibility="Visible">
                                                <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Number}"/><TextBlock>: </TextBlock><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                        </DataTemplate>
                                                </ListBox.ItemTemplate>
                                        </ListBox>
                                </StackPanel>

                                <!-- Owner and Manager in responsive grid -->
                                <Grid Grid.Row="5" Grid.Column="0"
                                      ColumnDefinitions="Auto,*,Auto,*" Margin="5">
                                        <TextBlock Grid.Column="0" Text="{Binding StrOwner}" Classes="label" VerticalAlignment="Center" Margin="5"/>
                                        <ComboBox Grid.Column="1" Name="OwnerComboBox"
                                                  SelectedItem="{Binding SelectedOwner}"
                                                  ItemsSource="{Binding UserListings}"
                                                  MinWidth="150" Margin="5">
                                                <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="{Binding StrManager}" Classes="label" VerticalAlignment="Center" Margin="5"/>
                                        <ComboBox Grid.Column="3" Name="ManagerComboBox"
                                                  SelectedItem="{Binding SelectedManager}"
                                                  ItemsSource="{Binding UserListings}"
                                                  MinWidth="200" Margin="5">
                                                <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                        </ComboBox>
                                </Grid>

                                <!-- Entity in responsive grid -->
                                <Grid Grid.Row="6" Grid.Column="0"
                                      ColumnDefinitions="Auto,*" Margin="5">
                                        <TextBlock Grid.Column="0" Text="{Binding StrEntity}" Classes="label" VerticalAlignment="Center" Margin="5"/>
                                        <AutoCompleteBox Grid.Column="1" x:Name="entities"
                                                         MinWidth="200"
                                                         FilterMode="StartsWith"
                                                         SelectedItem="{Binding SelectedEntityName}"
                                                         ItemsSource="{Binding EntitiesNames}"
                                                         Margin="5"/>
                                        
                                        <!--ComboBox Name="EntityComboBox"
                                                  SelectedItem="{Binding SelectedEntityNode, Mode=TwoWay}"
                                                  ItemsSource="{Binding EntityNodes}"
                                                  AutoScrollToSelectedItem="True"
                                                   IsTextSearchEnabled="True"
                                                  Width="250">
                                                <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                        <avalonia:MaterialIcon Kind="{Binding Icon}"
                                                                                 Margin="0 0 5 0 "/>
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                </StackPanel>
                                                        </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                        </ComboBox-->
                                </Grid>
                                <!-- Mid Right RISK DATA -->
                                <Panel Grid.Row="3" Grid.Column="1" Grid.RowSpan="3">
                                        <StackPanel  Orientation="Vertical" Margin="5 5  ">
                                                <TextBlock Text="{Binding StrScoring, Mode=OneTime}" Margin="5 0"/>
                                                <StackPanel  Orientation="Vertical" Margin="5 5  ">
                                                        <TextBlock Text="{Binding StrProbability}" Classes="label"/>
                                                        <ComboBox Name="ProbabilityComboBox" 
                                                                  ItemsSource="{Binding Probabilities}"
                                                                  SelectedItem="{Binding SelectedProbability}"
                                                                  MinWidth="200">
                                                                <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <TextBlock Text="{Binding Name}" />
                                                                        </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <!-- Track 8 milestone 8.7.1 — the anchor for the chosen
                                                             level, read at rating time rather than looked up in a
                                                             policy document nobody opens. -->
                                                        <TextBlock Text="{Binding StrWhatThisLevelMeans}"
                                                                   Classes="label"
                                                                   IsVisible="{Binding HasProbabilityDefinition}"/>
                                                        <TextBlock Text="{Binding SelectedProbabilityDefinition}"
                                                                   Classes="form_long_text"
                                                                   MaxWidth="260"
                                                                   IsVisible="{Binding HasProbabilityDefinition}"/>
                                                </StackPanel>
                                                <StackPanel  Orientation="Vertical" Margin="5 5  ">
                                                        <TextBlock Text="{Binding StrImpact}" Classes="label"/>
                                                        <ComboBox Name="ImpactComboBox" 
                                                                  ItemsSource="{Binding Impacts}"
                                                                  SelectedItem="{Binding SelectedImpact}"
                                                                  MinWidth="200">
                                                                <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <TextBlock Text="{Binding Name}" />
                                                                        </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <TextBlock Text="{Binding StrWhatThisLevelMeans}"
                                                                   Classes="label"
                                                                   IsVisible="{Binding HasImpactDefinition}"/>
                                                        <TextBlock Text="{Binding SelectedImpactDefinition}"
                                                                   Classes="form_long_text"
                                                                   MaxWidth="260"
                                                                   IsVisible="{Binding HasImpactDefinition}"/>
                                                </StackPanel>
                                                <StackPanel  Orientation="Vertical" Margin="5 5  ">
                                                        <TextBlock Text="{Binding StrValue}" Classes="label"/>
                                                        <TextBlock Text="{Binding Value}" FontSize="28"/>
                                                </StackPanel>
                                        </StackPanel>
                                </Panel>
                                
                                <!-- Bottom RISK DATA - the structured scenario (Stage 9.2, S42 §7), then the
                                     Notes section that expands. The four fields and the confidence are all
                                     optional: a legacy risk opens with them empty and saves unchanged. -->
                                <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                                        <TextBlock Grid.Row="0" Classes="header2" Text="{Binding StrStructuredScenario, Mode=OneTime}" HorizontalAlignment="Stretch"/>
                                        <TextBlock Grid.Row="1" Classes="hint" Text="{Binding StrScenarioTemplateHint, Mode=OneTime}" TextWrapping="Wrap" Margin="5 0"/>
                                        <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="5 0">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrScenarioCause, Mode=OneTime}" Classes="label"/>
                                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding ScenarioCause}"
                                                         PlaceholderText="{Binding StrScenarioCauseHint, Mode=OneTime}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Height="56" Margin="0 0 5 5"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StrScenarioVulnerability, Mode=OneTime}" Classes="label"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ScenarioVulnerability}"
                                                         PlaceholderText="{Binding StrScenarioVulnerabilityHint, Mode=OneTime}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Height="56" Margin="5 0 0 5"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrScenarioCentralEvent, Mode=OneTime}" Classes="label"/>
                                                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding ScenarioCentralEvent}"
                                                         PlaceholderText="{Binding StrScenarioCentralEventHint, Mode=OneTime}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Height="56" Margin="0 0 5 5"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StrScenarioConsequences, Mode=OneTime}" Classes="label"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ScenarioConsequences}"
                                                         PlaceholderText="{Binding StrScenarioConsequencesHint, Mode=OneTime}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" Height="56" Margin="5 0 0 5"/>
                                        </Grid>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5 0 5 5">
                                                <TextBlock Text="{Binding StrEvidenceConfidence, Mode=OneTime}" Classes="label" VerticalAlignment="Center"/>
                                                <ComboBox ItemsSource="{Binding ConfidenceOptions}"
                                                          SelectedItem="{Binding SelectedConfidence}"
                                                          MinWidth="200" Margin="5 0">
                                                        <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                        <TextBlock Text="{Binding Name}" />
                                                                </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                </ComboBox>
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Text="{Binding StrNotes}" Classes="label"/>
                                        <TextBox Grid.Row="5"
                                                 Text="{Binding Notes}"
                                                 IsReadOnly="False"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="80"
                                                 VerticalAlignment="Stretch"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Grid>
                                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="10 10 0 0">
                                        <Button Name="BtSave"
                                                Classes="dialog1"
                                                Margin="5 0"
                                                IsEnabled="{Binding SaveEnabled}"
                        ToolTip.Tip="{Binding ValidationContext.Text}"
                                                Command="{Binding BtSaveClicked}">
                                                <StackPanel Orientation="Horizontal">
                                                    <avalonia:MaterialIcon Kind="ContentSave" Width="16" Height="16" Margin="0 0 5 0"/>
                                                    <TextBlock Text="{Binding StrSave}"/>
                                                </StackPanel>
                                        </Button>
                                        <Button Name="BtCancel"
                                                Classes="dialog2"
                                                 Margin="5 0"
                                                 IsCancel="True"
                                                 Command="{Binding BtCancelClicked}">
                                                <StackPanel Orientation="Horizontal">
                                                    <avalonia:MaterialIcon Kind="Cancel" Width="16" Height="16" Margin="0 0 5 0"/>
                                                    <TextBlock Text="{Binding StrCancel}"/>
                                                </StackPanel>
                                        </Button>
                                </StackPanel>
                        </Grid>
                    </Panel>
                </ScrollViewer>

        </Panel>
</Window>
