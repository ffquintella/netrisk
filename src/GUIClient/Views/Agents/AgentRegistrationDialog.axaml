<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:agents="clr-namespace:GUIClient.ViewModels.Agents"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False"
        x:DataType="agents:AgentRegistrationDialogViewModel" x:Class="GUIClient.Views.Agents.AgentRegistrationDialog"
        Classes="dark"
        Title="{Binding StrTitle}">

    <!-- T346 (S55): approving issues an agent key; Esc, the window's close box and Deny all refuse. -->
    <Grid ColumnDefinitions="*, Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding StrTitle}" Classes="header"/>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StrAgentFingerprint}" Classes="fieldLabel" Margin="0 10 0 0"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Fingerprint}" Classes="agentFingerprint"/>

        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StrAgentName}" Classes="fieldLabel"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AgentName}" Classes="formData" MaxWidth="440"/>

        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StrAgentDescription}" Classes="fieldLabel"/>
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AgentDescription}" Classes="form_long_text" MaxWidth="440"/>

        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding StrAgentClient}" Classes="fieldLabel"/>
        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ClientText}" Classes="formData" MaxWidth="440"/>

        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding StrNotice}" Classes="notice" MaxWidth="440" Margin="0 12 0 0"/>
        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding QueueText}" Classes="hint" MaxWidth="440"
                   IsVisible="{Binding HasQueue}"/>

        <StackPanel Grid.Row="11" Grid.Column="1" Margin="10 10 0 10" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="BtApprove" Classes="dialog1" Command="{Binding BtApproveClicked}">
                <StackPanel Orientation="Horizontal">
                    <avalonia:MaterialIcon Kind="Check" Width="20" Height="20" Margin="0 0 5 0"/>
                    <TextBlock Text="{Binding StrApprove}"/>
                </StackPanel>
            </Button>
            <Button Name="BtDeny" Classes="dialog2" Margin="10 0 0 0" Command="{Binding BtDenyClicked}">
                <StackPanel Orientation="Horizontal">
                    <avalonia:MaterialIcon Kind="Cancel" Width="20" Height="20" Margin="0 0 5 0"/>
                    <TextBlock Text="{Binding StrDeny}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
