<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:agents="clr-namespace:GUIClient.ViewModels.Agents"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="480"
        Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False"
        x:DataType="agents:AgentAccessDialogViewModel" x:Class="GUIClient.Views.Agents.AgentAccessDialog"
        Classes="dark"
        Title="{Binding StrTitle}">

    <!-- T348 (S55): the user may grant fewer minutes or read-only; one block, read-only is preselected. -->
    <Grid ColumnDefinitions="*, Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding StrTitle}" Classes="header"/>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StrAgentName}" Classes="fieldLabel" Margin="0 10 0 0"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AgentName}" Classes="formData" MaxWidth="440"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Fingerprint}" Classes="agentFingerprint"/>

        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StrReason}" Classes="fieldLabel"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Reason}" Classes="form_long_text" MaxWidth="440"/>

        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding StrRequested}" Classes="fieldLabel"/>
        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding RequestedText}" Classes="formData"/>

        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding StrGrantDuration}" Classes="fieldLabel" Margin="0 10 0 0"/>
        <ComboBox Grid.Row="9" Grid.Column="1" MinWidth="250" HorizontalAlignment="Left"
                  ItemsSource="{Binding DurationLabels}" SelectedIndex="{Binding SelectedDurationIndex}"/>

        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding StrGrantMode}" Classes="fieldLabel"/>
        <ComboBox Grid.Row="11" Grid.Column="1" MinWidth="250" HorizontalAlignment="Left"
                  ItemsSource="{Binding ModeLabels}" SelectedIndex="{Binding SelectedModeIndex}"/>

        <!-- T357: confirm-each-write, on by default, for a read-write grant only. -->
        <StackPanel Grid.Row="12" Grid.Column="1" MaxWidth="440" IsVisible="{Binding IsReadWriteSelected}" Margin="0 8 0 0">
            <CheckBox Content="{Binding StrConfirmEachWrite}" IsChecked="{Binding ConfirmEachWrite}"/>
            <TextBlock Text="{Binding StrConfirmEachWriteHint}" Classes="hint"/>
        </StackPanel>

        <StackPanel Grid.Row="13" Grid.Column="1" MaxWidth="440">
            <TextBlock Text="{Binding StrNotice}" Classes="notice" Margin="0 12 0 0"/>
            <!-- T361: the LGPD disclosure, with the data classes withheld now (T362). -->
            <Border Classes="formCard caution" Margin="0 8 0 0">
                <Grid ColumnDefinitions="Auto,*">
                    <avalonia:MaterialIcon Grid.Column="0" Kind="ShieldAlertOutline" Classes="cautionIcon" Width="20" Height="20"
                                           VerticalAlignment="Top" Margin="0 0 8 0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StrLgpd}" Classes="hint"/>
                        <TextBlock Text="{Binding StrSandbox}" Classes="notice"/>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Margin="10 10 0 10" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="BtGrant" Classes="dialog1" Command="{Binding BtGrantClicked}">
                    <StackPanel Orientation="Horizontal">
                        <avalonia:MaterialIcon Kind="Check" Width="20" Height="20" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding StrGrant}"/>
                    </StackPanel>
                </Button>
                <Button Name="BtDeny" Classes="dialog2" Margin="10 0 0 0" Command="{Binding BtDenyClicked}">
                    <StackPanel Orientation="Horizontal">
                        <avalonia:MaterialIcon Kind="Cancel" Width="20" Height="20" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding StrDeny}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
