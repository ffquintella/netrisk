<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GUIClient.ViewModels.Track9" x:Class="GUIClient.Views.Track9.RiskAiModelsBlock"
             x:DataType="vm:RiskAiModelsBlockViewModel">
  <StackPanel Margin="5" Spacing="5">
    <TextBlock Classes="header2" Text="{Binding StrTitle}"/>
    <TextBlock Classes="warning" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
    <Grid IsEnabled="{Binding CanEdit}" ColumnDefinitions="280,240,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
      <TextBlock Classes="fieldLabel" Text="{Binding StrTitle}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrNotes}"/>
      <ComboBox Grid.Row="1" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedAvailableModel}" DisplayMemberBinding="{Binding Name}"/>
      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LinkNote}" MaxLength="500"/>
      <Button Grid.Row="1" Grid.Column="2" Classes="dialog1" Command="{Binding LinkCommand}"><TextBlock Text="{Binding StrAdd}"/></Button>
      <Button Grid.Row="1" Grid.Column="3" Classes="dialog2" Command="{Binding UnlinkCommand}"><TextBlock Text="{Binding StrRemove}"/></Button>
    </Grid>
    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedLinkedModel}" IsReadOnly="True" MinHeight="100">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="{Binding StrVersion}" Binding="{Binding Version}"/>
        <DataGridTextColumn Header="{Binding StrStatus}" Binding="{Binding StatusText}"/>
        <DataGridTextColumn Header="{Binding StrRiskTier}" Binding="{Binding RiskTierText}"/>
        <DataGridTextColumn Header="{Binding StrEvaluationState}" Binding="{Binding EvaluationStateText}"/>
        <DataGridTextColumn Header="{Binding StrNotes}" Binding="{Binding Note}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Orientation="Horizontal"><TextBlock Classes="label" Text="{Binding StrHidden}"/><TextBlock Margin="8 0 0 0" Text="{Binding Models.HiddenModelCount}"/></StackPanel>
  </StackPanel>
</UserControl>
