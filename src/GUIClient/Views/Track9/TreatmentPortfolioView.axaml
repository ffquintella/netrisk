<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GUIClient.ViewModels.Track9"
             xmlns:ring="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             x:Class="GUIClient.Views.Track9.TreatmentPortfolioView" x:DataType="vm:TreatmentPortfolioViewModel"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760">
    <Design.DataContext><vm:TreatmentPortfolioViewModel/></Design.DataContext>
    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,180,Auto,*" Margin="5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="header" Text="{Binding StrTitle}"/>
                <Button Grid.Column="1" Classes="type2" Command="{Binding ReloadCommand}"><TextBlock Text="{Binding StrReload}"/></Button>
            </Grid>
            <TextBlock Grid.Row="1" Classes="error" Text="{Binding LoadError}" IsVisible="{Binding HasLoadError}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="2" Classes="error" Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" TextWrapping="Wrap"/>
            <!-- Label+control pairs in a WrapPanel rather than fixed grid columns: the Semi DatePicker
                 is ~300px wide, so a fixed 160px column let it paint over the next label, and a
                 narrow window must wrap a pair instead of clipping it. -->
            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0 5">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 12 4">
                    <TextBlock Classes="form_label" Margin="3 0 0 0" VerticalAlignment="Center" Text="{Binding StrBudget}"/>
                    <NumericUpDown Width="150" VerticalAlignment="Center" Value="{Binding Budget}" Minimum="0" Maximum="1000000000000"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 12 4">
                    <TextBlock Classes="form_label" Margin="3 0 0 0" VerticalAlignment="Center" Text="{Binding StrPeopleCapacity}"/>
                    <NumericUpDown Width="150" VerticalAlignment="Center" Value="{Binding PeopleCapacity}" Minimum="0" Maximum="99999999"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 12 4">
                    <TextBlock Classes="form_label" Margin="3 0 0 0" VerticalAlignment="Center" Text="{Binding StrStartDate}"/>
                    <DatePicker VerticalAlignment="Center" SelectedDate="{Binding StartDate}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 12 4">
                    <TextBlock Classes="form_label" Margin="3 0 0 0" VerticalAlignment="Center" Text="{Binding StrDeadline}"/>
                    <DatePicker VerticalAlignment="Center" SelectedDate="{Binding Deadline}"/>
                </StackPanel>
                <Button Classes="type1" VerticalAlignment="Center" Margin="0 0 0 4" Command="{Binding CalculateCommand}" IsEnabled="{Binding CalculateEnabled}"><TextBlock Text="{Binding StrCalculate}"/></Button>
            </WrapPanel>
            <DataGrid Grid.Row="4" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{Binding StrCandidates, Mode=OneTime}" Binding="{Binding IsSelected}" Width="Auto"/>
                    <DataGridTextColumn Header="{Binding StrRisk, Mode=OneTime}" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*" ColumnSpacing="6" Margin="0 8">
                <TextBlock Classes="form_label" Text="{Binding StrBudgetUsed}"/><TextBlock Grid.Column="1" Classes="form_text" Text="{Binding BudgetUsedText}"/>
                <TextBlock Grid.Column="2" Classes="form_label" Text="{Binding StrPeopleUsed}"/><TextBlock Grid.Column="3" Classes="form_text" Text="{Binding PeopleUsedText}"/>
                <TextBlock Grid.Column="4" Classes="form_label" Text="{Binding StrExpectedReduction}"/><TextBlock Grid.Column="5" Classes="form_text" Text="{Binding ExpectedReductionText}"/>
                <TextBlock Grid.Column="6" Classes="form_label" Text="{Binding StrEscalations}"/><TextBlock Grid.Column="7" Classes="form_text" Text="{Binding EscalationsText}"/>
            </Grid>
            <DataGrid Grid.Row="6" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding StrRisk, Mode=OneTime}" Binding="{Binding Risk}" Width="2*"/>
                    <DataGridTextColumn Header="{Binding StrOption, Mode=OneTime}" Binding="{Binding Option}" Width="*"/>
                    <DataGridTextColumn Header="{Binding StrGateD, Mode=OneTime}" Binding="{Binding Tier}" Width="*"/>
                    <DataGridTextColumn Header="{Binding StrStatus, Mode=OneTime}" Binding="{Binding Status}" Width="*"/>
                    <DataGridTextColumn Header="{Binding StrBudget, Mode=OneTime}" Binding="{Binding FirstYearCost}" Width="Auto"/>
                    <DataGridTextColumn Header="{Binding StrPeopleCapacity, Mode=OneTime}" Binding="{Binding EffortPersonDays}" Width="Auto"/>
                    <DataGridTextColumn Header="{Binding StrReason, Mode=OneTime}" Binding="{Binding Reasons}" Width="2*"/>
                    <DataGridCheckBoxColumn Header="{Binding StrEscalations, Mode=OneTime}" Binding="{Binding RequiresEscalation}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <ring:ProgressRing Width="72" Height="72" IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" ZIndex="1000"/>
    </Panel>
</UserControl>
