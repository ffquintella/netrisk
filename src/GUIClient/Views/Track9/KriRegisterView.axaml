<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GUIClient.ViewModels.Track9"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:DataType="vm:KriRegisterViewModel"
             x:Class="GUIClient.Views.Track9.KriRegisterView">
    <Grid RowDefinitions="Auto,Auto,*" Margin="5">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="header" Text="{Binding StrTitle}"/>
            <CheckBox Grid.Column="1" Margin="8 0" Content="{Binding StrShowRetired}"
                      IsChecked="{Binding IncludeRetired}"/>
            <Button Grid.Column="2" Classes="type2" Command="{Binding BtReloadClicked}">
                <StackPanel Orientation="Horizontal">
                    <material:MaterialIcon Kind="Reload" Width="20" Height="20" Margin="0 0 5 0"/>
                    <TextBlock Text="{Binding StrReload}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Classes="operation" Margin="5 0 0 0"
                    Command="{Binding BtNewClicked}" ToolTip.Tip="{Binding StrCreate}"
                    IsEnabled="{Binding CanDefine}">
                <material:MaterialIcon Kind="Add" Width="20" Height="20"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1">
            <TextBlock Classes="notice" Text="{Binding StrThirdLine}" IsVisible="{Binding IsThirdLine}"/>
            <TextBlock Classes="warning2" Text="{Binding LoadError}" IsVisible="{Binding HasLoadError}"/>
            <TextBlock Classes="header_detail" Text="{Binding StrNoItems}" IsVisible="{Binding IsEmpty}"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="2*,3*" Margin="0 5 0 0">
            <DataGrid Grid.Column="0" Margin="0 0 5 0" ItemsSource="{Binding Kris}"
                      SelectedItem="{Binding SelectedKri}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="{Binding StrStatus}" Binding="{Binding StateLabel}" Width="*"/>
                    <DataGridTextColumn Header="{Binding StrValue}" Binding="{Binding LatestValue}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TabControl Grid.Column="1" IsEnabled="{Binding !IsBusy}">
                <TabItem Header="{Binding StrDefinition}">
                    <ScrollViewer>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              Margin="8">
                            <TextBlock Grid.Row="0" Classes="form_label" Text="{Binding StrName}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>
                            <TextBlock Grid.Row="1" Classes="form_label" Text="{Binding StrDescription}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Description}" AcceptsReturn="True"/>
                            <TextBlock Grid.Row="2" Classes="form_label" Text="{Binding StrCategory}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"/>
                            <TextBlock Grid.Row="3" Classes="form_label" Text="{Binding StrSource}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Source}"/>
                            <TextBlock Grid.Row="4" Classes="form_label" Text="{Binding StrUnit}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Unit}"/>
                            <TextBlock Grid.Row="5" Classes="form_label" Text="{Binding StrDirection}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Directions}"
                                      SelectedItem="{Binding SelectedDirection}"/>
                            <TextBlock Grid.Row="6" Classes="form_label" Text="{Binding StrTolerance}"/>
                            <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding ToleranceThreshold}"/>
                            <TextBlock Grid.Row="7" Classes="form_label" Text="{Binding StrWarning}"/>
                            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding WarningThreshold}"/>
                            <TextBlock Grid.Row="8" Classes="form_label" Text="{Binding StrRationale}"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ToleranceRationale}" AcceptsReturn="True"/>
                            <TextBlock Grid.Row="9" Classes="form_label" Text="{Binding StrMaxAge}"/>
                            <NumericUpDown Grid.Row="9" Grid.Column="1" Minimum="1" Maximum="366" Increment="1"
                                           Value="{Binding MaxReadingAgeDays}"/>
                            <TextBlock Grid.Row="10" Classes="form_label" Text="{Binding StrOwnerId}"/>
                            <ComboBox Grid.Row="10" Grid.Column="1" ItemsSource="{Binding Owners}"
                                      SelectedItem="{Binding SelectedOwner}"/>
                            <TextBlock Grid.Row="11" Classes="form_label" Text="{Binding StrEntityId}"/>
                            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox MinWidth="180" ItemsSource="{Binding EntityChoices}"
                                          SelectedItem="{Binding SelectedEntity}"/>
                                <Button Classes="dialog1" Margin="8 0" Command="{Binding BtSaveClicked}"
                                        IsEnabled="{Binding CanDefine}">
                                    <StackPanel Orientation="Horizontal">
                                        <material:MaterialIcon Kind="ContentSave" Width="20" Height="20" Margin="0 0 5 0"/>
                                        <TextBlock Text="{Binding StrSave}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="dialog2" Command="{Binding BtRetireClicked}" IsEnabled="{Binding CanRetire}">
                                    <StackPanel Orientation="Horizontal">
                                        <material:MaterialIcon Kind="Archive" Width="20" Height="20" Margin="0 0 5 0"/>
                                        <TextBlock Text="{Binding StrRetire}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding StrReadings}">
                    <Grid RowDefinitions="*,Auto,Auto">
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Detail.Readings}" SelectedItem="{Binding SelectedReading}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding StrObservedAt}" Binding="{Binding ObservedAt}" Width="2*"/>
                                <DataGridTextColumn Header="{Binding StrValue}" Binding="{Binding Value}" Width="*"/>
                                <DataGridTextColumn Header="{Binding StrNotes}" Binding="{Binding Note}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*,Auto">
                            <TextBlock Grid.Column="0" Classes="form_label" Text="{Binding StrValue}"/>
                            <NumericUpDown Grid.Column="1" Value="{Binding ReadingValue}"/>
                            <TextBlock Grid.Column="2" Classes="form_label" Text="{Binding StrObservedAt}"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding ReadingObservedAt}"/>
                            <Button Grid.Column="4" Classes="dialog1" Margin="8 0"
                                    Command="{Binding BtRecordReadingClicked}" IsEnabled="{Binding CanWriteDetail}">
                                <StackPanel Orientation="Horizontal">
                                    <material:MaterialIcon Kind="Add" Width="20" Height="20" Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding StrRecordReading}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Classes="form_label" Text="{Binding StrVoidReason}"/>
                            <TextBox Grid.Column="1" Text="{Binding VoidReason}"/>
                            <Button Grid.Column="2" Classes="dialog2" Margin="8 0"
                                    Command="{Binding BtVoidReadingClicked}" IsEnabled="{Binding CanWriteDetail}">
                                <StackPanel Orientation="Horizontal">
                                    <material:MaterialIcon Kind="Cancel" Width="20" Height="20" Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding StrVoid}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding StrLinkedRisks}">
                    <Grid RowDefinitions="*,Auto">
                        <DataGrid ItemsSource="{Binding Detail.Risks}" SelectedItem="{Binding SelectedLinkedRisk}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding StrRiskId}" Binding="{Binding RiskId}" Width="*"/>
                                <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Subject}" Width="3*"/>
                                <DataGridTextColumn Header="{Binding StrStatus}" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="form_label" Text="{Binding StrRiskId}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RiskChoices}"
                                      SelectedItem="{Binding SelectedRiskToLink}"/>
                            <Button Grid.Column="2" Classes="dialog1" Margin="8 0"
                                    Command="{Binding BtLinkRiskClicked}" IsEnabled="{Binding CanWriteDetail}">
                                <StackPanel Orientation="Horizontal">
                                    <material:MaterialIcon Kind="Link" Width="20" Height="20" Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding StrLink}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Classes="dialog2"
                                    Command="{Binding BtUnlinkRiskClicked}" IsEnabled="{Binding CanWriteDetail}">
                                <StackPanel Orientation="Horizontal">
                                    <material:MaterialIcon Kind="LinkOff" Width="20" Height="20" Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding StrUnlink}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <progRing:ProgressRing Grid.RowSpan="3" Width="80" Height="80" IsActive="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" ZIndex="1000"/>
    </Grid>
</UserControl>
