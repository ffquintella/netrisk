<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GUIClient.ViewModels.Track9"
             x:Class="GUIClient.Views.Track9.ThirdPartyRegisterView"
             x:DataType="vm:ThirdPartyRegisterViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="10">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
      <TextBlock Classes="header" Text="{Binding StrTitle}"/>
      <Button Grid.Column="1" Classes="operation" Command="{Binding ReloadCommand}"><TextBlock Text="{Binding StrRefresh}"/></Button>
      <Button Grid.Column="2" Classes="dialog1" Margin="6 0 0 0" IsEnabled="{Binding CanManage}" Command="{Binding NewCommand}"><TextBlock Text="{Binding StrNew}"/></Button>
      <Button Grid.Column="3" Classes="dialog1" Margin="6 0 0 0" Command="{Binding OpenCommand}"><TextBlock Text="{Binding StrOpen}"/></Button>
      <Button Grid.Column="4" Classes="dialog2" Margin="6 0 0 0" IsEnabled="{Binding CanManage}" Command="{Binding DeleteCommand}"><TextBlock Text="{Binding StrDelete}"/></Button>
    </Grid>
    <StackPanel Grid.Row="1">
      <TextBlock Classes="warning" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
      <TextBlock Classes="header_detail" Text="{Binding WriteDisabledReason}" IsVisible="{Binding !CanManage}"/>
      <TextBlock Classes="header_detail" Text="{Binding StrNoData}" IsVisible="{Binding IsEmpty}"/>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="340,*" Margin="0 8 0 0">
      <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" IsReadOnly="True">
        <DataGrid.Columns><DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="{Binding StrStatus}" Binding="{Binding StatusText}"/><DataGridTextColumn Header="{Binding StrFindings}" Binding="{Binding FindingCount}"/></DataGrid.Columns>
      </DataGrid>
      <TabControl Grid.Column="1" Margin="10 0 0 0">
        <TabItem Header="{Binding StrTitle}">
          <ScrollViewer><StackPanel Margin="8" Spacing="6">
            <Grid IsEnabled="{Binding CanManage}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3">
              <TextBlock Classes="fieldLabel" Text="{Binding StrName}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrLegalName}"/>
              <TextBox Grid.Row="1" Text="{Binding Editor.Name}" MaxLength="200"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.LegalName}" MaxLength="300"/>
              <TextBlock Grid.Row="2" Classes="fieldLabel" Text="{Binding StrTaxId}"/><TextBlock Grid.Row="2" Grid.Column="1" Classes="fieldLabel" Text="{Binding StrCountry}"/>
              <TextBox Grid.Row="3" Text="{Binding Editor.TaxId}" MaxLength="50"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Editor.Country}" MaxLength="2"/>
              <TextBlock Grid.Row="4" Classes="fieldLabel" Text="{Binding StrStatus}"/><TextBlock Grid.Row="4" Grid.Column="1" Classes="fieldLabel" Text="{Binding StrWebsite}"/>
              <ComboBox Grid.Row="5" ItemsSource="{Binding StatusOptions}" SelectedValue="{Binding SelectedEditorStatus}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/>
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Editor.Website}" MaxLength="500"/>
              <TextBlock Grid.Row="6" Classes="fieldLabel" Text="{Binding StrEntity}"/><TextBlock Grid.Row="6" Grid.Column="1" Classes="fieldLabel" Text="{Binding StrOwner}"/>
              <ComboBox Grid.Row="7" ItemsSource="{Binding EntityOptions}" SelectedValue="{Binding SelectedEditorEntityId}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/>
              <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding UserOptions}" SelectedValue="{Binding SelectedEditorOwnerId}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/>
              <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Classes="fieldLabel" Text="{Binding StrDescription}"/>
              <TextBox Grid.Row="9" Grid.ColumnSpan="2" Text="{Binding Editor.Description}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"/>
            </Grid>
            <WrapPanel IsEnabled="{Binding CanManage}"><CheckBox IsChecked="{Binding Editor.IsCloudProvider}" Margin="0 0 12 0"><TextBlock Text="{Binding StrCloud}"/></CheckBox><CheckBox IsChecked="{Binding Editor.IsIdentityProvider}" Margin="0 0 12 0"><TextBlock Text="{Binding StrIdentity}"/></CheckBox><CheckBox IsThreeState="True" IsChecked="{Binding Editor.ProcessesPersonalData}"><TextBlock Text="{Binding StrPersonalData}"/></CheckBox></WrapPanel>
            <Button Classes="dialog1" IsEnabled="{Binding CanManage}" Command="{Binding SaveCommand}" HorizontalAlignment="Left"><TextBlock Text="{Binding StrSave}"/></Button>
            <ItemsControl ItemsSource="{Binding SelectedParty.Findings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Classes="warning" Text="{Binding Message}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding StrContract}">
          <ScrollViewer><StackPanel Margin="8" Spacing="6" IsEnabled="{Binding CanManage}">
            <TextBlock Classes="fieldLabel" Text="{Binding StrContractReference}"/><TextBox Text="{Binding Editor.ContractReference}" MaxLength="200"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8"><TextBlock Classes="fieldLabel" Text="{Binding StrContractStart}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrContractEnd}"/><DatePicker Grid.Row="1" SelectedDate="{Binding Editor.ContractStart}"/><DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Editor.ContractEnd}"/></Grid>
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8"><TextBlock Classes="fieldLabel" Text="{Binding StrSla}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrRto}"/><TextBlock Grid.Column="2" Classes="fieldLabel" Text="{Binding StrRpo}"/><NumericUpDown Grid.Row="1" Value="{Binding Editor.SlaAvailabilityPercent}" Minimum="0" Maximum="100"/><NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Editor.ContractedRtoMinutes}" Minimum="0" Maximum="525600"/><NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding Editor.ContractedRpoMinutes}" Minimum="0" Maximum="525600"/></Grid>
            <TextBlock Classes="fieldLabel" Text="{Binding StrVulnerabilityFix}"/><NumericUpDown Value="{Binding Editor.VulnerabilityFixDays}" Minimum="0" Maximum="3650"/>
            <CheckBox IsThreeState="True" IsChecked="{Binding Editor.RightToAudit}"><TextBlock Text="{Binding StrRightToAudit}"/></CheckBox>
            <TextBlock Classes="fieldLabel" Text="{Binding StrAuditClause}"/><TextBox Text="{Binding Editor.AuditClauseReference}" MaxLength="500"/>
            <TextBlock Classes="fieldLabel" Text="{Binding StrExitPlan}"/><TextBox Text="{Binding Editor.ExitPlan}" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8"><TextBlock Classes="fieldLabel" Text="{Binding StrReviewedAt}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrTestedAt}"/><DatePicker Grid.Row="1" SelectedDate="{Binding Editor.ExitPlanReviewedAt}"/><DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Editor.ExitPlanTestedAt}"/></Grid>
            <TextBlock Classes="fieldLabel" Text="{Binding StrDataPortability}"/><TextBox Text="{Binding Editor.DataPortability}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"/>
            <Button Classes="dialog1" Command="{Binding SaveCommand}" HorizontalAlignment="Left"><TextBlock Text="{Binding StrSave}"/></Button>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="{Binding StrLinks}">
          <Grid Margin="8" RowDefinitions="Auto,*">
            <Grid IsEnabled="{Binding CanManage}" ColumnDefinitions="*,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6"><TextBlock Classes="fieldLabel" Text="{Binding StrEntity}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrDescription}"/><ComboBox Grid.Row="1" ItemsSource="{Binding EntityOptions}" SelectedValue="{Binding LinkEntityId}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LinkDescription}" MaxLength="500"/><Button Grid.Row="1" Grid.Column="2" Classes="dialog1" Command="{Binding LinkCommand}"><TextBlock Text="{Binding StrAdd}"/></Button><Button Grid.Row="1" Grid.Column="3" Classes="dialog2" Command="{Binding UnlinkCommand}"><TextBlock Text="{Binding StrRemove}"/></Button></Grid>
            <DataGrid Grid.Row="1" Margin="0 8 0 0" ItemsSource="{Binding LinkRows}" SelectedItem="{Binding SelectedLinkRow}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{Binding StrKind}" Binding="{Binding KindText}"/><DataGridTextColumn Header="{Binding StrEntity}" Binding="{Binding EntityName}" Width="*"/><DataGridTextColumn Header="{Binding StrDescription}" Binding="{Binding Description}" Width="2*"/></DataGrid.Columns></DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding StrSubprocessors}">
          <Grid Margin="8" RowDefinitions="Auto,*,Auto">
            <Grid IsEnabled="{Binding CanManage}" ColumnDefinitions="2*,*,2*,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6"><TextBlock Classes="fieldLabel" Text="{Binding StrName}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrSupplier}"/><TextBlock Grid.Column="2" Classes="fieldLabel" Text="{Binding StrService}"/><TextBlock Grid.Column="3" Classes="fieldLabel" Text="{Binding StrCountry}"/><TextBox Grid.Row="1" Text="{Binding NewSubprocessor.Name}" MaxLength="200"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ThirdPartyOptions}" SelectedValue="{Binding SelectedSubprocessorThirdPartyId}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewSubprocessor.Service}" MaxLength="500"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding NewSubprocessor.Country}" MaxLength="2"/><CheckBox Grid.Row="1" Grid.Column="4" IsChecked="{Binding NewSubprocessor.ProcessesPersonalData}"><TextBlock Text="{Binding StrPersonalData}"/></CheckBox><Button Grid.Row="1" Grid.Column="5" Classes="dialog1" Command="{Binding AddSubprocessorCommand}"><TextBlock Text="{Binding StrAdd}"/></Button></Grid>
            <DataGrid Grid.Row="1" Margin="0 8 0 0" ItemsSource="{Binding SubprocessorDrafts}" SelectedItem="{Binding SelectedSubprocessorDraft}" IsReadOnly="{Binding !CanManage}"><DataGrid.Columns><DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="{Binding StrService}" Binding="{Binding Service}" Width="*"/><DataGridTextColumn Header="{Binding StrCountry}" Binding="{Binding Country}"/><DataGridCheckBoxColumn Header="{Binding StrPersonalData}" Binding="{Binding ProcessesPersonalData}"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="2" IsEnabled="{Binding CanManage}" Orientation="Horizontal" Spacing="6" Margin="0 8 0 0"><Button Classes="dialog2" Command="{Binding RemoveSubprocessorCommand}"><TextBlock Text="{Binding StrRemove}"/></Button><Button Classes="dialog1" Command="{Binding SaveSubprocessorsCommand}"><TextBlock Text="{Binding StrSaveList}"/></Button></StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding StrLocations}">
          <Grid Margin="8" RowDefinitions="Auto,*,Auto">
            <Grid IsEnabled="{Binding CanManage}" ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6"><TextBlock Classes="fieldLabel" Text="{Binding StrCountry}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrRegion}"/><TextBlock Grid.Column="2" Classes="fieldLabel" Text="{Binding StrPurpose}"/><TextBox Grid.Row="1" Text="{Binding NewLocation.Country}" MaxLength="2"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewLocation.Region}" MaxLength="200"/><ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding LocationPurposeOptions}" SelectedValue="{Binding SelectedLocationPurpose}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/><Button Grid.Row="1" Grid.Column="3" Classes="dialog1" Command="{Binding AddLocationCommand}"><TextBlock Text="{Binding StrAdd}"/></Button></Grid>
            <DataGrid Grid.Row="1" Margin="0 8 0 0" ItemsSource="{Binding LocationDrafts}" SelectedItem="{Binding SelectedLocationDraft}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{Binding StrCountry}" Binding="{Binding Country}"/><DataGridTextColumn Header="{Binding StrRegion}" Binding="{Binding Region}" Width="*"/><DataGridTextColumn Header="{Binding StrPurpose}" Binding="{Binding PurposeText}"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="2" IsEnabled="{Binding CanManage}" Orientation="Horizontal" Spacing="6" Margin="0 8 0 0"><Button Classes="dialog2" Command="{Binding RemoveLocationCommand}"><TextBlock Text="{Binding StrRemove}"/></Button><Button Classes="dialog1" Command="{Binding SaveLocationsCommand}"><TextBlock Text="{Binding StrSaveList}"/></Button></StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding StrHecvat}">
          <Grid Margin="8" RowDefinitions="Auto,150,Auto,*,Auto">
            <Grid IsEnabled="{Binding CanManage}" ColumnDefinitions="*,*,*,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="3"><TextBlock Classes="fieldLabel" Text="{Binding StrKind}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrFrameworkVersion}"/><TextBlock Grid.Column="2" Classes="fieldLabel" Text="{Binding StrExpectedQuestions}"/><TextBlock Grid.Column="3" Classes="fieldLabel" Text="{Binding StrValidUntil}"/><ComboBox Grid.Row="1" ItemsSource="{Binding HecvatVariantOptions}" SelectedValue="{Binding SelectedAssessmentVariant}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AssessmentDraft.FrameworkVersion}" MaxLength="20"/><NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding AssessmentDraft.ExpectedQuestionCount}" Minimum="1" Maximum="2000"/><DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding AssessmentDraft.ValidUntil}"/><Button Grid.Row="1" Grid.Column="4" Classes="dialog1" Command="{Binding RecordAssessmentCommand}"><TextBlock Text="{Binding StrAdd}"/></Button><TextBlock Grid.Row="2" Classes="fieldLabel" Text="{Binding StrRespondedAt}"/><TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="fieldLabel" Text="{Binding StrEvidence}"/><TextBlock Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Classes="fieldLabel" Text="{Binding StrNotes}"/><DatePicker Grid.Row="3" SelectedDate="{Binding AssessmentDraft.RespondedAt}"/><TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AssessmentDraft.EvidenceReference}" MaxLength="500"/><TextBox Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2" Text="{Binding AssessmentDraft.Notes}" MaxLength="2000"/></Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding AssessmentRows}" SelectedItem="{Binding SelectedAssessmentRow}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{Binding StrKind}" Binding="{Binding VariantText}"/><DataGridTextColumn Header="{Binding StrState}" Binding="{Binding StateText}"/><DataGridTextColumn Header="{Binding StrAnswered}" Binding="{Binding AnsweredCount}"/><DataGridTextColumn Header="{Binding StrUnanswered}" Binding="{Binding UnansweredCount}"/></DataGrid.Columns></DataGrid>
            <Grid Grid.Row="2" IsEnabled="{Binding CanManage}" ColumnDefinitions="*,*,*,*,Auto,2*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" Margin="0 8 0 0"><TextBlock Classes="fieldLabel" Text="{Binding StrQuestion}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrAnswer}"/><TextBlock Grid.Column="2" Classes="fieldLabel" Text="{Binding StrPreferredAnswer}"/><TextBlock Grid.Column="3" Classes="fieldLabel" Text="{Binding StrWeight}"/><TextBlock Grid.Column="4" Classes="fieldLabel" Text="{Binding StrCritical}"/><TextBlock Grid.Column="5" Classes="fieldLabel" Text="{Binding StrNotes}"/><TextBox Grid.Row="1" Text="{Binding NewAnswer.QuestionId}" MaxLength="20"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding HecvatAnswerOptions}" SelectedValue="{Binding SelectedAnswerValue}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/><ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding HecvatAnswerOptions}" SelectedValue="{Binding SelectedPreferredAnswerValue}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Name}"/><NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding NewAnswer.Weight}" Minimum="1" Maximum="100"/><CheckBox Grid.Row="1" Grid.Column="4" IsChecked="{Binding NewAnswer.Critical}"/><TextBox Grid.Row="1" Grid.Column="5" Text="{Binding NewAnswer.Notes}" MaxLength="2000"/><Button Grid.Row="1" Grid.Column="6" Classes="dialog1" Command="{Binding AddAnswerCommand}"><TextBlock Text="{Binding StrAdd}"/></Button></Grid>
            <DataGrid Grid.Row="3" ItemsSource="{Binding AnswerDrafts}" SelectedItem="{Binding SelectedAnswerDraft}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{Binding StrQuestion}" Binding="{Binding QuestionId}"/><DataGridTextColumn Header="{Binding StrAnswer}" Binding="{Binding AnswerText}"/><DataGridTextColumn Header="{Binding StrPreferredAnswer}" Binding="{Binding PreferredAnswerText}"/><DataGridTextColumn Header="{Binding StrWeight}" Binding="{Binding Weight}"/><DataGridCheckBoxColumn Header="{Binding StrCritical}" Binding="{Binding Critical}"/><DataGridTextColumn Header="{Binding StrNotes}" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0 8 0 0"><Button Classes="dialog2" IsEnabled="{Binding CanManage}" Command="{Binding RemoveAnswerCommand}"><TextBlock Text="{Binding StrRemove}"/></Button><Button Classes="dialog1" Command="{Binding OpenAssessmentCommand}"><TextBlock Text="{Binding StrOpen}"/></Button><Button Classes="dialog1" IsEnabled="{Binding CanManage}" Command="{Binding SaveAnswersCommand}"><TextBlock Text="{Binding StrSave}"/></Button><TextBlock Classes="fieldLabel" VerticalAlignment="Center" Text="{Binding StrReason}"/><TextBox IsEnabled="{Binding CanManage}" Text="{Binding AssessmentVoidReason}" MaxLength="1000" Width="280"/><Button Classes="dialog2" IsEnabled="{Binding CanManage}" Command="{Binding VoidAssessmentCommand}"><TextBlock Text="{Binding StrVoid}"/></Button></StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding StrSbom}">
          <Grid Margin="8" RowDefinitions="Auto,120,Auto,*,180">
            <Grid IsEnabled="{Binding CanManage}" ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6"><TextBlock Classes="fieldLabel" Text="{Binding StrComponentName}"/><TextBlock Grid.Column="1" Classes="fieldLabel" Text="{Binding StrComponentVersion}"/><TextBlock Grid.Column="2" Classes="fieldLabel" Text="{Binding StrFileName}"/><TextBox Grid.Row="1" Text="{Binding SbomDraft.ComponentName}" MaxLength="200"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SbomDraft.ComponentVersion}" MaxLength="100"/><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SbomDraft.FileName}" MaxLength="255"/><Button Grid.Row="1" Grid.Column="3" Classes="dialog1" Command="{Binding ImportSbomCommand}"><TextBlock Text="{Binding StrImported}"/></Button></Grid>
            <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0 6 0 0"><TextBlock Classes="fieldLabel" Text="{Binding StrSbomDocument}"/><TextBox Grid.Row="1" IsEnabled="{Binding CanManage}" Text="{Binding SbomDraft.Document}" MaxLength="5242880" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace"/></Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0 6 0 0"><Button Classes="dialog1" Command="{Binding OpenSbomCommand}"><TextBlock Text="{Binding StrOpen}"/></Button><Button Classes="dialog2" IsEnabled="{Binding CanManage}" Command="{Binding DeleteSbomCommand}"><TextBlock Text="{Binding StrDelete}"/></Button></StackPanel>
            <DataGrid Grid.Row="3" ItemsSource="{Binding SbomRows}" SelectedItem="{Binding SelectedSbomRow}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{Binding StrComponentName}" Binding="{Binding ComponentName}" Width="*"/><DataGridTextColumn Header="{Binding StrComponentVersion}" Binding="{Binding ComponentVersion}"/><DataGridTextColumn Header="{Binding StrFormat}" Binding="{Binding FormatText}"/><DataGridTextColumn Header="{Binding StrComponentCount}" Binding="{Binding ComponentCount}"/><DataGridTextColumn Header="{Binding StrSha256}" Binding="{Binding DocumentSha256}" Width="2*"/></DataGrid.Columns></DataGrid>
            <DataGrid Grid.Row="4" Margin="0 6 0 0" ItemsSource="{Binding SelectedSbom.Components}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="{Binding StrComponentName}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="{Binding StrComponentVersion}" Binding="{Binding Version}"/><DataGridTextColumn Header="{Binding StrPurl}" Binding="{Binding Purl}" Width="2*"/><DataGridTextColumn Header="{Binding StrLicense}" Binding="{Binding License}"/></DataGrid.Columns></DataGrid>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
