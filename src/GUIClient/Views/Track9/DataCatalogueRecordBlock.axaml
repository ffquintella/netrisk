<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GUIClient.ViewModels.Track9"
             x:Class="GUIClient.Views.Track9.DataCatalogueRecordBlock"
             x:DataType="vm:DataCatalogueRecordBlockViewModel">
  <StackPanel Margin="5" Spacing="6">
    <TextBlock Classes="header2" Text="{Binding StrTitle}"/>
    <TextBlock Classes="warning" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
    <TextBlock Classes="header_detail" Text="{Binding StrNotCatalogued}" IsVisible="{Binding IsNotCatalogued}"/>
    <StackPanel IsVisible="{Binding HasRecord}" Spacing="6">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <TextBlock Classes="label" Text="{Binding StrPersonalData}"/><TextBlock Grid.Column="1" Text="{Binding PersonalDataText}"/>
      </Grid>
      <TextBlock Classes="header3" Text="{Binding StrPurposes}"/>
      <DataGrid ItemsSource="{Binding Record.Purposes}" IsReadOnly="True" MinHeight="80">
        <DataGrid.Columns><DataGridTextColumn Header="{Binding StrPurpose}" Binding="{Binding Purpose}" Width="*"/><DataGridTextColumn Header="{Binding StrLegalBasis}" Binding="{Binding LegalBasisArticle}" Width="*"/><DataGridTextColumn Header="{Binding StrLegalRequirement}" Binding="{Binding LegalRequirement.Title}" Width="*"/></DataGrid.Columns>
      </DataGrid>
      <TextBlock Classes="header3" Text="{Binding StrRetention}"/>
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Classes="label" Text="{Binding StrRetentionPeriod}"/><TextBlock Grid.Column="1" Text="{Binding Record.RetentionPeriodMonths}"/>
        <TextBlock Grid.Row="1" Classes="label" Text="{Binding StrRetentionTrigger}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Record.RetentionTrigger}"/>
        <TextBlock Grid.Row="2" Classes="label" Text="{Binding StrRetentionBasis}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Record.RetentionBasis}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="3" Classes="label" Text="{Binding StrLegalRequirement}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Record.RetentionRequirement.Title}"/>
      </Grid>
      <TextBlock Classes="header3" Text="{Binding StrLocations}"/>
      <ItemsControl ItemsSource="{Binding LocationRows}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Classes="header3" Text="{Binding StrTransfer}"/>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><TextBlock Classes="label" Text="{Binding StrTransferMechanism}"/><TextBlock Grid.Column="1" Text="{Binding TransferMechanismText}"/></Grid>
      <ItemsControl ItemsSource="{Binding Record.TransferCountries}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Classes="header3" Text="{Binding StrProcessors}"/>
      <ItemsControl ItemsSource="{Binding ProcessorRows}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Classes="header3" Text="{Binding StrFindings}"/>
      <ItemsControl ItemsSource="{Binding Record.Findings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Classes="warning" Text="{Binding Message}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
