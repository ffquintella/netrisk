<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:GUIClient.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:dvm="clr-namespace:GUIClient.ViewModels" x:DataType="dvm:ConfigurationViewModel" x:Class="GUIClient.Views.ConfigurationView">
    <Design.DataContext>
        <viewModels:ConfigurationViewModel/>
    </Design.DataContext>
    <Grid>
        <!-- IX-4: visible busy indication while the view loads. -->
        <progRing:ProgressRing Width="80" Height="80"
                               IsActive="{Binding IsBusy}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="CornflowerBlue" ZIndex="1000"/>

        <ScrollViewer>
            <StackPanel Width="520" HorizontalAlignment="Left">

                <Border Classes="formCard">
                    <StackPanel>
                        <TextBlock Text="{Binding StrSystemConfigurations}" Classes="sectionCaption"/>

                        <TextBlock Text="{Binding StrBackupPassword}" Classes="fieldLabel"/>
                        <!-- The padlock states whether a password is already stored; the box is
                             write-only, so an empty box does not mean "no password". -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Name="txtBackupPassword"
                                     Text="{Binding BackupPassword}" PasswordChar="*"/>
                            <avalonia:MaterialIcon Grid.Column="1" Kind="LockOpen" Margin="6 0 0 0"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !PasswordSet}"/>
                            <avalonia:MaterialIcon Grid.Column="1" Kind="Lock" Margin="6 0 0 0"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding PasswordSet}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="formCard">
                    <StackPanel>
                        <TextBlock Text="{Binding StrWebsiteSync}" Classes="sectionCaption"/>

                        <TextBlock Text="{Binding StrWebsiteSyncUrl}" Classes="fieldLabel"/>
                        <TextBox Name="txtWebsiteSyncUrl" Text="{Binding WebsiteSyncUrl}"
                                 PlaceholderText="https://site:6443"/>

                        <TextBlock Text="{Binding StrWebsiteSyncInterval}" Classes="fieldLabel"
                                   Margin="0 12 0 3"/>
                        <NumericUpDown Value="{Binding WebsiteSyncInterval}" Minimum="1" Maximum="1440"
                                       Increment="1" HorizontalAlignment="Left" Width="160"/>

                        <TextBlock Text="{Binding StrWebsiteFastSyncInterval}" Classes="fieldLabel"
                                   Margin="0 12 0 3"/>
                        <NumericUpDown Value="{Binding WebsiteFastSyncInterval}" Minimum="1" Maximum="1440"
                                       Increment="1" HorizontalAlignment="Left" Width="160"/>
                    </StackPanel>
                </Border>

                <Button Classes="operation" Content="{Binding StrSave}" HorizontalAlignment="Left"
                        Command="{Binding SaveConfigurations}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
