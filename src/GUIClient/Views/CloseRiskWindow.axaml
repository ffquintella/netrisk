<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GUIClient.ViewModels"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:dvm="clr-namespace:GUIClient.ViewModels" x:DataType="dvm:CloseRiskViewModel" x:Class="GUIClient.Views.CloseRiskWindow"
        Title="{Binding StrCloseRisk}"
        Width="500" Height="290"
        CanResize="False"
        Name="CloseRisk">
    <Design.DataContext>
        <vm:CloseRiskViewModel/>
    </Design.DataContext>
    <Grid ColumnDefinitions="Auto, Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Panel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="{Binding StrCloseRisk}" Classes="title"/>
        </Panel>
        
        <TextBlock  Grid.Row="1" Grid.Column="0" Text="{Binding StrReason}" 
                    Margin="5 10 5 0" Classes="label" />
        
        <ComboBox TabIndex="1" Grid.Row="1" Grid.Column="1" x:Name="StrategyComboBox" MinWidth="297" Margin="5 5"
                  ItemsSource="{Binding CloseReasons}"
                  SelectedItem="{Binding SelectedCloseReason, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        
        <TextBlock  Grid.Row="2" Grid.Column="0" Text="{Binding StrNotes}"
                    Margin="5 10 5 0" Classes="label"/>
        <TextBox TabIndex="2" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Name="TxtReason" 
                 AcceptsReturn="True"  TextWrapping="Wrap" Height="120" Text="{Binding Notes}"
                 Margin="5 5"/>
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Margin="10 10 0 0">
            <TextBlock Classes="validationSummary"
                       IsVisible="{Binding ValidationContext.HasErrors}"
                       Text="{Binding ValidationContext.Text}"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <Button TabIndex="3"  Name="BtSave" Classes="dialog1"
                     Margin="5 5"
                     IsEnabled="{Binding SaveEnabled}"
                        ToolTip.Tip="{Binding ValidationContext.Text}"
                     Command="{Binding BtSaveClicked}">
                <StackPanel Orientation="Horizontal">
                    <material:MaterialIcon Kind="ContentSave" Margin="5 0"/>
                    <TextBlock Text="{Binding StrSave}"/> 
                </StackPanel>
            </Button>
            <Button TabIndex="4"   Name="BtCancel" Classes="dialog2"
                    Margin="5 5"
                    IsCancel="True"
                    Command="{Binding BtCancelClicked}">
                <StackPanel Orientation="Horizontal">
                    <material:MaterialIcon Kind="Cancel" Margin="5 0"/>
                    <TextBlock Text="{Binding StrCancel}"/> 
                </StackPanel>
            </Button>
            </StackPanel>
        </StackPanel>

        
    </Grid>
    
</Window>
