<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:reports="clr-namespace:GUIClient.ViewModels.Reports"
        xmlns:entities="clr-namespace:DAL.Entities;assembly=DAL"
        xmlns:converters="clr-namespace:GUIClient.Converters"
        xmlns:controls="clr-namespace:GUIClient.Controls"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="800" Height="450"
        MinWidth="640" MinHeight="400"
        x:Class="GUIClient.Views.Reports.ReportScheduleManagerWindow"
        x:DataType="reports:ReportScheduleManagerViewModel"
        Title="{Binding StrTitle}">

    <Design.DataContext>
        <reports:ReportScheduleManagerViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:DateToFormatedStringConverter x:Key="DateToFormatedStringConverter"/>
    </Window.Resources>

    <!-- IX-5 archetype C, from the shared ManagerShell. -->
    <controls:ManagerShell Title="{Binding StrTitle}" ListHeader="{Binding StrSchedules}">

        <controls:ManagerShell.ListContent>
            <ListBox SelectionMode="Single"
                     ItemsSource="{Binding Schedules}"
                     SelectedItem="{Binding SelectedSchedule}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="entities:ReportSchedule">
                        <StackPanel Margin="0 2">
                            <TextBlock Text="{Binding ReportTemplateVersion.Template.Name}" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding LastStatus, FallbackValue=''}" Classes="listSubtitle"/>
                                <TextBlock Text="{Binding LastRunAt}" Classes="listSubtitle"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </controls:ManagerShell.ListContent>

        <controls:ManagerShell.ControlBarContent>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0" Name="BtAdd" Classes="subButton"
                        ToolTip.Tip="{Binding StrCreate}"
                        Command="{Binding CreateCommand}">
                    <material:MaterialIcon Kind="Add"/>
                </Button>
                <Button Grid.Column="1" Name="BtEdit" Classes="subButton type2"
                        ToolTip.Tip="{Binding StrUpdate}"
                        Command="{Binding UpdateCommand}">
                    <material:MaterialIcon Kind="Pencil"/>
                </Button>
                <Button Grid.Column="2" Name="BtTest" Classes="subButton type2"
                        ToolTip.Tip="{Binding StrTest}"
                        Command="{Binding TestCommand}">
                    <material:MaterialIcon Kind="PlayCircleOutline"/>
                </Button>
                <Button Grid.Column="4" Name="BtDelete" Classes="subButton type3"
                        ToolTip.Tip="{Binding StrDelete}"
                        Command="{Binding DeleteCommand}">
                    <material:MaterialIcon Kind="Delete"/>
                </Button>
            </Grid>
        </controls:ManagerShell.ControlBarContent>

        <controls:ManagerShell.DetailContent>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="{Binding !!SelectedSchedule}">
                <TextBlock Grid.Row="0" Text="{Binding StrDetails}" Classes="header2"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="5" Margin="0 5 0 0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrTemplate}" Classes="form_label"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSchedule.ReportTemplateVersion.Template.Name}" Classes="form_text2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StrFrequencyCron}" Classes="form_label"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSchedule.FrequencyCron}" Classes="form_text2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrTimezone}" Classes="form_label"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSchedule.Timezone}" Classes="form_text2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding StrRecipients}" Classes="form_label"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSchedule.RecipientsJson}" Classes="form_long_text"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrEnabled}" Classes="form_label"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" IsEnabled="False" IsChecked="{Binding SelectedSchedule.IsEnabled}"/>
                </Grid>

                <TextBlock Grid.Row="2" Text="{Binding StrLastRun}" Classes="header2" Margin="0 10 0 0"/>
                <Grid Grid.Row="3" ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto"
                      ColumnSpacing="5" Margin="0 5 0 0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrWhen}" Classes="form_label"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSchedule.LastRunAt, Converter={StaticResource DateToFormatedStringConverter}, FallbackValue=''}" Classes="form_text2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StrStatus}" Classes="form_label"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSchedule.LastStatus}" Classes="form_text2"/>
                </Grid>
            </Grid>
        </controls:ManagerShell.DetailContent>
    </controls:ManagerShell>
</Window>
