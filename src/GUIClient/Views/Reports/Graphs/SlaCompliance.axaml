<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:graphs="clr-namespace:GUIClient.ViewModels.Reports.Graphs"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="240"
             x:DataType="graphs:SlaComplianceViewModel"
             x:Class="GUIClient.Views.Reports.Graphs.SlaCompliance"
             Name="SlaComplianceUc">

    <Design.DataContext>
        <graphs:SlaComplianceViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- The title is a full-width band and the headline a `header2` sub-band, so this
             quadrant lines up with the other three on the dashboard; a centred StackPanel of two
             chips floated both of them in the middle of the cell. -->
        <TextBlock Grid.Row="0" Classes="header" Text="{Binding StrSlaCompliance}" TextAlignment="Center"/>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" Classes="Graph">
            <TextBlock Grid.Row="0" Classes="header2" Text="{Binding Summary}" TextAlignment="Center"/>

            <!-- A table rather than a chart: "how many criticals are overdue" is a number, and four
                 numbers read faster than four bars. -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True" MinHeight="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding #SlaComplianceUc.DataContext.StrSeverity}"
                                        Binding="{Binding SeverityName}"/>
                    <DataGridTextColumn Header="Open" Binding="{Binding Total}"/>
                    <DataGridTextColumn Header="{Binding #SlaComplianceUc.DataContext.StrWithinSla}"
                                        Binding="{Binding WithinSla}"/>
                    <DataGridTextColumn Header="{Binding #SlaComplianceUc.DataContext.StrBreached}"
                                        Binding="{Binding Breached}"/>
                    <DataGridTextColumn Header="%" Binding="{Binding Compliance}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
