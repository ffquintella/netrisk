<dialogs:DialogWindowBase x:TypeArguments="results:EditRiskChainDialogResult"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:viewModels="clr-namespace:GUIClient.ViewModels"
        xmlns:dialogs="clr-namespace:GUIClient.ViewModels.Dialogs"
        xmlns:results="clr-namespace:GUIClient.ViewModels.Dialogs.Results"
        xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:DataType="viewModels:EditRiskChainDialogViewModel"
        x:Class="GUIClient.Views.EditRiskChainDialog"
        Title="{Binding StrTitle}"
        Width="760" SizeToContent="Height"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <viewModels:EditRiskChainDialogViewModel/>
    </Design.DataContext>

    <!-- Stage 9.1 (S41 §7): the risk's links per level, and a level + target picker to add one.
         Every operation is saved immediately; Close only reports whether anything changed. -->
    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*" Margin="10">
            <TextBlock Grid.Row="0" Classes="header" Text="{Binding StrTitle}"/>
            <TextBlock Grid.Row="1" Classes="header_detail" Text="{Binding RiskSubject}" TextWrapping="Wrap"/>

            <!-- The links. Legacy rows come from the risk's Entity field and are removed there. -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0 10 0 0">
                <TextBlock Grid.Column="0" Classes="header2" Text="{Binding StrLinkageChain}"/>
                <Button Grid.Column="1" Classes="operation" Margin="5 0 0 0"
                        Command="{Binding BtRemoveLinkClicked}"
                        IsEnabled="{Binding IsRemoveLinkEnabled}"
                        ToolTip.Tip="{Binding StrRemoveChainLink}">
                    <material:MaterialIcon Kind="Delete"/>
                </Button>
            </Grid>

            <DataGrid Grid.Row="3" Margin="0 5 0 0" MinHeight="180" MaxHeight="320"
                      ItemsSource="{Binding Links}"
                      SelectedItem="{Binding SelectedLink, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding StrChainLevel, Mode=OneTime}"
                                        Binding="{Binding LevelName}" Width="*" MinWidth="110"/>
                    <DataGridTextColumn Header="{Binding StrChainTarget, Mode=OneTime}"
                                        Binding="{Binding TargetName}" Width="2*" MinWidth="180"/>
                    <DataGridTextColumn Header="{Binding StrChainOrigin, Mode=OneTime}"
                                        Binding="{Binding OriginName}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="{Binding StrChainLinkedAt, Mode=OneTime}"
                                        Binding="{Binding LinkedAt, StringFormat={}{0:g}}" Width="*" MinWidth="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="4" Classes="header_detail" TextWrapping="Wrap"
                       Text="{Binding StrChainLegacyLinkHint}"
                       IsVisible="{Binding IsLegacyHintVisible}"/>

            <!-- Add: the level first, then a target of that level's types. -->
            <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,Auto,*,Auto" RowDefinitions="Auto" Margin="0 10 0 0">
                <TextBlock Grid.Column="0" Classes="form_label" Text="{Binding StrChainLevel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" MinWidth="150" Margin="5"
                          ItemsSource="{Binding Levels}"
                          SelectedItem="{Binding SelectedLevel, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ChainLevelOption">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Classes="form_label" Text="{Binding StrChainTarget}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="3" MinWidth="250" Margin="5" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Targets}"
                          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                          PlaceholderText="{Binding StrSelectChainTarget}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ChainTargetOption">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4" Classes="subButton" VerticalAlignment="Center"
                        Command="{Binding BtAddLinkClicked}"
                        IsEnabled="{Binding IsAddLinkEnabled}"
                        ToolTip.Tip="{Binding StrAddChainLink}">
                    <material:MaterialIcon Classes="subButton" Kind="Plus"/>
                </Button>
            </Grid>

            <!-- Asset level only: hosts are rows of the host inventory, not entities, so they are
                 found by search. Without `hosts` the search is unavailable and the reason is shown. -->
            <StackPanel Grid.Row="6" IsVisible="{Binding IsHostSearchVisible}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Margin="5" MinWidth="250"
                             Text="{Binding HostSearchText}"
                             PlaceholderText="{Binding StrSearchHost}"
                             IsEnabled="{Binding IsSearchHostEnabled}"/>
                    <Button Grid.Column="1" Classes="type3" VerticalAlignment="Center"
                            Command="{Binding BtSearchHostClicked}"
                            IsEnabled="{Binding IsSearchHostEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Magnify" Width="20" Height="20" Margin="0 0 5 0"/>
                            <TextBlock Text="{Binding StrSearch}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Classes="header_detail" TextWrapping="Wrap"
                           Text="{Binding StrRequiresHostsPermission}"
                           IsVisible="{Binding IsHostsPermissionHintVisible}"/>
            </StackPanel>

            <!-- Action row (§4.4). Edits are immediate, so there is only Close. -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10 10 0 0">
                <Button Classes="dialog2" Command="{Binding BtCloseClicked}">
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="Close" Width="20" Height="20" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding StrClose}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <progRing:ProgressRing Width="80" Height="80"
                               IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               ZIndex="1000"/>
    </Panel>
</dialogs:DialogWindowBase>
