<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GUIClient.ViewModels"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="330"
        xmlns:dvm="clr-namespace:GUIClient.ViewModels" x:DataType="dvm:FindingStatusDialogViewModel"
        x:Class="GUIClient.Views.FindingStatusDialog"
        Width="480" Height="360"
        Title="{Binding StrTitle}">

        <Design.DataContext>
                <viewModels:FindingStatusDialogViewModel/>
        </Design.DataContext>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="Auto,*" Margin="15">
                <Panel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="title">
                        <TextBlock Text="{Binding StrTitle}" Classes="header" Margin="0 0 0 5"/>
                </Panel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding FindingTitle}" TextWrapping="Wrap" Margin="0 0 0 10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrStatus}" Margin="0 10 10 5"
                           VerticalAlignment="Center"/>
                <!-- Only the transitions the server allows from the finding's current state. -->
                <ComboBox TabIndex="1" Grid.Row="2" Grid.Column="1" MinWidth="260"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding AllowedStatuses}"
                          SelectedItem="{Binding SelectedStatus}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding StrCanonicalFinding}"
                           Margin="0 10 10 5" VerticalAlignment="Center"
                           IsVisible="{Binding DuplicateRequired}"/>
                <TextBox TabIndex="2" Grid.Row="3" Grid.Column="1" MinWidth="120"
                         HorizontalAlignment="Left"
                         Text="{Binding DuplicateOfId}"
                         IsVisible="{Binding DuplicateRequired}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrJustification}"
                           Margin="0 10 10 5" VerticalAlignment="Top"
                           IsVisible="{Binding JustificationRequired}"/>
                <!-- Mandatory for the suppressing states: an unexplained suppression is
                     indistinguishable from a mistake when an auditor reads the timeline. -->
                <TextBox TabIndex="3" Grid.Row="4" Grid.Column="1" MinWidth="260" MinHeight="80"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Justification}"
                         IsVisible="{Binding JustificationRequired}"/>

                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Center">
                        <Button TabIndex="4" Classes="dialog1" Margin="10"
                                IsEnabled="{Binding SaveEnabled}"
                                Command="{Binding BtSaveClicked}">
                                <StackPanel Orientation="Horizontal">
                                        <avalonia:MaterialIcon Kind="ContentSave" Margin="10 0"/>
                                        <TextBlock Text="{Binding StrSave, Mode=OneTime}" Margin="0 0 10 0"/>
                                </StackPanel>
                        </Button>
                        <Button TabIndex="5" Classes="dialog2" Margin="10"
                                Command="{Binding BtCancelClicked}">
                                <StackPanel Orientation="Horizontal">
                                        <avalonia:MaterialIcon Kind="Cancel" Margin="10 0"/>
                                        <TextBlock Text="{Binding StrCancel, Mode=OneTime}" Margin="0 0 10 0"/>
                                </StackPanel>
                        </Button>
                </StackPanel>
        </Grid>
</Window>
