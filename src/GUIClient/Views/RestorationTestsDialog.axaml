<dialogs:DialogWindowBase x:TypeArguments="results:ContinuityDialogResult"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:viewModels="clr-namespace:GUIClient.ViewModels"
        xmlns:dialogs="clr-namespace:GUIClient.ViewModels.Dialogs"
        xmlns:results="clr-namespace:GUIClient.ViewModels.Dialogs.Results"
        xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
        x:DataType="viewModels:RestorationTestsDialogViewModel"
        x:Class="GUIClient.Views.RestorationTestsDialog"
        Title="{Binding StrTitle}"
        Width="900" SizeToContent="Height"
        MinWidth="760"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <viewModels:RestorationTestsDialogViewModel/>
    </Design.DataContext>

    <!-- Stage 9.3 (S43 §7): restoration tests are evidence. They are recorded and, when mistaken,
         voided with a reason; nothing here edits or deletes one. -->
    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*" Margin="10">
            <TextBlock Grid.Row="0" Classes="header" Text="{Binding StrTitle}"/>
            <TextBlock Grid.Row="1" Classes="header_detail" Text="{Binding EntityName}" TextWrapping="Wrap"/>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0 10 0 0">
                <Button Grid.Column="1" Classes="operation"
                        Command="{Binding BtVoidTestClicked}"
                        IsEnabled="{Binding IsVoidEnabled}"
                        ToolTip.Tip="{Binding StrVoidTest}">
                    <material:MaterialIcon Kind="Cancel"/>
                </Button>
            </Grid>

            <DataGrid Grid.Row="3" Margin="0 5 0 0" MinHeight="160" MaxHeight="300"
                      ItemsSource="{Binding Tests}"
                      SelectedItem="{Binding SelectedTest, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding StrTestedAt, Mode=OneTime}"
                                        Binding="{Binding TestedAt, StringFormat={}{0:g}}" Width="*" MinWidth="130"/>
                    <DataGridTextColumn Header="{Binding StrOutcome, Mode=OneTime}"
                                        Binding="{Binding OutcomeText}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="{Binding StrAchievedRto, Mode=OneTime}"
                                        Binding="{Binding AchievedRtoText}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="{Binding StrAchievedRpo, Mode=OneTime}"
                                        Binding="{Binding AchievedRpoText}" Width="*" MinWidth="90"/>
                    <DataGridTextColumn Header="{Binding StrDeclaredAtRecord, Mode=OneTime}"
                                        Binding="{Binding DeclaredText}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="{Binding StrEvidenceReference, Mode=OneTime}"
                                        Binding="{Binding Evidence}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="{Binding StrRecordedBy, Mode=OneTime}"
                                        Binding="{Binding RecordedBy}" Width="Auto"/>
                    <DataGridTextColumn Header="{Binding StrVoided, Mode=OneTime}"
                                        Binding="{Binding VoidedText}" Width="2*" MinWidth="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Record a test: only for restoration_test_record with global scope. -->
            <Grid Grid.Row="4" IsVisible="{Binding CanRecordTests}" Margin="0 10 0 0"
                  ColumnDefinitions="Auto,*,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Classes="header2" Text="{Binding StrRecordTest}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="form_label" Text="{Binding StrTestedAt}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <DatePicker Margin="5" SelectedDate="{Binding TestedOn}"/>
                    <TimePicker Margin="5" SelectedTime="{Binding TestedTime}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="form_label" Text="{Binding StrOutcome}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="3" MinWidth="140" Margin="5" ItemsSource="{Binding Outcomes}"
                          SelectedItem="{Binding Outcome, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:RestorationOutcomeOption">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="form_label" Text="{Binding StrAchievedRto}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <NumericUpDown Margin="5" MinWidth="120" Minimum="0" Increment="1" FormatString="0" Value="{Binding AchievedRto}"/>
                    <ComboBox Margin="5" MinWidth="100" ItemsSource="{Binding Units}" SelectedItem="{Binding AchievedRtoUnit, Mode=TwoWay}"
                              ToolTip.Tip="{Binding StrDurationUnit}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DurationUnitOption">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="2" Classes="form_label" Text="{Binding StrAchievedRpo}" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                    <NumericUpDown Margin="5" MinWidth="120" Minimum="0" Increment="1" FormatString="0" Value="{Binding AchievedRpo}"/>
                    <ComboBox Margin="5" MinWidth="100" ItemsSource="{Binding Units}" SelectedItem="{Binding AchievedRpoUnit, Mode=TwoWay}"
                              ToolTip.Tip="{Binding StrDurationUnit}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:DurationUnitOption">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="form_label" Text="{Binding StrEvidenceReference}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="5" MaxLength="500" Text="{Binding Evidence}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Classes="form_label" Text="{Binding StrNotes}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="3" Margin="5" MaxLength="4000" Text="{Binding Notes}"/>
                <Button Grid.Row="3" Grid.Column="4" Classes="subButton" VerticalAlignment="Center"
                        Command="{Binding BtRecordTestClicked}"
                        IsEnabled="{Binding IsRecordEnabled}"
                        ToolTip.Tip="{Binding StrRecordTest}">
                    <material:MaterialIcon Classes="subButton" Kind="Plus"/>
                </Button>

                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Classes="hint" TextWrapping="Wrap"
                           Text="{Binding ErrorText}" IsVisible="{Binding HasError}"/>
            </Grid>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10 10 0 0">
                <Button Classes="dialog2" Command="{Binding BtCloseClicked}">
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="Close" Width="20" Height="20" Margin="0 0 5 0"/>
                        <TextBlock Text="{Binding StrClose}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <progRing:ProgressRing Width="80" Height="80"
                               IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               ZIndex="1000"/>
    </Panel>
</dialogs:DialogWindowBase>
