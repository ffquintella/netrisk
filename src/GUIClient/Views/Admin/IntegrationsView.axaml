<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:GUIClient.ViewModels.Admin"
             xmlns:entities="clr-namespace:DAL.Entities;assembly=DAL"
             xmlns:integrations="clr-namespace:Model.Integrations;assembly=Model"
             xmlns:scim="clr-namespace:Model.Authentication.Scim;assembly=Model"
             xmlns:federation="clr-namespace:Model.Authentication.Federation;assembly=Model"
             xmlns:enums="clr-namespace:DAL.Enums;assembly=DAL"
             xmlns:admin="clr-namespace:GUIClient.Views.Admin"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:DataType="vm:IntegrationsViewModel"
             x:Class="GUIClient.Views.Admin.IntegrationsView"
             Name="IntegrationsUc">

    <Design.DataContext>
        <vm:IntegrationsViewModel/>
    </Design.DataContext>

    <TabControl>
        <!-- 4.1.2 — notification channels. Every credential box starts blank; blank means "keep the
             stored value", which is what lets the form round-trip without the client ever holding a
             token it read back from the server. -->
        <TabItem Header="{Binding StrNotificationChannels}">
            <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*" Margin="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Classes="subButton" Command="{Binding BtReloadClicked}"
                            ToolTip.Tip="{Binding StrReload}">
                        <material:MaterialIcon Kind="Refresh"/>
                    </Button>
                    <Button Classes="subButton" Margin="10 0 0 0" Command="{Binding BtNewChannelClicked}"
                            ToolTip.Tip="{Binding StrAdd}">
                        <material:MaterialIcon Kind="Plus"/>
                    </Button>
                    <TextBlock Text="{Binding StrSecretsWriteOnly}" Classes="hint"
                               MaxWidth="620" Margin="15 0 0 0" VerticalAlignment="Center"/>
                </StackPanel>

                <DataGrid Grid.Row="1" Grid.Column="0" Margin="0 10 10 0" IsReadOnly="True"
                          ItemsSource="{Binding Channels}"
                          SelectedItem="{Binding SelectedChannel}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="{Binding StrChannelKind}" Binding="{Binding Kind}"/>
                        <DataGridCheckBoxColumn Header="{Binding StrEnabled}" Binding="{Binding Enabled}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0 10 0 0">
                    <StackPanel Width="460" HorizontalAlignment="Left">

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionGeneral}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrName}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding ChannelName}"/>

                                <TextBlock Text="{Binding StrChannelKind}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <ComboBox ItemsSource="{Binding ChannelProviders}"
                                          SelectedValue="{Binding ChannelKind}"
                                          SelectedValueBinding="{Binding Kind}"
                                          DisplayMemberBinding="{Binding Name}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionConnection}" Classes="sectionCaption"/>
                                <TextBlock Text="{Binding StrWebhookUrl}" Classes="fieldLabel"/>
                                <!-- Grid, not a horizontal StackPanel: inside a formCard a TextBox stretches, and a
                                     horizontal StackPanel would measure that stretch as infinite width. -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ChannelWebhookUrl}" PasswordChar="&#x2022;"
                                             IsEnabled="{Binding ChannelWebhookUrlVault.AcceptsTypedValue}"/>
                                    <!-- The picker and its counterpart appear only when this installation has a usable vault.
                                         Bound to the field's own state object rather than to a view-model mirror of it, so the
                                         three-way typed/picked/bound decision lives in one testable place. -->
                                    <Button Grid.Column="1" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding ChannelWebhookUrlVault.ShowPicker}"
                                            Command="{Binding BtPickVaultSecretClicked}"
                                            CommandParameter="channel-webhookurl"
                                            ToolTip.Tip="{Binding StrUseVaultSecret}">
                                        <material:MaterialIcon Kind="KeyChain"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding ChannelWebhookUrlVault.ShowDetach}"
                                            Command="{Binding BtDetachVaultSecretClicked}"
                                            CommandParameter="channel-webhookurl"
                                            ToolTip.Tip="{Binding StrStopUsingVault}">
                                        <material:MaterialIcon Kind="KeyRemove"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0"
                                      IsVisible="{Binding ChannelWebhookUrlVault.HasDisplayText}">
                                    <material:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline" Width="14" Height="14"
                                                           VerticalAlignment="Top" Margin="0 1 4 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ChannelWebhookUrlVault.DisplayText}" Classes="hint" Margin="0"/>
                                        <!-- A picked secret is not committed until Save. -->
                                        <TextBlock Text="{Binding StrWillBeSaved}" Classes="notice" Margin="0 2 0 0"
                                                   IsVisible="{Binding ChannelWebhookUrlVault.HasPendingChange}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding StrSigningSecret}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <!-- Grid, not a horizontal StackPanel: inside a formCard a TextBox stretches, and a
                                     horizontal StackPanel would measure that stretch as infinite width. -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ChannelSigningSecret}" PasswordChar="&#x2022;"
                                             IsEnabled="{Binding ChannelSigningSecretVault.AcceptsTypedValue}"/>
                                    <!-- The picker and its counterpart appear only when this installation has a usable vault.
                                         Bound to the field's own state object rather than to a view-model mirror of it, so the
                                         three-way typed/picked/bound decision lives in one testable place. -->
                                    <Button Grid.Column="1" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding ChannelSigningSecretVault.ShowPicker}"
                                            Command="{Binding BtPickVaultSecretClicked}"
                                            CommandParameter="channel-signingsecret"
                                            ToolTip.Tip="{Binding StrUseVaultSecret}">
                                        <material:MaterialIcon Kind="KeyChain"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding ChannelSigningSecretVault.ShowDetach}"
                                            Command="{Binding BtDetachVaultSecretClicked}"
                                            CommandParameter="channel-signingsecret"
                                            ToolTip.Tip="{Binding StrStopUsingVault}">
                                        <material:MaterialIcon Kind="KeyRemove"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0"
                                      IsVisible="{Binding ChannelSigningSecretVault.HasDisplayText}">
                                    <material:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline" Width="14" Height="14"
                                                           VerticalAlignment="Top" Margin="0 1 4 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ChannelSigningSecretVault.DisplayText}" Classes="hint" Margin="0"/>
                                        <!-- A picked secret is not committed until Save. -->
                                        <TextBlock Text="{Binding StrWillBeSaved}" Classes="notice" Margin="0 2 0 0"
                                                   IsVisible="{Binding ChannelSigningSecretVault.HasPendingChange}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionBehaviour}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrRecipients}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding ChannelRecipients}"/>

                                <TextBlock Text="{Binding StrSubjectPrefix}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding ChannelSubjectPrefix}"/>

                                <TextBlock Text="{Binding StrFallbackChannel}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <ComboBox ItemsSource="{Binding Channels}"
                                          SelectedValue="{Binding ChannelFallbackId}"
                                          SelectedValueBinding="{Binding Id}"
                                          DisplayMemberBinding="{Binding Name}"/>

                                <CheckBox IsChecked="{Binding ChannelEnabled}" Margin="0 12 0 0">
                                    <TextBlock Text="{Binding StrEnabled}"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            Margin="0 10 0 0">
                    <Button Classes="dialog1" Command="{Binding BtSaveChannelClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="ContentSave"/>
                            <TextBlock Text="{Binding StrSave}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0" Command="{Binding BtTestChannelClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Send"/>
                            <TextBlock Text="{Binding StrSendTestMessage}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0" Command="{Binding BtDeleteChannelClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Delete"/>
                            <TextBlock Text="{Binding StrDelete}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- 4.1.3 — the events × channels matrix and the delivery log. The log is the half operators
             actually ask for: "the SLA breach fired, did the team hear about it?" cannot be answered
             from the absence of a Slack message. -->
        <TabItem Header="{Binding StrSubscriptions}">
            <Grid RowDefinitions="Auto,*,Auto,*" Margin="10">
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <StackPanel Margin="0 0 10 0">
                        <TextBlock Text="{Binding StrEvent}" Classes="fieldLabel"/>
                        <ComboBox MinWidth="220" ItemsSource="{Binding NotificationEvents}"
                                  SelectedValue="{Binding SubscriptionEvent}"
                                  SelectedValueBinding="{Binding EventType}"
                                  DisplayMemberBinding="{Binding Name}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 10 0">
                        <TextBlock Text="{Binding StrNotificationChannels}" Classes="fieldLabel"/>
                        <ComboBox MinWidth="200" ItemsSource="{Binding Channels}"
                                  SelectedValue="{Binding SubscriptionChannelId}"
                                  SelectedValueBinding="{Binding Id}"
                                  DisplayMemberBinding="{Binding Name}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 10 0">
                        <TextBlock Text="{Binding StrMinSeverity}" Classes="fieldLabel"/>
                        <NumericUpDown Value="{Binding SubscriptionMinSeverity}" Minimum="1" Maximum="4"
                                       MinWidth="110"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 10 0">
                        <TextBlock Text="{Binding StrDigestWindow}" Classes="fieldLabel"/>
                        <NumericUpDown Value="{Binding SubscriptionDigestMinutes}" Minimum="0"
                                       Maximum="1440" MinWidth="130"/>
                    </StackPanel>
                    <Button Classes="dialog1" VerticalAlignment="Bottom"
                            Command="{Binding BtAddSubscriptionClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Plus"/>
                            <TextBlock Text="{Binding StrAdd}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <DataGrid Grid.Row="1" Margin="0 10 0 0" IsReadOnly="True" MinHeight="140"
                          ItemsSource="{Binding Subscriptions}"
                          SelectedItem="{Binding SelectedSubscription}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding StrEvent}" Binding="{Binding EventType}"/>
                        <DataGridTextColumn Header="{Binding StrNotificationChannels}"
                                            Binding="{Binding ChannelId}"/>
                        <DataGridTextColumn Header="{Binding StrMinSeverity}" Binding="{Binding MinSeverity}"/>
                        <DataGridTextColumn Header="{Binding StrDigestWindow}"
                                            Binding="{Binding DigestWindowMinutes}"/>
                        <DataGridCheckBoxColumn Header="{Binding StrEnabled}" Binding="{Binding Enabled}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0">
                    <Button Classes="dialog2" Command="{Binding BtDeleteSubscriptionClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Delete"/>
                            <TextBlock Text="{Binding StrDelete}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0"
                            Command="{Binding BtRequeueDeliveryClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Restart"/>
                            <TextBlock Text="{Binding StrRequeue}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding StrDeliveryLog}" Classes="header2" Margin="20 0 0 0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <DataGrid Grid.Row="3" Margin="0 10 0 0" IsReadOnly="True"
                          ItemsSource="{Binding Deliveries}"
                          SelectedItem="{Binding SelectedDelivery}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding StrEvent}" Binding="{Binding EventType}"/>
                        <DataGridTextColumn Header="{Binding StrTitle}" Binding="{Binding Title}"/>
                        <DataGridTextColumn Header="{Binding StrStatus}" Binding="{Binding Status}"/>
                        <DataGridTextColumn Header="{Binding StrAttempts}" Binding="{Binding Attempts}"/>
                        <DataGridTextColumn Header="{Binding StrLastError}" Binding="{Binding LastError}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <!-- 4.2 — issue-tracker connections, the per-connection status mapping, and the conflict
             review queue. Last-writer-wins was already applied when a conflict was recorded; this is
             where a human sees that it happened. -->
        <TabItem Header="{Binding StrIssueTrackers}">
            <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="*,*" Margin="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Classes="subButton" Command="{Binding BtReloadClicked}"
                            ToolTip.Tip="{Binding StrReload}">
                        <material:MaterialIcon Kind="Refresh"/>
                    </Button>
                    <Button Classes="subButton" Margin="10 0 0 0"
                            Command="{Binding BtNewIssueTrackerClicked}" ToolTip.Tip="{Binding StrAdd}">
                        <material:MaterialIcon Kind="Plus"/>
                    </Button>
                </StackPanel>

                <DataGrid Grid.Row="1" Grid.Column="0" Margin="0 10 10 0" IsReadOnly="True"
                          ItemsSource="{Binding IssueTrackers}"
                          SelectedItem="{Binding SelectedIssueTracker}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="{Binding StrProvider}" Binding="{Binding Provider}"/>
                        <DataGridTextColumn Header="{Binding StrProjectKey}" Binding="{Binding ProjectKey}"/>
                        <DataGridCheckBoxColumn Header="{Binding StrEnabled}" Binding="{Binding Enabled}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0 10 0 0">
                    <StackPanel Width="460" HorizontalAlignment="Left">

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionConnection}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrName}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding IssueTrackerDraft.Name}"/>

                                <TextBlock Text="{Binding StrProvider}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <ComboBox ItemsSource="{Binding IssueTrackerProviders}"
                                          SelectedValue="{Binding SelectedIssueTrackerProvider}"
                                          SelectedValueBinding="{Binding Provider}"
                                          DisplayMemberBinding="{Binding Name}"/>

                                <TextBlock Text="{Binding StrBaseUrl}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IssueTrackerDraft.BaseUrl}"/>

                                <TextBlock Text="{Binding StrProjectKey}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IssueTrackerDraft.ProjectKey}"/>

                                <TextBlock Text="{Binding StrIssueType}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IssueTrackerDraft.IssueType}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionAuthentication}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrAuthUser}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding IssueTrackerDraft.AuthUser}"/>

                                <TextBlock Text="{Binding StrApiToken}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <!-- Grid, not a horizontal StackPanel: inside a formCard a TextBox stretches, and a
                                     horizontal StackPanel would measure that stretch as infinite width. -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding IssueTrackerToken}" PasswordChar="&#x2022;"
                                             IsEnabled="{Binding IssueTrackerTokenVault.AcceptsTypedValue}"/>
                                    <!-- The picker and its counterpart appear only when this installation has a usable vault.
                                         Bound to the field's own state object rather than to a view-model mirror of it, so the
                                         three-way typed/picked/bound decision lives in one testable place. -->
                                    <Button Grid.Column="1" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding IssueTrackerTokenVault.ShowPicker}"
                                            Command="{Binding BtPickVaultSecretClicked}"
                                            CommandParameter="issuetracker-token"
                                            ToolTip.Tip="{Binding StrUseVaultSecret}">
                                        <material:MaterialIcon Kind="KeyChain"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding IssueTrackerTokenVault.ShowDetach}"
                                            Command="{Binding BtDetachVaultSecretClicked}"
                                            CommandParameter="issuetracker-token"
                                            ToolTip.Tip="{Binding StrStopUsingVault}">
                                        <material:MaterialIcon Kind="KeyRemove"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0"
                                      IsVisible="{Binding IssueTrackerTokenVault.HasDisplayText}">
                                    <material:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline" Width="14" Height="14"
                                                           VerticalAlignment="Top" Margin="0 1 4 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding IssueTrackerTokenVault.DisplayText}" Classes="hint" Margin="0"/>
                                        <!-- A picked secret is not committed until Save. -->
                                        <TextBlock Text="{Binding StrWillBeSaved}" Classes="notice" Margin="0 2 0 0"
                                                   IsVisible="{Binding IssueTrackerTokenVault.HasPendingChange}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding StrWebhookSecret}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <!-- Grid, not a horizontal StackPanel: inside a formCard a TextBox stretches, and a
                                     horizontal StackPanel would measure that stretch as infinite width. -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding IssueTrackerWebhookSecret}" PasswordChar="&#x2022;"
                                             IsEnabled="{Binding IssueTrackerWebhookSecretVault.AcceptsTypedValue}"/>
                                    <!-- The picker and its counterpart appear only when this installation has a usable vault.
                                         Bound to the field's own state object rather than to a view-model mirror of it, so the
                                         three-way typed/picked/bound decision lives in one testable place. -->
                                    <Button Grid.Column="1" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding IssueTrackerWebhookSecretVault.ShowPicker}"
                                            Command="{Binding BtPickVaultSecretClicked}"
                                            CommandParameter="issuetracker-webhooksecret"
                                            ToolTip.Tip="{Binding StrUseVaultSecret}">
                                        <material:MaterialIcon Kind="KeyChain"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding IssueTrackerWebhookSecretVault.ShowDetach}"
                                            Command="{Binding BtDetachVaultSecretClicked}"
                                            CommandParameter="issuetracker-webhooksecret"
                                            ToolTip.Tip="{Binding StrStopUsingVault}">
                                        <material:MaterialIcon Kind="KeyRemove"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0"
                                      IsVisible="{Binding IssueTrackerWebhookSecretVault.HasDisplayText}">
                                    <material:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline" Width="14" Height="14"
                                                           VerticalAlignment="Top" Margin="0 1 4 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding IssueTrackerWebhookSecretVault.DisplayText}" Classes="hint" Margin="0"/>
                                        <!-- A picked secret is not committed until Save. -->
                                        <TextBlock Text="{Binding StrWillBeSaved}" Classes="notice" Margin="0 2 0 0"
                                                   IsVisible="{Binding IssueTrackerWebhookSecretVault.HasPendingChange}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionTemplates}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrDefaultLabels}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding IssueTrackerDraft.DefaultLabels}"/>

                                <!-- The three field-mapping settings that 4.2.1 stored on the connection and
                                     never gave an editor. Leaving a template empty keeps the built-in
                                     default, which is why the watermarks show what that default is. -->
                                <TextBlock Text="{Binding StrTitleTemplate}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IssueTrackerDraft.TitleTemplate}"
                                         PlaceholderText="[{{Severity}}] {{Title}}"/>

                                <TextBlock Text="{Binding StrDescriptionTemplate}" Classes="fieldLabel"
                                           Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IssueTrackerDraft.DescriptionTemplate}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                                         MaxHeight="220"/>
                                <TextBlock Text="{Binding StrPlaceholderHelp}" Classes="hint"/>

                                <TextBlock Text="{Binding StrPriorityMapping}" Classes="fieldLabel"
                                           Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IssueTrackerDraft.PriorityMappingJson}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                         PlaceholderText="{}{&quot;4&quot;:&quot;Highest&quot;,&quot;3&quot;:&quot;High&quot;}"/>
                            </StackPanel>
                        </Border>

                        <!-- The rendered preview. IIssueTrackerService.PreviewAsync has existed since
                             4.2.1 with no UI on it, which left the templates editable and
                             unverifiable: the only way to see what a placeholder produced was to file
                             a ticket in somebody else's project. Rendering against a real finding is
                             what makes them editable with confidence. -->
                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrPreview}" Classes="sectionCaption"/>
                                <TextBlock Text="{Binding StrPreviewHelp}" Classes="hint" Margin="0 0 0 8"/>

                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding StrPreviewFinding}"
                                               VerticalAlignment="Center" Margin="0 0 8 0"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding PreviewFindingId}"
                                                   Minimum="0" FormatString="0" MinWidth="130"
                                                   HorizontalAlignment="Left"/>
                                    <Button Grid.Column="2" Classes="dialog2" Margin="8 0 0 0"
                                            Command="{Binding BtPreviewTemplateClicked}">
                                        <StackPanel Orientation="Horizontal">
                                            <material:MaterialIcon Kind="Eye"/>
                                            <TextBlock Text="{Binding StrPreview}" Margin="5 0 0 0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel IsVisible="{Binding HasPreview}" Margin="0 12 0 0">
                                    <TextBlock Text="{Binding StrRenderedTitle}" Classes="fieldLabel"/>
                                    <TextBox Text="{Binding PreviewTitle}" IsReadOnly="True"
                                             TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding StrPriority}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                    <TextBox Text="{Binding PreviewPriority}" IsReadOnly="True"/>

                                    <TextBlock Text="{Binding StrRenderedBody}" Classes="fieldLabel"
                                               Margin="0 12 0 3"/>
                                    <!-- The body as it will be sent: Markdown for GitHub and GitLab, converted
                                         to ADF by the Jira provider on the way out. Shown as source rather
                                         than rendered, because what an operator has to check is the
                                         substitution, not how a tracker will style it. -->
                                    <TextBox Text="{Binding PreviewBody}" IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"
                                             MaxHeight="320"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionBehaviour}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrAutoCreateMinSeverity}" Classes="fieldLabel"/>
                                <NumericUpDown Value="{Binding IssueTrackerDraft.AutoCreateMinSeverity}"
                                               Minimum="1" Maximum="4" MinWidth="130"
                                               HorizontalAlignment="Left"/>

                                <TextBlock Text="{Binding StrPollInterval}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <NumericUpDown Value="{Binding IssueTrackerDraft.PollIntervalMinutes}"
                                               Minimum="1" Maximum="1440" MinWidth="130"
                                               HorizontalAlignment="Left"/>

                                <CheckBox IsChecked="{Binding IssueTrackerDraft.PushFindingUpdates}"
                                          Margin="0 12 0 0">
                                    <TextBlock Text="{Binding StrPushFindingUpdates}" TextWrapping="Wrap"/>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IssueTrackerDraft.Enabled}">
                                    <TextBlock Text="{Binding StrEnabled}"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            Margin="0 10 0 0">
                    <Button Classes="dialog1" Command="{Binding BtSaveIssueTrackerClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="ContentSave"/>
                            <TextBlock Text="{Binding StrSave}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0"
                            Command="{Binding BtTestIssueTrackerClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="LanConnect"/>
                            <TextBlock Text="{Binding StrTestConnection}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0"
                            Command="{Binding BtSyncIssueTrackerClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Sync"/>
                            <TextBlock Text="{Binding StrSyncNow}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0"
                            Command="{Binding BtDeleteIssueTrackerClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Delete"/>
                            <TextBlock Text="{Binding StrDelete}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0"
                            Command="{Binding BtResolveConflictClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="CheckDecagram"/>
                            <TextBlock Text="{Binding StrResolveConflict}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*"
                      Margin="0 10 0 0">
                    <!-- Editable since 4.6. This grid shipped as IsReadOnly with no way to add a
                         row, so the mapping the whole bi-directional sync depends on could be read
                         and never changed — the server has had a wholesale PUT for it since 4.2.1
                         and nothing called it. Saved wholesale, because a partial save leaves a
                         half-configured mapping applying to live findings. -->
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StrStatusMappings}" Classes="header2"
                                       VerticalAlignment="Center"/>
                            <Button Classes="subButton" Margin="10 0 0 0"
                                    Command="{Binding BtAddStatusMappingClicked}"
                                    ToolTip.Tip="{Binding StrAdd}">
                                <material:MaterialIcon Kind="Plus"/>
                            </Button>
                            <Button Classes="subButton" Margin="5 0 0 0"
                                    Command="{Binding BtRemoveStatusMappingClicked}"
                                    ToolTip.Tip="{Binding StrDelete}">
                                <material:MaterialIcon Kind="Minus"/>
                            </Button>
                            <Button Classes="subButton" Margin="5 0 0 0"
                                    Command="{Binding BtLoadStatusesFromJiraClicked}"
                                    ToolTip.Tip="{Binding StrLoadFromJira}">
                                <material:MaterialIcon Kind="CloudDownload"/>
                            </Button>
                            <Button Classes="subButton" Margin="5 0 0 0"
                                    Command="{Binding BtSaveStatusMappingsClicked}"
                                    ToolTip.Tip="{Binding StrSaveMappings}">
                                <material:MaterialIcon Kind="ContentSave"/>
                            </Button>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding StatusMappings}"
                                  SelectedItem="{Binding SelectedStatusMapping}"
                                  CanUserSortColumns="False" MinHeight="120">
                            <DataGrid.Columns>
                                <!-- Free text with a picker behind it: the statuses load from Jira
                                     where there is an endpoint to read them, and GitHub, GitLab and
                                     Azure DevOps have no such list to offer. -->
                                <DataGridTemplateColumn Header="{Binding StrExternalStatus}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="entities:IssueStatusMapping">
                                            <TextBlock Text="{Binding ExternalStatus}" Margin="5 0"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate x:DataType="entities:IssueStatusMapping">
                                            <AutoCompleteBox Text="{Binding ExternalStatus}"
                                                             FilterMode="Contains"
                                                             ItemsSource="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).ExternalStatusOptions}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{Binding StrAction}" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="entities:IssueStatusMapping">
                                            <TextBlock Text="{Binding Action}" Margin="5 0"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate x:DataType="entities:IssueStatusMapping">
                                            <ComboBox SelectedItem="{Binding Action}"
                                                      ItemsSource="{Binding $parent[UserControl].((vm:IntegrationsViewModel)DataContext).SyncActions}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{Binding StrOutboundTransition}"
                                                    Binding="{Binding OutboundTransition}"
                                                    Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StrSyncConflicts}" Classes="header2"/>
                        <DataGrid ItemsSource="{Binding SyncConflicts}"
                                  SelectedItem="{Binding SelectedConflict}"
                                  IsReadOnly="True" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding StrName}"
                                                    Binding="{Binding ConnectionName}"/>
                                <DataGridTextColumn Header="{Binding StrTitle}" Binding="{Binding IssueKey}"/>
                                <DataGridTextColumn Header="{Binding StrStatus}"
                                                    Binding="{Binding LastSyncedStatus}"/>
                                <DataGridTextColumn Header="{Binding StrLastError}"
                                                    Binding="{Binding ConflictDetail}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- 4.6 — the Jira Service Management and Assets tabs. A tab of its own rather than more
             rows in the connection form: it is four editors, and it applies to one provider. The
             view hides itself for the other three. -->
        <TabItem Header="{Binding Jira.StrAssets}">
            <admin:JiraIntegrationView DataContext="{Binding Jira}"/>
        </TabItem>

        <!-- 4.3 — identity providers and SCIM provisioning. The issued provisioning token appears once,
             beside the warning, because the server stores only a hash. -->
        <TabItem Header="{Binding StrIdentityProviders}">
            <Grid RowDefinitions="Auto,*,Auto,Auto" ColumnDefinitions="*,*" Margin="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Classes="subButton" Command="{Binding BtReloadClicked}"
                            ToolTip.Tip="{Binding StrReload}">
                        <material:MaterialIcon Kind="Refresh"/>
                    </Button>
                    <Button Classes="subButton" Margin="10 0 0 0"
                            Command="{Binding BtNewIdentityProviderClicked}"
                            ToolTip.Tip="{Binding StrAdd}">
                        <material:MaterialIcon Kind="Plus"/>
                    </Button>
                </StackPanel>

                <DataGrid Grid.Row="1" Grid.Column="0" Margin="0 10 10 0" IsReadOnly="True"
                          ItemsSource="{Binding IdentityProviders}"
                          SelectedItem="{Binding SelectedIdentityProvider}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="{Binding StrProtocol}" Binding="{Binding Protocol}"/>
                        <DataGridCheckBoxColumn Header="{Binding StrEnabled}" Binding="{Binding Enabled}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0 10 0 0">
                    <StackPanel Width="460" HorizontalAlignment="Left">

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionConnection}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrName}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding IdentityProviderDraft.Name}"/>

                                <TextBlock Text="{Binding StrAuthority}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IdentityProviderDraft.Authority}"/>

                                <TextBlock Text="{Binding StrMetadataUrl}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IdentityProviderDraft.MetadataUrl}"/>

                                <TextBlock Text="{Binding StrMetadataXml}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IdentityProviderDraft.MetadataXml}"
                                         AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionAuthentication}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrClientId}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding IdentityProviderDraft.ClientId}"/>

                                <TextBlock Text="{Binding StrClientSecret}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <!-- Grid, not a horizontal StackPanel: inside a formCard a TextBox stretches, and a
                                     horizontal StackPanel would measure that stretch as infinite width. -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding IdentityProviderClientSecret}"
                                             PasswordChar="&#x2022;"
                                             IsEnabled="{Binding IdentityProviderClientSecretVault.AcceptsTypedValue}"/>
                                    <!-- The picker and its counterpart appear only when this installation has a usable vault.
                                         Bound to the field's own state object rather than to a view-model mirror of it, so the
                                         three-way typed/picked/bound decision lives in one testable place. -->
                                    <Button Grid.Column="1" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding IdentityProviderClientSecretVault.ShowPicker}"
                                            Command="{Binding BtPickVaultSecretClicked}"
                                            CommandParameter="idp-clientsecret"
                                            ToolTip.Tip="{Binding StrUseVaultSecret}">
                                        <material:MaterialIcon Kind="KeyChain"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding IdentityProviderClientSecretVault.ShowDetach}"
                                            Command="{Binding BtDetachVaultSecretClicked}"
                                            CommandParameter="idp-clientsecret"
                                            ToolTip.Tip="{Binding StrStopUsingVault}">
                                        <material:MaterialIcon Kind="KeyRemove"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0"
                                      IsVisible="{Binding IdentityProviderClientSecretVault.HasDisplayText}">
                                    <material:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline"
                                                           Width="14" Height="14"
                                                           VerticalAlignment="Top" Margin="0 1 4 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding IdentityProviderClientSecretVault.DisplayText}"
                                                   Classes="hint" Margin="0"/>
                                        <!-- A picked secret is not committed until Save, and an operator who misses
                                             that ships a provider that still resolves the old value. -->
                                        <TextBlock Text="{Binding StrWillBeSaved}" Classes="notice" Margin="0 2 0 0"
                                                   IsVisible="{Binding IdentityProviderClientSecretVault.HasPendingChange}"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox IsChecked="{Binding IdentityProviderDraft.RequireSignedAssertions}"
                                          Margin="0 12 0 0">
                                    <TextBlock Text="{Binding StrRequireSignedAssertions}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionMapping}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrClaimMapping}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding IdentityProviderDraft.ClaimMappingJson}"/>

                                <TextBlock Text="{Binding StrGroupMapping}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding IdentityProviderDraft.GroupMappingJson}"/>

                                <CheckBox IsChecked="{Binding IdentityProviderDraft.JitProvisioning}"
                                          Margin="0 12 0 0">
                                    <TextBlock Text="{Binding StrJitProvisioning}" TextWrapping="Wrap"/>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding IdentityProviderDraft.Enabled}">
                                    <TextBlock Text="{Binding StrEnabled}"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                            Margin="0 10 0 0">
                    <Button Classes="dialog1" Command="{Binding BtSaveIdentityProviderClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="ContentSave"/>
                            <TextBlock Text="{Binding StrSave}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0"
                            Command="{Binding BtTestIdentityProviderClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="LanConnect"/>
                            <TextBlock Text="{Binding StrTestConnection}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="dialog2" Margin="10 0 0 0"
                            Command="{Binding BtDeleteIdentityProviderClicked}">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="Delete"/>
                            <TextBlock Text="{Binding StrDelete}" Margin="5 0 0 0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*"
                      Margin="0 10 0 0">
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="{Binding StrScimTokens}" Classes="fieldLabel"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ScimTokenName}" MinWidth="180"/>
                            <Button Classes="dialog1" Margin="10 0 0 0"
                                    Command="{Binding BtIssueScimTokenClicked}">
                                <StackPanel Orientation="Horizontal">
                                    <material:MaterialIcon Kind="KeyPlus"/>
                                    <TextBlock Text="{Binding StrIssueScimToken}" Margin="5 0 0 0"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="dialog2" Margin="10 0 0 0"
                                    Command="{Binding BtRevokeScimTokenClicked}">
                                <material:MaterialIcon Kind="KeyRemove"/>
                            </Button>
                        </StackPanel>
                        <!-- notice, not hint: the token is displayed exactly once, so missing this
                             line costs the operator the token. -->
                        <TextBlock Text="{Binding StrSecretShownOnce}" Classes="notice"
                                   IsVisible="{Binding HasIssuedSecret}"/>
                        <SelectableTextBlock Text="{Binding IssuedSecret}" FontFamily="monospace"
                                             TextWrapping="Wrap"
                                             IsVisible="{Binding HasIssuedSecret}"/>
                        <DataGrid ItemsSource="{Binding ScimTokens}"
                                  SelectedItem="{Binding SelectedScimToken}"
                                  IsReadOnly="True" MinHeight="110">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="{Binding StrLastUsed}"
                                                    Binding="{Binding LastUsedAt}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StrScimRequestLog}" Classes="header2"/>
                        <DataGrid ItemsSource="{Binding ScimLog}" IsReadOnly="True" MinHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding StrAction}" Binding="{Binding Method}"/>
                                <DataGridTextColumn Header="{Binding StrTitle}" Binding="{Binding Path}"/>
                                <DataGridTextColumn Header="{Binding StrStatus}"
                                                    Binding="{Binding StatusCode}"/>
                                <DataGridTextColumn Header="{Binding StrDescription}"
                                                    Binding="{Binding Outcome}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- 4.4 / 4.5 — the two posture providers and their shared synchronization log. -->
        <TabItem Header="{Binding StrPostureProviders}">
            <Grid RowDefinitions="Auto,2*,Auto,*,Auto,160" ColumnDefinitions="*,*" Margin="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StrTrendMicro}" Classes="header2"
                               VerticalAlignment="Center"/>
                    <Button Classes="subButton" Margin="10 0 0 0"
                            Command="{Binding BtNewTrendMicroClicked}" ToolTip.Tip="{Binding StrAdd}">
                        <material:MaterialIcon Kind="Plus"/>
                    </Button>
                    <Button Classes="subButton" Margin="10 0 0 0" Command="{Binding BtReloadClicked}"
                            ToolTip.Tip="{Binding StrReload}">
                        <material:MaterialIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StrSecurityScorecard}" Classes="header2"
                               VerticalAlignment="Center"/>
                    <Button Classes="subButton" Margin="10 0 0 0"
                            Command="{Binding BtNewScorecardClicked}" ToolTip.Tip="{Binding StrAdd}">
                        <material:MaterialIcon Kind="Plus"/>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0 10 10 0">
                    <StackPanel Width="460" HorizontalAlignment="Left">
                        <DataGrid ItemsSource="{Binding TrendMicroConnections}"
                                  SelectedItem="{Binding SelectedTrendMicro}"
                                  IsReadOnly="True" MinHeight="110" Margin="0 0 0 10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="{Binding StrRegion}" Binding="{Binding Region}"/>
                                <DataGridTextColumn Header="{Binding StrLastSync}"
                                                    Binding="{Binding LastSyncAt}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionConnection}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrName}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding TrendMicroDraft.Name}"/>

                                <TextBlock Text="{Binding StrRegion}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <ComboBox ItemsSource="{Binding TrendMicroRegions}"
                                          SelectedItem="{Binding SelectedTrendMicroRegion}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionAuthentication}" Classes="sectionCaption"/>
                                <TextBlock Text="{Binding StrApiKey}" Classes="fieldLabel"/>
                                <!-- Grid, not a horizontal StackPanel: inside a formCard a TextBox stretches, and a
                                     horizontal StackPanel would measure that stretch as infinite width. -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding TrendMicroApiKey}" PasswordChar="&#x2022;"
                                             IsEnabled="{Binding TrendMicroApiKeyVault.AcceptsTypedValue}"/>
                                    <!-- The picker and its counterpart appear only when this installation has a usable vault.
                                         Bound to the field's own state object rather than to a view-model mirror of it, so the
                                         three-way typed/picked/bound decision lives in one testable place. -->
                                    <Button Grid.Column="1" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding TrendMicroApiKeyVault.ShowPicker}"
                                            Command="{Binding BtPickVaultSecretClicked}"
                                            CommandParameter="trendmicro-apikey"
                                            ToolTip.Tip="{Binding StrUseVaultSecret}">
                                        <material:MaterialIcon Kind="KeyChain"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding TrendMicroApiKeyVault.ShowDetach}"
                                            Command="{Binding BtDetachVaultSecretClicked}"
                                            CommandParameter="trendmicro-apikey"
                                            ToolTip.Tip="{Binding StrStopUsingVault}">
                                        <material:MaterialIcon Kind="KeyRemove"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0"
                                      IsVisible="{Binding TrendMicroApiKeyVault.HasDisplayText}">
                                    <material:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline" Width="14" Height="14"
                                                           VerticalAlignment="Top" Margin="0 1 4 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding TrendMicroApiKeyVault.DisplayText}" Classes="hint" Margin="0"/>
                                        <!-- A picked secret is not committed until Save, and an operator who misses that
                                             ships a connection that still resolves the old value. -->
                                        <TextBlock Text="{Binding StrWillBeSaved}" Classes="notice" Margin="0 2 0 0"
                                                   IsVisible="{Binding TrendMicroApiKeyVault.HasPendingChange}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionSync}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrSyncInterval}" Classes="fieldLabel"/>
                                <NumericUpDown Value="{Binding TrendMicroDraft.SyncIntervalHours}" Minimum="1"
                                               Maximum="168" MinWidth="120" HorizontalAlignment="Left"/>

                                <CheckBox IsChecked="{Binding TrendMicroDraft.SyncVulnerabilities}"
                                          Margin="0 12 0 0">
                                    <TextBlock Text="{Binding StrSyncVulnerabilities}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding TrendMicroDraft.SyncRiskScores}">
                                    <TextBlock Text="{Binding StrSyncRiskScores}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding TrendMicroDraft.VirtualPatchClosesFinding}">
                                    <TextBlock Text="{Binding StrVirtualPatchClosesFinding}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding TrendMicroDraft.PushExemptions}">
                                    <TextBlock Text="{Binding StrPushExemptions}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding TrendMicroDraft.Enabled}">
                                    <TextBlock Text="{Binding StrEnabled}"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                            <Button Classes="dialog1" Command="{Binding BtSaveTrendMicroClicked}"
                                    ToolTip.Tip="{Binding StrSave}">
                                <material:MaterialIcon Kind="ContentSave"/>
                            </Button>
                            <Button Classes="dialog2" Margin="8 0 0 0"
                                    Command="{Binding BtTestTrendMicroClicked}"
                                    ToolTip.Tip="{Binding StrTestConnection}">
                                <material:MaterialIcon Kind="LanConnect"/>
                            </Button>
                            <Button Classes="dialog2" Margin="8 0 0 0"
                                    Command="{Binding BtSyncTrendMicroClicked}"
                                    ToolTip.Tip="{Binding StrSyncNow}">
                                <material:MaterialIcon Kind="Sync"/>
                            </Button>
                            <Button Classes="dialog2" Margin="8 0 0 0"
                                    Command="{Binding BtDeleteTrendMicroClicked}"
                                    ToolTip.Tip="{Binding StrDelete}">
                                <material:MaterialIcon Kind="Delete"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="0 10 0 0">
                    <StackPanel Width="460" HorizontalAlignment="Left">
                        <DataGrid ItemsSource="{Binding ScorecardConnections}"
                                  SelectedItem="{Binding SelectedScorecard}"
                                  IsReadOnly="True" MinHeight="110" Margin="0 0 0 10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="{Binding StrDomain}" Binding="{Binding Domain}"/>
                                <DataGridTextColumn Header="{Binding StrLastSync}"
                                                    Binding="{Binding LastSyncAt}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionConnection}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrName}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding ScorecardDraft.Name}"/>

                                <TextBlock Text="{Binding StrDomain}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding ScorecardDraft.Domain}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionAuthentication}" Classes="sectionCaption"/>
                                <TextBlock Text="{Binding StrApiToken}" Classes="fieldLabel"/>
                                <!-- Grid, not a horizontal StackPanel: inside a formCard a TextBox stretches, and a
                                     horizontal StackPanel would measure that stretch as infinite width. -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding ScorecardApiToken}" PasswordChar="&#x2022;"
                                             IsEnabled="{Binding ScorecardApiTokenVault.AcceptsTypedValue}"/>
                                    <!-- The picker and its counterpart appear only when this installation has a usable vault.
                                         Bound to the field's own state object rather than to a view-model mirror of it, so the
                                         three-way typed/picked/bound decision lives in one testable place. -->
                                    <Button Grid.Column="1" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding ScorecardApiTokenVault.ShowPicker}"
                                            Command="{Binding BtPickVaultSecretClicked}"
                                            CommandParameter="scorecard-apitoken"
                                            ToolTip.Tip="{Binding StrUseVaultSecret}">
                                        <material:MaterialIcon Kind="KeyChain"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="detailButton" Margin="5 0 0 0"
                                            IsVisible="{Binding ScorecardApiTokenVault.ShowDetach}"
                                            Command="{Binding BtDetachVaultSecretClicked}"
                                            CommandParameter="scorecard-apitoken"
                                            ToolTip.Tip="{Binding StrStopUsingVault}">
                                        <material:MaterialIcon Kind="KeyRemove"/>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0"
                                      IsVisible="{Binding ScorecardApiTokenVault.HasDisplayText}">
                                    <material:MaterialIcon Grid.Column="0" Kind="ShieldKeyOutline" Width="14" Height="14"
                                                           VerticalAlignment="Top" Margin="0 1 4 0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ScorecardApiTokenVault.DisplayText}" Classes="hint" Margin="0"/>
                                        <!-- A picked secret is not committed until Save, and an operator who misses that
                                             ships a connection that still resolves the old value. -->
                                        <TextBlock Text="{Binding StrWillBeSaved}" Classes="notice" Margin="0 2 0 0"
                                                   IsVisible="{Binding ScorecardApiTokenVault.HasPendingChange}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionSync}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrSyncInterval}" Classes="fieldLabel"/>
                                <NumericUpDown Value="{Binding ScorecardDraft.SyncIntervalHours}" Minimum="1"
                                               Maximum="168" MinWidth="120" HorizontalAlignment="Left"/>

                                <CheckBox IsChecked="{Binding ScorecardDraft.SyncVulnerabilities}"
                                          Margin="0 12 0 0">
                                    <TextBlock Text="{Binding StrSyncVulnerabilities}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding ScorecardDraft.SyncIssues}">
                                    <TextBlock Text="{Binding StrSyncIssues}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding ScorecardDraft.Enabled}">
                                    <TextBlock Text="{Binding StrEnabled}"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                            <Button Classes="dialog1" Command="{Binding BtSaveScorecardClicked}"
                                    ToolTip.Tip="{Binding StrSave}">
                                <material:MaterialIcon Kind="ContentSave"/>
                            </Button>
                            <Button Classes="dialog2" Margin="8 0 0 0"
                                    Command="{Binding BtTestScorecardClicked}"
                                    ToolTip.Tip="{Binding StrTestConnection}">
                                <material:MaterialIcon Kind="LanConnect"/>
                            </Button>
                            <Button Classes="dialog2" Margin="8 0 0 0"
                                    Command="{Binding BtSyncScorecardClicked}"
                                    ToolTip.Tip="{Binding StrSyncNow}">
                                <material:MaterialIcon Kind="Sync"/>
                            </Button>
                            <Button Classes="dialog2" Margin="8 0 0 0"
                                    Command="{Binding BtDeleteScorecardClicked}"
                                    ToolTip.Tip="{Binding StrDelete}">
                                <material:MaterialIcon Kind="Delete"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrFactorHistory}"
                           Classes="header2" Margin="0 10 0 0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StrSyncLog}"
                           Classes="header2" Margin="0 10 0 0"/>

                <DataGrid Grid.Row="3" Grid.Column="0" Margin="0 5 10 0" IsReadOnly="True"
                          ItemsSource="{Binding ScorecardHistory}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding StrFactor}" Binding="{Binding FactorName}"/>
                        <DataGridTextColumn Header="{Binding StrScore}" Binding="{Binding Score}"/>
                        <DataGridTextColumn Header="{Binding StrGrade}" Binding="{Binding Grade}"/>
                        <DataGridTextColumn Header="{Binding StrCapturedAt}" Binding="{Binding CapturedAt}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid Grid.Row="3" Grid.Column="1" Margin="0 5 0 0" IsReadOnly="True"
                          ItemsSource="{Binding SyncLog}"
                          SelectedItem="{Binding SelectedSyncLog}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding ConnectionName}"/>
                        <DataGridTextColumn Header="{Binding StrStatus}" Binding="{Binding Status}"/>
                        <DataGridTextColumn Header="{Binding StrLastSync}" Binding="{Binding StartedAt}"/>
                        <DataGridTextColumn Header="{Binding StrDescription}" Binding="{Binding Summary}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- The selected run's progress trail. Spans both columns because a trail line is a
                     sentence, not a cell, and half the tab's width wraps every one of them. -->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding StrSyncProgress}" Classes="header2" Margin="0 10 0 0"/>

                <!-- SelectableTextBlock, because the operator's next move after reading a failed run
                     is to paste it into a ticket. Monospace so the timestamp column stays a column. -->
                <ScrollViewer Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 5 0 0"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding SelectedSyncLogProgress}"
                                         FontFamily="monospace" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- =====================================================================================
             External secret vaults.

             Nothing on this tab ever displays a secret value: the API it talks to has no endpoint
             that returns one. What it manages is the connection (which plugin, which vault, which
             API key, which optional machine ID) and what it shows is metadata.
             ===================================================================================== -->
        <TabItem Header="{Binding StrSecretVaults}">
            <!-- The detail column is `Auto`, not `*`: the form panel is a fixed width (§6.2
                 rule 2 — a left-aligned card column collapses to a sliver without one), so a star
                 column would reserve half the window for it and leave the extra width blank
                 instead of giving it to the list. -->
            <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto" Margin="10">

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding StrSecretVaults}" Classes="header2"
                               VerticalAlignment="Center"/>
                    <Button Classes="subButton" Margin="10 0 0 0"
                            Command="{Binding BtNewVaultClicked}" ToolTip.Tip="{Binding StrAdd}">
                        <material:MaterialIcon Kind="Plus"/>
                    </Button>
                    <Button Classes="subButton" Margin="10 0 0 0" Command="{Binding BtReloadClicked}"
                            ToolTip.Tip="{Binding StrReload}">
                        <material:MaterialIcon Kind="Refresh"/>
                    </Button>
                </StackPanel>

                <!-- Shown instead of an empty picker: without a plugin there is nothing to connect
                     to, and the message says where to put one. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding StrNoSecretVaultPlugins}" Classes="notice"
                           Margin="0 8 0 0"
                           IsVisible="{Binding HasNoVaultPlugins}"/>

                <ScrollViewer Grid.Row="2" Grid.Column="0" Margin="0 10 10 0">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding VaultConnections}"
                                  SelectedItem="{Binding SelectedVault}"
                                  IsReadOnly="True" MinHeight="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding StrName}" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="{Binding StrPlugin}"
                                                    Binding="{Binding PluginName}"/>
                                <DataGridCheckBoxColumn Header="{Binding StrEnabled}"
                                                        Binding="{Binding Enabled}"/>
                                <DataGridTextColumn Header="{Binding StrLastTest}"
                                                    Binding="{Binding LastTestAt}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- The test outcome is a result, not help, so it gets a card and an icon
                             rather than the quiet treatment the field hints get. Severity rides on
                             the icon's shape because §2.6 does not allow colour to carry it alone. -->
                        <Border Classes="formCard" Margin="0 10 0 10"
                                IsVisible="{Binding SelectedVault, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel>
                                <TextBlock Text="{Binding StrLastTest}" Classes="sectionCaption"/>
                                <!-- Grid, not a horizontal StackPanel: a horizontal StackPanel
                                     measures its children with infinite width, so TextWrapping
                                     never engages and a long message runs off the card. -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <material:MaterialIcon Grid.Column="0" Kind="CheckCircleOutline"
                                                           Classes="successIcon"
                                                           Width="16" Height="16" VerticalAlignment="Top"
                                                           Margin="0 2 6 0"
                                                           IsVisible="{Binding VaultTestPassed}"/>
                                    <material:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline"
                                                           Classes="errorIcon"
                                                           Width="16" Height="16" VerticalAlignment="Top"
                                                           Margin="0 2 6 0"
                                                           IsVisible="{Binding VaultTestFailed}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedVault.LastTestMessage}"
                                               Classes="notice" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding VaultUsageCaption}" Classes="hint"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" Grid.Column="1" Margin="0 10 0 0">
                    <StackPanel Width="460" HorizontalAlignment="Left">

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionConnection}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrName}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding VaultDraft.Name}"/>

                                <TextBlock Text="{Binding StrPlugin}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <!-- Displays the plugin name, not its description: the description is a
                                     sentence, and a picker row has to be identifiable at a glance. -->
                                <ComboBox ItemsSource="{Binding VaultPlugins}"
                                          SelectedValue="{Binding SelectedVaultPluginName}"
                                          SelectedValueBinding="{Binding PluginName}"
                                          DisplayMemberBinding="{Binding PluginName}"/>

                                <!-- Accepts a node URL or a cluster name; the hint is not decoration, because
                                     the two forms look alike and only one of them survives a node going
                                     down. See VaultAddress on the server for the grammar. -->
                                <TextBlock Text="{Binding StrBaseUrl}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding VaultDraft.BaseUrl}"/>
                                <TextBlock Text="{Binding StrVaultBaseUrlHint}" Classes="hint"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionAuthentication}" Classes="sectionCaption"/>

                                <!-- Write-only, like every other credential box on this screen: blank means
                                     "keep the stored key". -->
                                <TextBlock Text="{Binding StrApiKey}" Classes="fieldLabel"/>
                                <TextBox Text="{Binding VaultApiKey}" PasswordChar="&#x2022;"/>

                                <!-- Not a password box. The machine ID identifies the installation, it does
                                     not authenticate it, and an operator has to be able to read it back to
                                     compare it against what the vault shows. -->
                                <TextBlock Text="{Binding StrMachineId}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding VaultDraft.MachineId}"/>
                                <!-- One TextBlock whose text switches, rather than two whose visibility does:
                                     a plugin that requires a machine ID and one that does not need the same
                                     sentence in different words, not two sentences one of which is a lie. -->
                                <TextBlock Text="{Binding StrVaultMachineIdHint}" Classes="hint"/>

                                <!-- Also not a password box: the app id names the caller to the vault, it does
                                     not authenticate it, and it is the value an operator compares against the
                                     vault's own policy list when access is refused. -->
                                <TextBlock Text="{Binding StrAppId}" Classes="fieldLabel" Margin="0 12 0 3"/>
                                <TextBox Text="{Binding VaultDraft.AppId}"/>
                                <TextBlock Text="{Binding StrVaultAppIdHint}" Classes="hint"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="formCard">
                            <StackPanel>
                                <TextBlock Text="{Binding StrFormSectionBehaviour}" Classes="sectionCaption"/>

                                <TextBlock Text="{Binding StrCacheMinutes}" Classes="fieldLabel"/>
                                <NumericUpDown Value="{Binding VaultDraft.CacheTtlMinutes}" Minimum="1"
                                               Maximum="60" MinWidth="120" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding StrSecretCacheHint}" Classes="hint"/>

                                <CheckBox IsChecked="{Binding VaultDraft.Enabled}" Margin="0 12 0 0"
                                          Content="{Binding StrEnabled}"/>
                            </StackPanel>
                        </Border>

                        <!-- The hint sits under the box rather than in a tooltip: this switches off
                             certificate validation on the one channel that carries every other
                             credential, and what it costs has to be readable without hovering. The
                             card is `caution` for the same reason — this is the one setting here
                             that weakens a control instead of configuring one. -->
                        <Border Classes="formCard caution">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding VaultDraft.IgnoreSslErrors}"
                                          Content="{Binding StrIgnoreSslErrors}"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0 4 0 0">
                                    <material:MaterialIcon Grid.Column="0" Kind="ShieldOffOutline"
                                                           Classes="cautionIcon"
                                                           Width="14" Height="14" VerticalAlignment="Top"
                                                           Margin="0 2 6 0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StrIgnoreSslErrorsHint}"
                                               Classes="hint" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                            <Button Classes="detailButton" Command="{Binding BtSaveVaultClicked}"
                                    ToolTip.Tip="{Binding StrSave}">
                                <material:MaterialIcon Kind="ContentSave"/>
                            </Button>
                            <Button Classes="detailButton" Margin="8 0 0 0"
                                    Command="{Binding BtTestVaultClicked}"
                                    ToolTip.Tip="{Binding StrTestConnection}">
                                <material:MaterialIcon Kind="Connection"/>
                            </Button>
                            <Button Classes="detailButton" Margin="8 0 0 0"
                                    Command="{Binding BtDeleteVaultClicked}"
                                    ToolTip.Tip="{Binding StrDelete}">
                                <material:MaterialIcon Kind="Delete"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
