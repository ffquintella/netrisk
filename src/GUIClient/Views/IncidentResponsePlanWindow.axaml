<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:GUIClient.ViewModels"
        xmlns:converters="clr-namespace:GUIClient.Converters"
        xmlns:material="using:Material.Icons.Avalonia"

        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:dvm="clr-namespace:GUIClient.ViewModels" x:DataType="dvm:IncidentResponsePlanViewModel" x:Class="GUIClient.Views.IncidentResponsePlanWindow"
        Name="IncidentResponsePlanWin"
        Title="{Binding StrTitle}"
        Width="1000" Height="800"
        MinWidth="800" MinHeight="600"
        CanResize="True"
        Classes="dark">
    <Design.DataContext>
        <viewModels:IncidentResponsePlanViewModel/>
    </Design.DataContext>
    
    <Window.Resources>
        <converters:DateToFormatedStringConverter x:Key="DateToFormatedStringConverter"/>
        <converters:TypeToIconConverter x:Key="TypeToIconConverter"/>
        <converters:MultiBoolAndConverter x:Key="MultiBoolAndConverter"/>
    </Window.Resources>

    
    <Grid  RowDefinitions="*, Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto, Auto, Auto, *, Auto" ColumnDefinitions="3*,2, *">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrTitle}" Classes="header" TextAlignment="Center" Grid.ColumnSpan="3" />
            <!-- RISK -->
            <GroupBox Grid.Row="1" Grid.Column="0" Classes="type3" Header="{Binding StrRisk}" >
               <StackPanel Orientation="Vertical">
                   <StackPanel Orientation="Horizontal">
                       <TextBlock Text="#:" Margin="0 0 5 0" Classes="label-nm"/><TextBlock Text="{Binding RelatedRisk.Id}"/>
                       <TextBlock Text="{Binding StrDate}" Margin=" 5 0 5 0" Classes="label-nm"/><TextBlock Text="{Binding RelatedRisk.LastUpdate, Converter={StaticResource DateToFormatedStringConverter}}"/>
                   </StackPanel>                   
                   <StackPanel Orientation="Horizontal">
                       <TextBlock Text="{Binding StrName}"  Classes="label-nm"/><TextBlock Classes="label-nm" Text=":" Margin="0 0 5 0"/><TextBlock Text="{Binding RelatedRisk.Subject}"/>
                   </StackPanel>
               </StackPanel>
            </GroupBox>
            <!-- PLAN -->
            <GroupBox Grid.Row="2" Grid.Column="0" Classes="type1" Header="{Binding StrPlan}">
                <Grid RowDefinitions="Auto, *">
                    <!-- INFO -->
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*"
                          RowSpacing="6" ColumnSpacing="10">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="#:" VerticalAlignment="Center" IsVisible="{Binding IsEditOrViewOperation}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IncidentResponsePlan.Id}" VerticalAlignment="Center" IsVisible="{Binding IsEditOrViewOperation}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StrName}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name}" IsVisible="{Binding IsCreateOrEditOperation}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsViewOperation}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrDescription}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Height="80" AcceptsReturn="True" Text="{Binding Description}" IsVisible="{Binding IsCreateOrEditOperation}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsViewOperation}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding StrComments}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Height="80" AcceptsReturn="True" Text="{Binding Notes}" IsVisible="{Binding IsCreateOrEditOperation}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Notes}" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsViewOperation}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding StrLifeCicleStatus}" VerticalAlignment="Center"/>
                        <WrapPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding !IsViewOperation}">
                            <CheckBox Content="{Binding StrHasBeenApproved}" IsChecked="{Binding HasBeenApproved}" Margin="0 0 10 0" IsEnabled="{Binding CanApprove}" />
                            <CheckBox Content="{Binding StrHasBeenReviewed}" IsChecked="{Binding HasBeenReviewed}" Margin="0 0 10 0" IsEnabled="{Binding CanReview}"/>
                            <CheckBox Content="{Binding StrHasBeenExercised}" IsChecked="{Binding HasBeenExercised}" Margin="0 0 10 0" IsEnabled="{Binding CanExercise}"/>
                            <CheckBox Content="{Binding StrHasBeenTested}" IsChecked="{Binding HasBeenTested}" Margin="0 0 10 0" IsEnabled="{Binding CanTest}"/>
                        </WrapPanel>

                        <WrapPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsViewOperation}">
                            <StackPanel Orientation="Horizontal" Margin="0 0 12 0" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="Check" VerticalAlignment="Center" IsVisible="{Binding HasBeenApproved}"/>
                                <material:MaterialIcon Kind="Close" VerticalAlignment="Center" IsVisible="{Binding !HasBeenApproved}"/>
                                <TextBlock Text="{Binding StrHasBeenApproved}" VerticalAlignment="Center" Margin="4 0 0 0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 12 0" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="Check" VerticalAlignment="Center" IsVisible="{Binding HasBeenExercised}"/>
                                <material:MaterialIcon Kind="Close" VerticalAlignment="Center" IsVisible="{Binding !HasBeenExercised}"/>
                                <TextBlock Text="{Binding StrHasBeenExercised}" VerticalAlignment="Center" Margin="4 0 0 0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 0 12 0" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="Check" VerticalAlignment="Center" IsVisible="{Binding HasBeenTested}"/>
                                <material:MaterialIcon Kind="Close" VerticalAlignment="Center" IsVisible="{Binding !HasBeenTested}"/>
                                <TextBlock Text="{Binding StrHasBeenTested}" VerticalAlignment="Center" Margin="4 0 0 0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="Check" VerticalAlignment="Center" IsVisible="{Binding HasBeenReviewed}"/>
                                <material:MaterialIcon Kind="Close" VerticalAlignment="Center" IsVisible="{Binding !HasBeenReviewed}"/>
                                <TextBlock Text="{Binding StrHasBeenReviewed}" VerticalAlignment="Center" Margin="4 0 0 0"/>
                            </StackPanel>
                        </WrapPanel>

                        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="10"
                              RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StrApprover}" VerticalAlignment="Center" Margin="0 0 0 6" IsVisible="{Binding HasBeenApproved}"/>
                            <AutoCompleteBox Grid.Row="0" Grid.Column="1" Margin="0 0 0 6" IsVisible="{Binding ShowApproverTextBox}"
                                             FilterMode="StartsWith"
                                             SelectedItem="{Binding SelectedApprover}"
                                             ItemsSource="{Binding PeopleEntities}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedApprover}" VerticalAlignment="Center" Margin="0 0 0 6">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{StaticResource MultiBoolAndConverter}">
                                        <Binding Path="IsViewOperation"/>
                                        <Binding Path="HasBeenApproved"/>
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StrReviewer}" VerticalAlignment="Center" Margin="0 0 0 6" IsVisible="{Binding HasBeenReviewed}"/>
                            <AutoCompleteBox Grid.Row="1" Grid.Column="1" Margin="0 0 0 6" IsVisible="{Binding ShowReviewerTextBox}"
                                             FilterMode="StartsWith"
                                             SelectedItem="{Binding SelectedReviewer}"
                                             ItemsSource="{Binding PeopleEntities}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedReviewer}" VerticalAlignment="Center" Margin="0 0 0 6">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{StaticResource MultiBoolAndConverter}">
                                        <Binding Path="IsViewOperation"/>
                                        <Binding Path="HasBeenReviewed"/>
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding StrExerciser}" VerticalAlignment="Center" Margin="0 0 0 6" IsVisible="{Binding HasBeenExercised}"/>
                            <AutoCompleteBox Grid.Row="2" Grid.Column="1" Margin="0 0 0 6" IsVisible="{Binding ShowExerciserTextBox}"
                                             FilterMode="StartsWith"
                                             SelectedItem="{Binding SelectedExerciser}"
                                             ItemsSource="{Binding PeopleEntities}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedExerciser}" VerticalAlignment="Center" Margin="0 0 0 6">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{StaticResource MultiBoolAndConverter}">
                                        <Binding Path="IsViewOperation"/>
                                        <Binding Path="HasBeenExercised"/>
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding StrTester}" VerticalAlignment="Center" IsVisible="{Binding HasBeenTested}"/>
                            <AutoCompleteBox Grid.Row="3" Grid.Column="1" IsVisible="{Binding ShowTesterTextBox}"
                                             FilterMode="StartsWith"
                                             SelectedItem="{Binding SelectedTester}"
                                             ItemsSource="{Binding PeopleEntities}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTester}" VerticalAlignment="Center">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{StaticResource MultiBoolAndConverter}">
                                        <Binding Path="IsViewOperation"/>
                                        <Binding Path="HasBeenTested"/>
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>

                        </Grid>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding StrMetadata}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StrCreationDate, Mode=OneTime}" Margin="0 0 5 0" Classes="label-nm" VerticalAlignment="Center"/><TextBlock Text="{Binding CreationDate, Converter={StaticResource DateToFormatedStringConverter}}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StrLastUpdate, Mode=OneTime}" Margin="10 0 5 0" Classes="label-nm" VerticalAlignment="Center"/><TextBlock Text="{Binding LastUpdate, Converter={StaticResource DateToFormatedStringConverter}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
            <!-- Attachements --> 
            <GroupBox Grid.Row="3" Grid.Column="0"  Header="{Binding StrAttachments}">
                <Grid ColumnDefinitions="*, Auto">
                            <ItemsControl Grid.Column="0" Name="LstDocs"  
                                     HorizontalAlignment="Left" MinWidth="400"
                                     VerticalAlignment="Top"
                                     ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                     ItemsSource="{Binding Attachments}"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <material:MaterialIcon Kind="{Binding Type, Converter={StaticResource TypeToIconConverter}}" Width="15" Height="15" />
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="5 0 0 0 "/>
                                            <Button Classes="subButton" Name="btDownload"
                                                    Width="22" Height="22" Padding="0"
                                                    Margin="5 0 0 0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip.Tip="{Binding #IncidentResponsePlanWin.DataContext.StrDownload}"
                                                    Command="{Binding #IncidentResponsePlanWin.DataContext.BtFileDownloadClicked}"
                                                    CommandParameter="{Binding }"
                                                    >
                                                <material:MaterialIcon Kind="Download" Width="14" Height="14"/>
                                            </Button>
                                            <Button Classes="subButton" Name="BtDelete"
                                                    Width="22" Height="22" Padding="0"
                                                    Margin="5 0 0 0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip.Tip="{Binding #IncidentResponsePlanWin.DataContext.StrDelete}"
                                                    IsVisible="{Binding !#IncidentResponsePlanWin.DataContext.IsViewOperation}"
                                                    Command="{Binding #IncidentResponsePlanWin.DataContext.BtFileDeleteClicked}"
                                                    CommandParameter="{Binding }"
                                            >
                                                <material:MaterialIcon Kind="Delete" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button Classes="subButton" Name="BtAddFile" Command="{Binding BtFileAddClicked}"
                                        ToolTip.Tip="{Binding StrAdd}"
                                        IsEnabled="{Binding !IsCreateOperation}"
                                        IsVisible="{Binding !IsViewOperation}">
                                    <material:MaterialIcon Kind="Add"/>
                                </Button>
                            </StackPanel>
                        </Grid>
            </GroupBox>
            
            <!-- IRP Buttons --> 
            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10 10 0 0">
                <Button Classes="dialog1" Command="{Binding BtSaveClicked}" Margin="0 0 10 0"
                        IsEnabled="{Binding CanSave}" IsVisible="{Binding !IsViewOperation}"
                        ToolTip.Tip="{Binding ValidationContext.Text}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <material:MaterialIcon Kind="ContentSave"/>
                        <TextBlock Text="{Binding StrSave}" Margin="5 3 0 0"/>
                    </StackPanel>
                </Button>
                <Button Classes="dialog2" Command="{Binding BtCancelClicked}" IsCancel="True"
                        IsEnabled="{Binding CanCancel}" IsVisible="{Binding !IsViewOperation}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <material:MaterialIcon Kind="Cancel"/>
                        <TextBlock Text="{Binding StrCancel}" Margin="5 3 0 0"/>
                    </StackPanel>
                </Button>
                <Button Classes="dialog2" Command="{Binding BtCloseClicked}" IsCancel="True"
                        IsEnabled="{Binding CanClose}" IsVisible="{Binding IsViewOperation}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <material:MaterialIcon Kind="Close"/>
                        <TextBlock Text="{Binding StrClose}" Margin="5 3 0 0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
            <GridSplitter Grid.Row="1" Grid.Column="1" Grid.RowSpan="4"/>
            
            <!-- TASKS -->
            <GroupBox Grid.Row="1" Grid.RowSpan="4" Grid.Column="2" Header="{Binding StrTasks}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Classes="tooltip"
                                    ToolTip.Tip="{Binding $parent[Window].((dvm:IncidentResponsePlanViewModel)DataContext).StrGantt}">
                                <Button Classes="subButton"
                                        Command="{Binding $parent[Window].((dvm:IncidentResponsePlanViewModel)DataContext).BtShowGanttClicked}">
                                    <material:MaterialIcon Kind="ChartGantt"/>
                                </Button>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid RowDefinitions="*,Auto" ColumnDefinitions="*" VerticalAlignment="Stretch">
                
                    <ListBox Grid.Row="0" Grid.Column="0" Name="LstTasks"  
                             HorizontalAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Visible"
                             ItemsSource="{Binding Tasks}"
                             SelectedItem="{Binding SelectedTask}"
                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                        
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                               
                               <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                   <material:MaterialIcon Kind="ViewParallel" IsVisible="{Binding IsParallel}"/>
                                   <material:MaterialIcon Kind="ViewSequential" IsVisible="{Binding IsSequential}"/>
                                   <material:MaterialIcon Kind="TimelineQuestion" IsVisible="{Binding IsOptional}" Margin="5 0 0 0 "/>
                                   <TextBlock  Text="{Binding Name}" TextWrapping="Wrap" Margin="5 0 0 0 "/>
                               </StackPanel>
                           
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!--Tasks Buttons-->
                    <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto, Auto, *, Auto, Auto" IsVisible="{Binding !IsViewOperation}">
                        <Button Grid.Column="0" Name="BtAddTask"  Classes="subButton"
                                Command="{Binding BtAddTaskClicked}">
                            <material:MaterialIcon Kind="Add"/>
                        </Button>
                        <Button Grid.Column="1" Name="BtEditTask"  Classes="subButton type1"
                                Command="{Binding BtEditTaskClicked}">
                            <material:MaterialIcon Kind="Edit"/>
                        </Button>
                        
                        <Button Grid.Column="3" Name="BtViewTask"  Classes="subButton type2"
                                Command="{Binding BtViewTaskClicked}">
                            <material:MaterialIcon Kind="Eye"/>
                        </Button>
                        <Button Grid.Column="4" Name="BtDeleteTask" Classes="subButton type3"
                                Command="{Binding BtDeleteTaskClicked}">
                            <material:MaterialIcon Kind="Delete"/>
                        </Button>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
        <!-- FOOTER -->
        <Border Grid.Row="1" Classes="footer" Margin="0 3 0 0">
            <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding StrLoggedUser}" Margin=" 3 0 5 3 "/> <TextBlock Text="{Binding UserInfo.UserName}" Margin=" 3 0 10 3"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
