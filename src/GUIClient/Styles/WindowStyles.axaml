<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        >
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Border.tooltip">
        <Setter Property="ToolTip.ShowDelay" Value="1000"/>
    </Style>
    
    <!--
        Fixed-size icon buttons opt out of Semi's button metrics.

        Semi's Button control theme sets Padding="12 0" and MinHeight="{SemiHeightControlDefault}".
        Both are right for a labelled button and wrong for a square icon button: at 25x25 the padding
        leaves about a pixel for the glyph — which is exactly how the status filter rendered as four
        empty purple circles — and MinHeight silently overrides a declared Height. Every class listed
        here declares its own Width/Height, so it declares its own padding too.

        This sits above the per-class styles on purpose: a later style wins in Avalonia, so
        Button.nav-base can still ask for Padding="6" and get it.
    -->
    <Style Selector="Button.filterButton, Button.subButton, Button.detailButton, Button.navigation, Button.toolbar, Button.nav-base, Button.operation">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
    </Style>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceBase}"/>
        <Setter Property="MinWidth" Value="320"/>
        <Setter Property="MinHeight" Value="180"/>
    </Style>
    
    <Style Selector="Window.dark">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceDeep}"/>
    </Style>
    
        
    <Style Selector="GroupBox.type1">
        <Setter Property="Background" Value="{DynamicResource NrSurfacePanel1}"/>
    </Style>
    
    <Style Selector="GroupBox.type2">
        <Setter Property="Background" Value="{DynamicResource NrSurfacePanel2}"/>
    </Style>
    
    <Style Selector="GroupBox.type3">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceAbyss}"/>
    </Style>

    
    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceBase}"/>
        <!--Setter Property="Height" Value="20"/-->
        <!--Setter Property="" Value="0 0 0"/-->
    </Style>

    <Style Selector="TabControl WrapPanel">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceTab}"/>
        <!--Setter Property="Height" Value="60"/-->
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource NrSurfaceTab}"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
    </Style>

    <Style Selector="Grid#OverlayGridCtrl">
        <Setter Property="ZIndex" Value="-1" />
        <Setter Property="Background" Value="{DynamicResource NrSurfaceScrim}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    
    <Style Selector="GridSplitter.horizontalSplitter">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceSplitter}" />
        <Setter Property="ResizeDirection" Value="Columns" />
    </Style>
    
    <!-- TextBlock -->
    <Style Selector="TextBlock.warning">
        <Setter Property="Margin" Value="30 5 0 0"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource NrSemanticWarning}"/>
    </Style>
    
    <Style Selector="TextBlock.warning2">
        <Setter Property="Margin" Value="5 2 0 0"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource NrSemanticWarningStrong}"/>
    </Style>
    
    <Style Selector="TextBlock.header">
        <Setter Property="Margin" Value="0 0 0 0"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource NrSemanticHeaderBg}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="2"/>
    </Style>
    
    <Style Selector="TextBlock.header2">
        <Setter Property="Foreground" Value="{DynamicResource NrTextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource NrSemanticInfoBg}"/>
        <Setter Property="Padding" Value="2"/>
    </Style>
    
    <Style Selector="TextBlock.header3">
        <Setter Property="Foreground" Value="{DynamicResource NrTextSecondary}"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="2"/>
        <!--Setter Property="Background" Value="{DynamicResource NrSemanticInfoBg}"/-->
    </Style>
    
    <Style Selector="TextBlock.riskHeader">
        <Setter Property="Foreground" Value="{DynamicResource NrTextOnLight}"/>
    </Style>
    
    <Style Selector="TextBlock.statusBar">
        <Setter Property="Foreground" Value="{DynamicResource NrTextOnLightStrong}"/>

    </Style>
   
    <Style Selector="TextBlock.header_detail">
        <Setter Property="Margin" Value="0 5 0 0"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextSecondary}"/>
    </Style>
    
    <Style Selector="TextBlock.label">
        <Setter Property="Margin" Value="0 5 3 0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <Style Selector="TextBlock.form_label">
        <Setter Property="Margin" Value="3 5 0 0"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <Style Selector="TextBlock.label-nm">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <Style Selector="TextBlock.form_text">
        <Setter Property="Margin" Value="0 5 1 0"/>
    </Style>
    
    <Style Selector="TextBlock.form_text2">
        <Setter Property="Margin" Value="0 6 0 0"/>
    </Style>
    
    <Style Selector="TextBlock.form_long_text">
        <Setter Property="Margin" Value="0 6 0 0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <Style Selector="TextBlock.title">
        <Setter Property="Margin" Value="3 5 3 5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <Style Selector="TextBlock.formData">
        <Setter Property="Margin" Value="0 5 0 0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <!-- ==================================================================================
         SETTINGS-FORM VOCABULARY (ui-standard §6.2)

         A settings pane is the same triplet repeated: label, control, explanation. It used
         to render the label as a full-bleed #5252aa band and the explanation as a
         black-on-DarkGray slab (`detailBlock`, now deleted), which made the two supporting
         elements the two loudest things on the screen and left the control — the only part
         the operator edits — as the quietest. These classes invert that: nothing but the
         control carries a filled surface.

         Every colour below is an existing token. `hint`/`sectionCaption` reuse #9a9a9a from
         `metric_detail`, `fieldLabel` reuses text/secondary #bbbbbb, `formCard` reuses the
         `card` surface, and the severity icons reuse the `toast` severity hexes, so §2.6's
         "no new hex within ΔE 5" is satisfied by construction.
         ================================================================================== -->

    <!-- Label for one field. Replaces `header2` on individual fields; `header2` keeps its
         documented job (§2.4 semantic/info-bg) as a band over a whole section. -->
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="Foreground" Value="{DynamicResource NrTextSecondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0 0 0 3"/>
    </Style>

    <!-- Caption naming a `formCard`. Quieter than the labels inside it on purpose: it is a
         grouping aid, not a field. -->
    <Style Selector="TextBlock.sectionCaption">
        <Setter Property="Foreground" Value="{DynamicResource NrTextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0 0 0 10"/>
    </Style>

    <!-- Explanation under a field. No background — help must not outrank the field. -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource NrTextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0 4 0 0"/>
    </Style>

    <!-- Text that reports state rather than explaining a field ("this secret is shown
         once", a connection-test result). Body weight because missing it has a cost; still
         no filled surface. A record's value in a read-only panel is `formData`, not this. -->
    <Style Selector="TextBlock.notice">
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0 4 0 0"/>
    </Style>

    <!-- Groups a run of related fields so a long settings column reads as three blocks
         rather than eleven rows. Same surface as `card`; different margin, because a form
         card stacks vertically and a dashboard card sits in a grid. -->
    <Style Selector="Border.formCard">
        <Setter Property="Background" Value="{DynamicResource NrSurfacePanel2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NrBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0 0 0 10"/>
    </Style>

    <!-- A `formCard` holding a setting that weakens a control rather than configuring one.
         One BorderBrush colours all four sides, so this reads as an outlined card with a
         heavier left edge, not a stripe — hence it keeps the card corner radius. -->
    <Style Selector="Border.formCard.caution">
        <Setter Property="BorderBrush" Value="{DynamicResource NrStatusWarning}"/>
        <Setter Property="BorderThickness" Value="3 1 1 1"/>
    </Style>

    <!-- §2.6 forbids encoding status in text colour, so severity rides on an icon's shape
         and these give that icon the matching `toast` hue. Bare class selectors: the icon
         is a MaterialIcon, which this file cannot name without importing its namespace
         into every consumer. -->
    <Style Selector="avalonia|MaterialIcon.cautionIcon">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusWarning}"/>
    </Style>

    <Style Selector="avalonia|MaterialIcon.successIcon">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusSuccess}"/>
    </Style>

    <Style Selector="avalonia|MaterialIcon.errorIcon">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusError}"/>
    </Style>

    <!-- Input inside a `formCard`. Stretching to the card is what gives a settings column a
         single right edge; before this, labels stretched while boxes sat at MinWidth=240
         and hints at MaxWidth=360, so every row ended somewhere different. -->
    <Style Selector="Border.formCard TextBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Border.formCard ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    
    <!-- Inline validation summary shown above a dialog's action row (IX-4): the rules that
         gate Save also state, in the window, what is still missing. -->
    <Style Selector="TextBlock.validationSummary">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusErrorText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="10 5 10 0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- Transient notification toast (IX-4). One accent per severity, all from the token set. -->
    <!-- Master Dashboard (Track 2 milestone 2.3.3) posture cards. Colours live here, not in the
         view, so the views stay class-driven per the UI standard. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource NrSurfacePanel2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NrBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <!-- The organisation-wide totals card, accented with the primary action colour. -->
    <Style Selector="Border.card.totals">
        <Setter Property="BorderBrush" Value="{DynamicResource NrAccentPrimary}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- Large single figure on a posture card. -->
    <Style Selector="TextBlock.metric">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0 2 0 0"/>
    </Style>

    <!-- Caption above a metric. -->
    <Style Selector="TextBlock.metric_label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextSecondary}"/>
    </Style>

    <!-- Severity breakdown line under a metric. -->
    <Style Selector="TextBlock.metric_detail">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextMuted}"/>
        <Setter Property="Margin" Value="0 2 0 0"/>
    </Style>

    <!-- Incident-response Gantt bars (Track 2 milestone 2.4.3). State is encoded by class so the
         view stays free of colour literals. -->
    <Style Selector="Border.gantt_bar">
        <Setter Property="Background" Value="{DynamicResource NrGanttBar}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- On the critical path: no slack, so it is drawn in the alert-adjacent accent. -->
    <Style Selector="Border.gantt_bar.critical">
        <Setter Property="Background" Value="{DynamicResource NrGanttBarCritical}"/>
    </Style>

    <!-- Past its computed end while still open. -->
    <Style Selector="Border.gantt_bar.overdue">
        <Setter Property="Background" Value="{DynamicResource NrGanttBarOverdue}"/>
    </Style>

    <!-- Waiting on an incomplete predecessor. -->
    <Style Selector="Border.gantt_bar.blocked">
        <Setter Property="Background" Value="{DynamicResource NrGanttBarBlocked}"/>
    </Style>

    <!-- The "now" line across the timeline. -->
    <Style Selector="Border.gantt_today">
        <Setter Property="Background" Value="{DynamicResource NrGanttToday}"/>
        <Setter Property="Width" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Timeline lane the bars sit in. -->
    <Style Selector="Border.gantt_lane">
        <Setter Property="Background" Value="{DynamicResource NrSurfacePanel1}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Height" Value="18"/>
    </Style>

    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceOverlay}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource NrBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1 1 1 3"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12 8"/>
        <Setter Property="Margin" Value="0 4 0 0"/>
        <Setter Property="BoxShadow" Value="0 2 8 0 #40000000"/>
    </Style>

    <Style Selector="Border.toast.success">
        <Setter Property="BorderBrush" Value="{DynamicResource NrStatusSuccess}"/>
    </Style>

    <Style Selector="Border.toast.info">
        <Setter Property="BorderBrush" Value="{DynamicResource NrStatusInfo}"/>
    </Style>

    <Style Selector="Border.toast.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource NrStatusWarning}"/>
    </Style>

    <Style Selector="Border.toast.error">
        <Setter Property="BorderBrush" Value="{DynamicResource NrStatusError}"/>
    </Style>

    <!-- Secondary line of a two-line list item (manager windows, pickers). -->
    <Style Selector="TextBlock.listSubtitle">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextMuted}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.footer">
        <Setter Property="Margin" Value="0 0 0 0"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextTertiary}"/>
        <Setter Property="Background" Value="{DynamicResource NrSurfaceOverlay}"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="2"/>
    </Style>
    
    <!-- BUTTONS -->
    
    <Style Selector="Button.filterButton">
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource NrAccentPrimary}"/>
    </Style>

    <!-- Sized explicitly, like Button.subButton below. Without this the icon takes its own default
         size and the 25px circle decides how much of it you see. -->
    <Style Selector="Button.filterButton > avalonia|MaterialIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    
    <Style Selector="Button.dialog1">
        <Setter Property="Background" Value="{DynamicResource NrAccentPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextOnAccent}"/>
    </Style>
    
    <Style Selector="Button.dialog2">
        <Setter Property="Background" Value="{DynamicResource NrAccentNeutral}"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextOnAccent}"/>
    </Style>
    
    <Style Selector="Button.subButton">
        <Setter Property="Margin" Value="5 5 5 0"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="{DynamicResource NrAccentSubButton}"/>
    </Style>

    <Style Selector="Button.subButton > avalonia|MaterialIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <Style Selector="Button.detailButton">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Background" Value="{DynamicResource NrAccentDetail}"/>
    </Style>

    <Style Selector="Button.detailButton > avalonia|MaterialIcon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>
    
    <Style Selector="Button.operation">
        <!-- Floor, not a cap: icon-only operation buttons stay 25x25, while
             buttons carrying a text label grow to fit their content. -->
        <Setter Property="MinWidth" Value="25"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextOnAccent}"/>
    </Style>
    
    <Style Selector="Button.navigation">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource NrAccentPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextOnAccent}"/>
    </Style>

    <Style Selector="Button.navigation > avalonia|MaterialIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- Navigation bar — base shared by all nav buttons -->
    <Style Selector="Button.nav-base">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="2 0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextOnAccent}"/>
    </Style>

    <!-- Navigation bar — icon-only action buttons -->
    <Style Selector="Button.nav-icon">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Navigation bar — notification/bell button -->
    <Style Selector="Button.nav-notification">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Navigation bar — account/user button (icon + label) -->
    <Style Selector="Button.nav-account">
        <Setter Property="Padding" Value="6 4"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Toolbar action button — icon button in a view's action bar -->
    <Style Selector="Button.toolbar">
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="5 0 0 0"/>
    </Style>
    
    <Style Selector="Button.type2">
        <Setter Property="Background" Value="{DynamicResource NrAccentSlate}"/>
    </Style>
    
    <Style Selector="Button.type3">
        <Setter Property="Background" Value="{DynamicResource NrAccentCyan}"/>
    </Style>
    
    <Style Selector="Border.footer">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceFooterBar}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    <Style Selector="Button.link">
        <Setter Property="Foreground" Value="{DynamicResource NrLink}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}">
                    <ContentPresenter.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource NrLink}"/>
                            <Setter Property="FontSize" Value="{TemplateBinding FontSize}"/>
                            <Setter Property="TextDecorations" Value="Underline"/>
                        </Style>
                    </ContentPresenter.Styles>
                </ContentPresenter>
            </ControlTemplate>
        </Setter>
    </Style>
    
    <Style Selector="avalonia|MaterialIcon.subButton">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
    </Style>
    
    <Style Selector="avalonia|MaterialIcon.success">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusSuccess}"/>
    </Style>
    
    <Style Selector="avalonia|MaterialIcon.danger">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusError}"/>
    </Style>
    
    <!-- Inline status copy. Views must not paint their own error/warning colours (UI standard
         §2.6), so the two severities that appear as running text get a class each. Both reuse
         tokens already in this file: the validation-summary red and the toast amber. -->
    <Style Selector="TextBlock.errorText">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusErrorText}"/>
    </Style>

    <Style Selector="TextBlock.warningText">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusWarning}"/>
    </Style>

    <Style Selector="avalonia|MaterialIcon.warning">
        <Setter Property="Foreground" Value="{DynamicResource NrStatusWarning}"/>
    </Style>

    <!-- Hairline container outline — the neutral 1px border used to separate a panel or a list
         row from its surface without adding an elevation step. Set BorderThickness locally when
         only one edge is wanted (e.g. "0 0 0 1" for a row divider). -->
    <Style Selector="Border.outline">
        <Setter Property="BorderBrush" Value="{DynamicResource NrBorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Small inline count/ordinal pill (assessment page badges), on the brand accent. -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource NrAccentPrimary}"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Content list — ListBox used as the main content list in a view -->
    <Style Selector="ListBox.content-list">
        <Setter Property="MinHeight" Value="100"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Visible"/>
    </Style>

    <!-- GRIDS -->
    <Style Selector="Grid.statusBar">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceStatus}" />
    </Style>
    <Style Selector="Grid.Graph">
        <Setter Property="Background" Value="{DynamicResource NrSurfaceGraph}" />
    </Style>

    
</Styles>
