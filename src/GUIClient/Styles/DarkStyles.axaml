<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    
    <Style Selector="avalonia|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
    </Style>
    
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource NrAccentNeutralBase}"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
    </Style>
    
    <Style Selector="Button[IsPointerOver=true]">
        <Setter Property="Background" Value="{DynamicResource NrAccentPrimaryHover}"/>
    </Style>
    
    
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
    </Style>
    
    <!-- The tooltip's colours are set by overriding Semi's ToolTipBackground / ToolTipForeground
         in Styles/Tokens.axaml, not here. The selectors that used to live at this spot matched
         Fluent's tooltip template (a direct TextBlock or Panel child) and match nothing in Semi's,
         so they were silently doing nothing — which is how the light tooltip got through. -->
    
    
</Styles>
