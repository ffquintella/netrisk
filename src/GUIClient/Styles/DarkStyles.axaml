<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    
    <Style Selector="avalonia|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
    </Style>
    
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource NrAccentNeutralBase}"/>
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
    </Style>
    
    <Style Selector="Button[IsPointerOver=true]">
        <Setter Property="Background" Value="{DynamicResource NrAccentPrimaryHover}"/>
    </Style>
    
    
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
    </Style>
    
    <Style Selector="ToolTip > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NrTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource NrSurfacePanel2}"/>
    </Style>
    
    <Style Selector="ToolTip > Panel">
        <Setter Property="Background" Value="{DynamicResource NrSurfacePanel2}"/>
    </Style>
    
    
</Styles>
