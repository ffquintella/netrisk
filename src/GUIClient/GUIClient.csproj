<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!--Avalonia doesen't support TrimMode=link currently,but we are working on that https://github.com/AvaloniaUI/Avalonia/issues/6892 -->
    <TrimMode>copyused</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <UserSecretsId>0980864f-6d7c-49e8-bbe0-a6022c335350</UserSecretsId>
    <LangVersion>13</LangVersion>
    <ApplicationIcon>Assets\NetRisk.ico</ApplicationIcon>
    <Company>Netrisk</Company>
    <Product>NetRisk</Product>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
    <!-- Compiled bindings are enabled globally for compile-time binding safety and faster rendering.
         Every view declares an explicit x:DataType; see Milestone 1.3. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Remove=".gitignore" />
    <None Update="appsettings.development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <AvaloniaResource Remove="Configuration\**" />
    <None Remove="Configuration\**" />
    <None Remove="Views\UsersView.axaml.cs~" />
  </ItemGroup>
  <ItemGroup>
    <!--This helps with theme dll-s trimming.
        If you will publish your application in self-contained mode with p:PublishTrimmed=true and it will use Fluent theme Default theme will be trimmed from the output and vice versa.
        https://github.com/AvaloniaUI/Avalonia/issues/5593 -->
    <!--TrimmableAssembly Include="Avalonia.Themes.Fluent" />
        <TrimmableAssembly Include="Avalonia.Themes.Default" /-->
    <Reference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="Mapster" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="MessageBox.Avalonia" />
    <!-- Transitive pin: addresses GHSA-xrw6-gwf8-vvr9 in Tmds.DBus.Protocol (pulled via Avalonia on Linux) -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <!-- Unification pin: LiveChartsCore.SkiaSharpView asks for SkiaSharp.HarfBuzz 2.88.9 while
         Avalonia.Skia forces SkiaSharp 3.119.4, and NuGet has nothing to unify the bridge against.
         Moves with SkiaSharp; it is not a ceiling. Guarded by SkiaHarfBuzzUnificationTest. -->
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <!-- SkiaSharp.HarfBuzz 3.119.4 raises managed HarfBuzzSharp to 8.3.1.5 but names no native
         assets, so Avalonia.HarfBuzz's 8.3.1.3 would stay on Linux — managed .5 calling native .3
         on a shipped target. macOS and Win32 already resolve to .5 on their own. -->
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <!--Condition below is needed to remove InProcess.DevTools package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="InProcess.DevTools" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="Deadpikle.AvaloniaProgressRing" />
    <PackageReference Include="FlashCap" />
    <PackageReference Include="FlashCap.Core" />
    <PackageReference Include="LiveChartsCore" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Microsoft.AspNetCore.Localization" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- The optional netrisk.ini administrator overlay that the installers write. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" />
    <PackageReference Include="OpenFaceONNX" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="Splat" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Drawing.Common" />
    <!-- ReactiveUI 24 ships its own Rx primitives (RxVoid / ReactiveUI.Primitives) and no longer
         brings System.Reactive or DynamicData transitively. Both are still used directly here:
         System.Reactive for Observable/Subject/Throttle, DynamicData for its Kernel extension
         methods (IndexOf, AddRange). So both are now explicit rather than incidental. -->
    <PackageReference Include="DynamicData" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Views\MainWindow.axaml.cs">
      <DependentUpon>MainWindow.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Settings.axaml.cs">
      <DependentUpon>Settings.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Resources\Localization.en-US.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Localization.en-US.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Localization.pt-BR.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Localization.pt-BR.resx</DependentUpon>
    </Compile>
    <Compile Remove="Views\teste.axaml.cs" />
    <Compile Remove="Configuration\**" />
    <Compile Update="Views\Reports\Graphs\VulnerabilitiesDistribution.axaml.cs">
      <DependentUpon>VulnerabilitiesDistribution.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Reports\FileReports.axaml.cs">
      <DependentUpon>FileReports.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Localization.en-US.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Localization.en-US.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Localization.pt-BR.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Localization.pt-BR.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Remove="Configuration\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="appsettings.json" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\netrisk-plugin-sdk\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\..\libs\TreeDataGrid.Avalonia\src\Avalonia.Controls.TreeDataGrid\Avalonia.Controls.TreeDataGrid.csproj" />
    <ProjectReference Include="..\AvaloniaExtraControls\AvaloniaExtraControls.csproj" />
    <ProjectReference Include="..\ClientServices\ClientServices.csproj" />
    <ProjectReference Include="..\DAL\DAL.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\Tools\Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaXaml Remove="Views\teste.axaml" />
    <AvaloniaXaml Remove="Configuration\**" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="Configuration\**" />
  </ItemGroup>
</Project>