<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are self-executing and must be built as executables. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BastionVaultPlugin\BastionVaultPlugin.csproj" />
    <!--
      Referenced directly and *not* excluded from runtime, unlike the plugin's own reference to it:
      here Contracts is an ordinary dependency of a test host, not a type shared across an assembly
      load context, so the test needs the real DLL beside it.
    -->
    <ProjectReference Include="..\..\..\libs\netrisk-plugin-sdk\Contracts\Contracts.csproj" />
  </ItemGroup>
</Project>
