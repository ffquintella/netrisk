<Project>

  <!--
    Installs the in-tree secret-vault plugins into a host's Plugins/Secrets directory.

    Imported by the hosts that resolve credentials at runtime — the API and the background-job host.
    Both need it: a vault-backed Jira token has to resolve when a person clicks Sync in the desktop
    client *and* when the schedule fires in the job host, and a plugin present in only one of them is
    an integration that works during the day and fails at night.

    Two properties of this target are deliberate.

    The reference is build-order only (ReferenceOutputAssembly="false"). The plugin must be loaded by
    PluginsService into its own assembly load context; linking it normally would put its types in the
    default context and, worse, would copy Contracts.dll beside it — which gives the loader a second
    copy of the shared interfaces, so the plugin's INetriskSecretVaultPlugin stops being the host's and
    IsAssignableFrom silently returns false.

    And installing is not enabling. PluginsService.PluginIsEnabledAsync answers false until an
    administrator turns the plugin on under Admin -> Plugins, so shipping the DLL activates nothing by
    itself.
  -->

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)BastionVaultPlugin\BastionVaultPlugin.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="InstallSecretVaultPlugins" AfterTargets="Build">
    <ItemGroup>
      <!--
        Named explicitly rather than globbed: the plugin's output also contains a .pdb and a
        .runtimeconfig.json, and only the assembly and its dependency manifest belong in a host's
        plugin directory.
      -->
      <SecretVaultPluginFile Include="$(MSBuildThisFileDirectory)BastionVaultPlugin\bin\$(Configuration)\$(TargetFramework)\BastionVaultPlugin.dll" />
      <SecretVaultPluginFile Include="$(MSBuildThisFileDirectory)BastionVaultPlugin\bin\$(Configuration)\$(TargetFramework)\BastionVaultPlugin.deps.json" />
    </ItemGroup>

    <!--
      Conditional on the file existing, so a host build never fails because a plugin was not built.
      A missing plugin is a feature that reports "the plugin is not installed"; a broken build is an
      outage.
    -->
    <Copy SourceFiles="@(SecretVaultPluginFile)"
          DestinationFolder="$(OutDir)Plugins\Secrets"
          SkipUnchangedFiles="true"
          Condition="Exists('%(SecretVaultPluginFile.FullPath)')" />
  </Target>

</Project>
