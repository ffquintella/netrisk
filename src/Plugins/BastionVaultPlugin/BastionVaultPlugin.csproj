<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <IsPackable>false</IsPackable>

    <!--
      The host discovers plugins by filename: PluginsService only looks at *Plugin.dll. The project
      name already ends in Plugin, but stating it here means a rename cannot quietly make the
      assembly undiscoverable.
    -->
    <AssemblyName>BastionVaultPlugin</AssemblyName>

    <!--
      Required for McMaster.NETCore.Plugins to load this assembly in its own context: it makes the
      SDK emit a .deps.json listing the plugin's private dependencies, which is what lets the loader
      resolve them without them being in the host's probing path.
    -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Private=false / ExcludeAssets=runtime, and this is the important line in the file. Contracts is
      a *shared* type between host and plugin: PluginsService lists its interfaces in `sharedTypes`,
      so the host's copy must be the one that is loaded. Copying Contracts.dll next to the plugin
      gives the load context a second copy, and then the plugin's INetriskSecretVaultPlugin is a
      different type from the host's — IsAssignableFrom returns false and the plugin is silently
      ignored, with no error anywhere.
    -->
    <ProjectReference Include="..\..\..\libs\netrisk-plugin-sdk\Contracts\Contracts.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
