<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are self-executing and must be built as executables. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="System.Reactive" />
    <!-- Lets the configuration-layering test build the same provider stack the client
         does, so the installer-written netrisk.ini overlay is proved rather than assumed. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" />
    <!-- MaterialIconKind only: a plain netstandard enum, no Avalonia. Lets the service icon map
         below be compiled here and every kind it returns be checked against the real enum. -->
    <PackageReference Include="Material.Icons" />
    <!-- Reads API/EntitiesConfiguration.yaml with the deserializer settings EntitiesService uses, so
         the entity-schema label and icon guards see the schema exactly as the client receives it. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- Model, and deliberately not GUIClient. The vault field state below is a GUIClient file that
         reads Model.Secrets.SecretReference; referencing Model brings in the shared contracts without
         bringing in Avalonia, which is the constraint this project exists under. -->
    <ProjectReference Include="..\Model\Model.csproj" />
    <!-- DAL, for the integration_sync_logs entity and the integration enums the sync-log feed below
         is written in terms of. EF Core is headless; Avalonia is what this project must not pull. -->
    <ProjectReference Include="..\DAL\DAL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The validation layer only depends on ReactiveUI, so it is compiled in directly rather
         than pulling GUIClient (and all of Avalonia) into a headless test run. -->
    <Compile Include="..\GUIClient\Validation\*.cs" LinkBase="Validation" />
    <!-- Same reason: the dialog view-name convention is deliberately free of Avalonia types so it
         can be tested here. The rest of DialogService cannot be (it touches Window). -->
    <Compile Include="..\GUIClient\ViewModels\Dialogs\DialogViewNaming.cs" LinkBase="Dialogs" />
    <!-- The rating-time scale anchors (Track 8 milestone 8.7.1): pure formatting, no Avalonia. -->
    <Compile Include="..\GUIClient\Tools\ScaleAnchorFormatter.cs" LinkBase="Tools" />
    <!-- The register list's inherent → residual line (8.2.3): also pure formatting. -->
    <Compile Include="..\GUIClient\Tools\RiskScoreSummary.cs" LinkBase="Tools" />
    <!-- The linkage chain's pure half (Stage 9.1, S41 §7): the per-level summary of the risk detail,
         the edit dialog's rows and enable rules, and the coverage report's headline. -->
    <Compile Include="..\GUIClient\Tools\RiskChainSummary.cs" LinkBase="Tools" />
    <!-- The structured scenario's pure half (Stage 9.2, S42 §7): how an empty field and an undeclared
         confidence read, the computed localization keys, when the risk editor asks for duplicates
         and how the warning lists them. -->
    <Compile Include="..\GUIClient\Tools\RiskScenarioSummary.cs" LinkBase="Tools" />
    <!-- How an entity-scoped governance row names its scope (8.3.3): pure formatting too, and the
         rule that keeps a raw entity id out of the appetite grid. -->
    <Compile Include="..\GUIClient\Tools\EntityScopeLabel.cs" LinkBase="Tools" />
    <!-- Whether pressing Preview has to save first (4.6). Worth testing here because it decides
         whether a read-looking button performs a write. -->
    <Compile Include="..\GUIClient\Tools\IssueTemplateDraft.cs" LinkBase="Tools" />
    <!-- Which option a ComboBox shows for a stored value: what keeps the issue-tracker Provider
         field from going blank after a save refills the provider list. -->
    <Compile Include="..\GUIClient\Tools\ComboSelection.cs" LinkBase="Tools" />
    <!-- Which Jira tabs a provider kind gets (Assets on Data Center, Service Management Cloud-only). -->
    <Compile Include="..\GUIClient\Tools\JiraFacets.cs" LinkBase="Tools" />
    <!-- What the queue selection Save sends: null until the grid is loaded, so it cannot wipe imports. -->
    <Compile Include="..\GUIClient\Tools\JiraQueueImports.cs" LinkBase="Tools" />
    <!-- The findings grid's id -> label maps: pure collection logic, and what replaced the
         per-cell blocking REST call in the Fix team / Host columns. -->
    <Compile Include="..\GUIClient\Tools\RowLabelCache.cs" LinkBase="Tools" />
    <!-- How the posture sync log is assembled, including the placeholder row that makes a run the
         operator just started appear immediately instead of only after it ends. -->
    <Compile Include="..\GUIClient\Tools\IntegrationSyncLogFeed.cs" LinkBase="Tools" />
    <!-- Whether a credential field is typed in or comes from the vault. The three-way decision is
         deliberately free of Avalonia (it raises INotifyPropertyChanged from System.ComponentModel)
         precisely so it can be tested here: sending a reference where a literal was meant, or the
         other way round, is a failure a person only sees as somebody else's 401. -->
    <Compile Include="..\GUIClient\Tools\VaultSecretFieldState.cs" LinkBase="Tools" />
    <!-- One control a vault plugin contributed to a screen, while an operator fills it in. Avalonia-free
         for the same reason: the validation rules an operator sees enforced in the picker and in the
         connection editor are worth testing without a window. -->
    <Compile Include="..\GUIClient\Tools\PluginFieldState.cs" LinkBase="Tools" />
    <!-- Which window a toast lands on. Deliberately Avalonia-free so the rule that keeps
         Administration's feedback out of the main window can be tested here. -->
    <Compile Include="..\GUIClient\Notifications\NotificationRouting.cs" LinkBase="Notifications" />
    <!-- The Hosts view's pure half (S38): filter composition, paging, criticality/severity scales,
         the service icon map, history grouping and layout persistence. The converters and the view
         model are thin Avalonia wrappers over these. -->
    <Compile Include="..\GUIClient\Tools\Hosts\*.cs" LinkBase="Tools/Hosts" />
    <!-- The configuration-source order the installers rely on: no Avalonia types either. -->
    <Compile Include="..\GUIClient\ClientConfigurationSources.cs" LinkBase="Configuration" />
  </ItemGroup>
</Project>
